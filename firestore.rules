rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check membership in primary or secondary roles
    function hasRole(roleName) {
      return getUserData().role == roleName || (("secondaryRoles" in getUserData()) && getUserData().secondaryRoles.hasAny([roleName]));
    }

    // The staff document is authoritative for operational roles, secondary roles
    // and branch assignments. Token claims are used only during initial linking.
    function getUserData() {
      return request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data
        : request.auth != null && (request.auth.token.role != null || request.auth.token.tenantId != null)
          ? {"role": request.auth.token.role, "tenantId": request.auth.token.tenantId, "secondaryRoles": (("roles" in request.auth.token) && request.auth.token.roles is list ? request.auth.token.roles : (("secondaryRoles" in request.auth.token) && request.auth.token.secondaryRoles is list ? request.auth.token.secondaryRoles : [])), "assigned_branches": []}
          : {"role": "", "tenantId": "", "secondaryRoles": [], "assigned_branches": []};
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        (request.auth.token.tenantId != null && request.auth.token.tenantId == tenantId) ||
        getUserData().tenantId == tenantId ||
        request.auth.token.email == "peterssentongo61@gmail.com" ||
        request.auth.token.email == "peter.sentongo@pharmhelm" ||
        request.auth.token.email == "peter.sentongo@pharmhelm.com"
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "peterssentongo61@gmail.com" ||
        request.auth.token.email == "peter.sentongo@pharmhelm" ||
        request.auth.token.email == "peter.sentongo@pharmhelm.com" ||
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'CEO' ||
        request.auth.token.role == 'CEO / MD' ||
        hasRole('owner') ||
        hasRole('CEO') ||
        hasRole('CEO / MD')
      );
    }

    function isCEO() {
      return isAuthenticated() && (isAdmin() || hasRole('CEO') || hasRole('CEO / MD') || hasRole('owner'));
    }

    function hasValidBranchShape() {
      return request.resource.data.keys().hasAll([
        'tenantId', 'name', 'branch_code', 'type', 'address', 'phone',
        'status', 'created_at', 'created_by'
      ])
      && request.resource.data.tenantId is string
      && request.resource.data.name is string
      && request.resource.data.branch_code is string
      && request.resource.data.status in ['Active', 'Inactive', 'Closed'];
    }

    function isHR() {
      return isAuthenticated() && (hasRole('HR Head') || hasRole('HR Support Personnel') || hasRole('HR Manager') || isAdmin());
    }

    function isFinance() {
      return isAuthenticated() && (hasRole('Finance Head') || hasRole('Finance Officer') || hasRole('Accountant') || isAdmin());
    }

    function isLogisticsHead() {
      return isAuthenticated() && (hasRole('Logistics Head') || hasRole('Transport & Logistics Personnel') || hasRole('Logistics Manager') || isAdmin());
    }

    function isBranchManager() {
      return isAuthenticated() && (hasRole('Branch Manager') || hasRole('branch manager') || hasRole('admin') || isAdmin());
    }

    function isQA() {
      return isAuthenticated() && (hasRole('QA Head') || hasRole('QA Officer') || hasRole('QA Manager') || isAdmin());
    }

    function isIT() {
      return isAuthenticated() && (hasRole('IT Head') || hasRole('IT Support Staff') || hasRole('IT Staff') || isAdmin());
    }

    function isSettingsAdmin() {
      return isAuthenticated() && (isAdmin() || isIT());
    }

    function isProcurement() {
      return isAuthenticated() && (
        hasRole('Procurement Head') ||
        hasRole('Procurement Officer') ||
        hasRole('Procurement Manager') ||
        isAdmin()
      );
    }

    function isInventoryOperator() {
      return isAuthenticated() && (
        hasRole('Branch Manager') || hasRole('branch manager') || hasRole('admin') ||
        hasRole('pharmacist') || hasRole('Dispenser') ||
        hasRole('Procurement Head') || hasRole('Procurement Officer') ||
        hasRole('QA Head') || hasRole('QA Officer') ||
        isAdmin()
      );
    }

    function isMarketing() {
      return isAuthenticated() && (
        hasRole('Marketing Head') || hasRole('Marketing Personnel') || hasRole('Marketing Manager') ||
        hasRole('QA Head') || hasRole('QA Officer') || isAdmin()
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (("legacyStaffId" in getUserData()) && getUserData().legacyStaffId == userId)
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /trips/{tripId} {
      allow read: if isAuthenticated() && (isLogisticsHead() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /trip_legs/{legId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /fuel_logs/{logId} {
      allow read: if isAuthenticated() && (isLogisticsHead() || isFinance() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId) && (isLogisticsHead() || isOwner(request.resource.data.personnelId));
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /maintenance_logs/{logId} {
      allow read: if isAuthenticated() && (isLogisticsHead() || isFinance() || isTenantMember(resource.data.tenantId));
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /traffic_fine_logs/{logId} {
      allow read: if isAuthenticated() && (isLogisticsHead() || isHR() || isFinance() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if (isLogisticsHead() || isHR()) && isTenantMember(request.resource.data.tenantId);
      allow update: if (isLogisticsHead() || isHR()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if (isLogisticsHead() || isHR()) && isTenantMember(resource.data.tenantId);
    }

    match /hiring_applications/{applicationId} {
      allow read, write: if isHR();
    }

    match /theory_tests/{testId} {
      allow read, write: if isHR();
    }

    match /oral_interviews/{interviewId} {
      allow read, write: if isHR();
    }

    match /practical_assessments/{assessmentId} {
      allow read: if isHR() || isOwner(resource.data.supervisorId);
      allow write: if isHR() || isOwner(request.resource.data.supervisorId);
    }

    match /attendance_records/{recordId} {
      allow read: if isAuthenticated() && (isHR() || isBranchManager() || isOwner(resource.data.staffId) || isTenantMember(resource.data.tenantId));
      allow write: if isHR() || isBranchManager();
    }

    match /disciplinary_incidents/{incidentId} {
      allow read: if isAuthenticated() && (isHR() || isBranchManager() || isOwner(resource.data.staffId) || isTenantMember(resource.data.tenantId));
      allow create: if isHR() || isBranchManager() || isQA() || isAdmin();
      allow update: if isHR() || isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if true; // Allow public read for tenant detection
      allow write: if isAdmin();

      match /usernameRegistry/{handle} {
        allow read, write: if isAuthenticated() && (isAdmin() || isIT()) && isTenantMember(tenantId);
      }
    }

    match /branches/{branchId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isCEO() && isTenantMember(request.resource.data.tenantId) && hasValidBranchShape();
      allow update: if isSettingsAdmin() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == staffId ||
        resource.data.email == request.auth.token.email ||
        resource.data.authEmail == request.auth.token.email ||
        isTenantMember(resource.data.tenantId)
      );
      allow create: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(request.resource.data.tenantId);
      allow update: if isAuthenticated() && (
        isAdmin() || isIT() || isHR() ||
        (request.auth.uid == staffId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'tenantId', 'role', 'secondaryRoles', 'assigned_branches',
            'branch_id', 'default_branch_id', 'status', 'active',
            'authEmail', 'loginHandle', 'username', 'uid', 'password_set',
            'legacyStaffId'
          ]))
      );
      allow delete: if isAdmin() || isIT();
    }

    match /leave_requests/{requestId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffId) || isHR() || isTenantMember(resource.data.tenantId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.staffId) && isTenantMember(request.resource.data.tenantId);
      allow update: if isAuthenticated() && (isHR() || (isOwner(resource.data.staffId) && resource.data.status == 'pending'));
      allow delete: if isAdmin() || isHR();
    }

    match /advance_requests/{requestId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || isHR() || isFinance() || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.staffId) && isTenantMember(request.resource.data.tenantId);
      allow update: if isAuthenticated() && (isHR() || isFinance() || isAdmin());
      allow delete: if isAdmin();
    }

    match /payslips/{payslipId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || isFinance() || isAdmin());
      allow write: if isFinance() || isAdmin();
    }

    match /cme_records/{recordId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffId) || isHR() || isAdmin() || isTenantMember(resource.data.tenantId));
      allow write: if isHR() || isAdmin();
    }

    match /appraisal_scores/{scoreId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffId) || isHR() || isAdmin() || isTenantMember(resource.data.tenantId));
      allow write: if isHR() || isAdmin();
    }

    match /system_settings/{settingsId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isSettingsAdmin() && isTenantMember(request.resource.data.tenantId);
    }

    match /master_registries/{registryId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isSettingsAdmin() && isTenantMember(request.resource.data.tenantId);
    }

    match /role_realms_of_operation/{realmId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated() && (isSettingsAdmin() || isHR()) && isTenantMember(request.resource.data.tenantId);
      allow update: if isAuthenticated() && (isSettingsAdmin() || isHR()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isSettingsAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /global_audit_logs/{logId} {
      allow read: if (isAdmin() || isIT() || hasRole('QA Head')) && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      allow update, delete: if false; // Immutable
    }
    match /platform_users/{userId} {
      allow read, write: if isAdmin();
    }

    match /platform_revenue/{revenueId} {
      allow read, write: if isAdmin();
    }

    match /platform_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /predictive_settings/{settingId} {
      allow read, write: if isAdmin();
    }
    match /pending_activations/{activationId} {
      allow read: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(request.resource.data.tenantId);
      allow update, delete: if isAuthenticated() && (isAdmin() || isIT()) && isTenantMember(resource.data.tenantId);
    }

    match /finance_ledger/{entryId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isFinance();
      allow write: if isFinance() && isTenantMember(request.resource.data.tenantId);
    }

    match /eod_reconciliations/{reconciliationId} {
      allow read: if isAuthenticated() && (isFinance() || isBranchManager() || isTenantMember(resource.data.tenantId));
      allow create: if isAuthenticated() && (isBranchManager() || isFinance());
      allow update: if isAuthenticated() && (isBranchManager() || isFinance());
      allow delete: if isAdmin();
    }

    match /branch_expenses/{expenseId} {
      allow read: if isAuthenticated() && (isFinance() || isBranchManager() || isTenantMember(resource.data.tenantId));
      allow write: if isBranchManager() || isFinance();
    }

    match /cash_requisitions/{requisitionId} {
      allow read: if isAuthenticated() && (isFinance() || isBranchManager() || isTenantMember(resource.data.tenantId));
      allow create: if isAuthenticated() && (isBranchManager() || isFinance());
      allow update: if isAuthenticated() && (isBranchManager() || isFinance() || isAdmin());
      allow delete: if isAdmin();
    }

    match /credit_receivables/{receivableId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isFinance();
      allow write: if isFinance();
    }

    match /supplier_payables/{payableId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isFinance();
      allow write: if isFinance();
    }

    match /banking_records/{recordId} {
      allow read: if isAuthenticated() && (isFinance() || isBranchManager() || isTenantMember(resource.data.tenantId));
      allow write: if isBranchManager() || isFinance();
    }

    match /client_credit_ledger/{entryId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isFinance();
      allow write: if isFinance();
    }

    match /institution_credit_ledger/{entryId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isFinance();
      allow write: if isFinance();
    }

    match /supplier_credit_ledger/{entryId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isFinance();
      allow write: if isFinance();
    }

    match /financial_metrics/{metricId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isFinance() || isAdmin());
      allow write: if isFinance() || isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /health_messages/{messageId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /marketing_expenses/{expenseId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isMarketing() || isFinance());
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if (isMarketing() || isFinance()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /outreach_events/{eventId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /prescriber_disbursements/{disbursementId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isMarketing() || isFinance());
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if (isMarketing() || isFinance()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /pharmpoints_settings/{settingsId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /controlled_drug_register/{entryId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isQA() || isBranchManager());
      allow create: if isAuthenticated() && (isQA() || isBranchManager() || isAdmin());
      allow update, delete: if isAdmin(); // Highly sensitive
    }

    match /expiry_logs/{logId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /quarantine_logs/{logId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /room_temp_logs/{logId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager() || isAuthenticated(); // Staff can log
    }

    match /fridge_temp_logs/{logId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager() || isAuthenticated(); // Staff can log
    }

    match /cleaning_tasks/{taskId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /cleaning_logs/{logId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated(); // Staff can log completion
    }

    match /recalls/{recallId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isAdmin();
    }

    match /premises_licenses/{licenseId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isAdmin();
    }

    match /cme_sessions/{sessionId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isHR() || isAdmin();
    }

    match /cme_attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffId) || isQA() || isHR() || isTenantMember(resource.data.tenantId));
      allow write: if isQA() || isHR() || isAdmin();
    }

    match /appraisal_cycles/{cycleId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isHR() || isAdmin();
    }

    match /appraisals/{appraisalId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffId) || isQA() || isHR() || isTenantMember(resource.data.tenantId));
      allow write: if isQA() || isHR() || isAdmin();
    }

    match /products/{productId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isInventoryOperator() && isTenantMember(request.resource.data.tenantId);
      allow update: if isInventoryOperator() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /product_batches/{batchId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isInventoryOperator() && isTenantMember(request.resource.data.tenantId);
      allow update: if isInventoryOperator() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /{path=**}/product_batches/{batchId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isInventoryOperator() && isTenantMember(request.resource.data.tenantId);
      allow update: if isInventoryOperator() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /system_crashes/{crashId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Procurement, transfers, billing, and welfare collections
    match /stock_orders/{orderId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isProcurement() || isBranchManager());
      allow create: if isAuthenticated() && (isProcurement() || isBranchManager()) && isTenantMember(request.resource.data.tenantId);
      allow update: if isAuthenticated() && (isProcurement() || isBranchManager()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }
    match /stock_order_lines/{lineId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isProcurement() || isBranchManager());
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId) && (isProcurement() || isBranchManager());
      allow update: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && (isProcurement() || isBranchManager());
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }
    match /transfer_invoices/{invoiceId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isProcurement() || isBranchManager() || isFinance());
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId) && (isProcurement() || isBranchManager());
      allow update: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && (isProcurement() || isBranchManager());
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }
    match /transfer_invoice_lines/{lineId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (isProcurement() || isBranchManager() || isFinance());
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId) && (isProcurement() || isBranchManager());
      allow update: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && (isProcurement() || isBranchManager());
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }
    match /hq_order_drafts/{draftId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isProcurement();
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId) && isProcurement();
      allow update: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && isProcurement();
      allow delete: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isProcurement();
    }
    match /billable_services/{serviceId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isSettingsAdmin() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSettingsAdmin() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }
    match /welfare_records/{recordId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isHR() && isTenantMember(request.resource.data.tenantId);
      allow update: if isHR() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isHR() && isTenantMember(resource.data.tenantId);
    }

    match /inventoryMovementEvents/{eventId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      allow update, delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /branchConsumptionDaily/{summaryId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
    }

    match /replenishmentEngineSettings/{settingsId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
    }

    match /branchReplenishmentSnapshots/{snapId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
    }

    match /inventoryTransferReservations/{resId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
    }

    match /autoGenerateOrderRuns/{runId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
    }

    match /autoGenerateOrderLines/{lineId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
    }

    match /pos_quotations/{quotationId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId) && request.resource.data.status == 'Draft';
      allow update: if isAuthenticated() && isTenantMember(resource.data.tenantId) && (request.resource.data.status in ['Converted', 'Expired']);
      allow delete: if false; // quotations are never hard-deleted
    }



    // Generic rule for all other collections to enforce tenant isolation
    match /{collectionName}/{docId} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      allow update: if isAuthenticated() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }
  }
}
