        && isTenantMember(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && resource.data.inventoryClass == 'SELLABLE'
        && resource.data.status == 'ready_for_dispatch'
        && request.resource.data.status == 'dispatched'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'dispatchedAt', 'dispatched_at', 'dispatched_by',
          'dispatched_by_name', 'updatedAt'
        ])
        && request.resource.data.dispatched_by == request.auth.uid
        && resource.data.grn_id is string
        && resource.data.order_id is string
        && existsAfter(/databases/$(database)/documents/grn_records/$(resource.data.grn_id))
        && getAfter(/databases/$(database)/documents/grn_records/$(resource.data.grn_id)).data.tenantId == resource.data.tenantId
        && getAfter(/databases/$(database)/documents/grn_records/$(resource.data.grn_id)).data.transfer_id == invoiceId
        && getAfter(/databases/$(database)/documents/grn_records/$(resource.data.grn_id)).data.dispatch_status == 'dispatched'
        && existsAfter(/databases/$(database)/documents/stock_orders/$(resource.data.order_id))
        && getAfter(/databases/$(database)/documents/stock_orders/$(resource.data.order_id)).data.tenantId == resource.data.tenantId
        && getAfter(/databases/$(database)/documents/stock_orders/$(resource.data.order_id)).data.status == 'dispatched';
      allow update: if isStockOperator()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && (!('inventoryClass' in resource.data) || request.resource.data.inventoryClass == resource.data.inventoryClass)
        && (!isOperationalTransfer(request.resource.data) || isOperationalInventoryEnabled(resource.data.tenantId))
        && hasValidTransferClass(request.resource.data, false);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }
    match /transfer_invoice_lines/{lineId} {
      function isOperationalTransfer(data) {
        return isOperationalInventoryClass(data)
          || (('order_id' in data)
            && exists(/databases/$(database)/documents/stock_orders/$(data.order_id))
            && get(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.tenantId == data.tenantId
            && isOperationalOrderData(get(/databases/$(database)/documents/stock_orders/$(data.order_id)).data));
      }
      function transferPath() {
        return /databases/$(database)/documents/transfer_invoices/$(request.resource.data.transfer_id);
      }
      function validTransferLineClass(requireExplicitClass) {
        let invoicePath = transferPath();
        let operationalItemPath = /databases/$(database)/documents/operational_inventory/$(request.resource.data.product_id);
        let sellableItemPath = /databases/$(database)/documents/products/$(request.resource.data.product_id);
        return existsAfter(invoicePath)
          && getAfter(invoicePath).data.tenantId == request.resource.data.tenantId
          && ((isOperationalTransfer(getAfter(invoicePath).data)
              && isOperationalInventoryEnabled(request.resource.data.tenantId)
              && (!requireExplicitClass || request.resource.data.inventoryClass == 'OPERATIONAL')
              && (!('inventoryClass' in request.resource.data) || request.resource.data.inventoryClass == 'OPERATIONAL')
              && exists(operationalItemPath)
              && get(operationalItemPath).data.tenantId == request.resource.data.tenantId)
            || (!isOperationalTransfer(getAfter(invoicePath).data)
              && (!requireExplicitClass || request.resource.data.inventoryClass == 'SELLABLE')
              && (!('inventoryClass' in request.resource.data) || request.resource.data.inventoryClass == 'SELLABLE')
              && exists(sellableItemPath)
              && get(sellableItemPath).data.tenantId == request.resource.data.tenantId));
      }
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if (isStockOperator() || (
          isProcurement()
          && request.resource.data.get('inventoryClass', '') == 'SELLABLE'
          && request.resource.data.get('grn_id', '') is string
          && request.resource.data.get('transfer_id', '') is string
          && existsAfter(/databases/$(database)/documents/grn_records/$(request.resource.data.grn_id))
          && getAfter(/databases/$(database)/documents/grn_records/$(request.resource.data.grn_id)).data.tenantId == request.resource.data.tenantId
          && getAfter(/databases/$(database)/documents/grn_records/$(request.resource.data.grn_id)).data.transfer_id == request.resource.data.transfer_id
        ))
        && isTenantMember(request.resource.data.tenantId)
        && validTransferLineClass(true);
      allow update: if isStockOperator()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && (!('inventoryClass' in resource.data) || request.resource.data.inventoryClass == resource.data.inventoryClass)
        && validTransferLineClass(false);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }
    match /hq_order_drafts/{draftId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewProcurement();
      allow create: if isTenantMember(request.resource.data.tenantId) && isProcurement();
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && isProcurement();
      allow delete: if isTenantMember(resource.data.tenantId) && isProcurement();
    }
    match /billable_services/{serviceId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isSettingsAdmin() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSettingsAdmin() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /sales/{saleId} {
      function isLegacySale(sale) {
        return !("engineVersion" in sale) || sale.engineVersion != 2;
      }

      function hasValidV2SaleLinks(saleId) {
        let sale = request.resource.data;
        let payment = getAfter(/databases/$(database)/documents/pos_payments/$(sale.canonicalPaymentId)).data;
        let outbox = getAfter(/databases/$(database)/documents/pos_transaction_outbox/$(sale.transactionOutboxEventId)).data;
        return sale.canonicalPaymentId is string
          && sale.transactionOutboxEventId is string
          && payment.saleId == saleId
          && payment.tenantId == sale.tenantId
          && payment.branchId == sale.branchId
          && payment.amount == sale.totalAmount
          && outbox.saleId == saleId
          && outbox.paymentId == sale.canonicalPaymentId;
      }

      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.branchId is string
        && isAssignedToBranch(request.resource.data.branchId)
        && request.resource.data.status == 'completed'
        && (
          (isLegacySale(request.resource.data)
            ? !isReceivableCreditMethod(request.resource.data.get('paymentMethod', ''))
              && !isReceivableCreditMethod(request.resource.data.get('secondaryPaymentMethod', ''))
            : hasValidV2SaleLinks(saleId))
        );
      allow update: if isPOSOperator()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && ((isLegacySale(resource.data) && isLegacySale(request.resource.data)) || isAtomicOriginalUpdate(saleId));
      // V2 sales are immutable to every client, including tenant administrators.
      // The Batch 4 Admin SDK worker bypasses client rules for its controlled
      // downstream-status fields. Reversal requires a separate durable event.
      allow delete: if isAdmin()
        && isTenantMember(resource.data.tenantId)
        && isLegacySale(resource.data);
    }

    match /pos_payments/{paymentId} {
      function hasValidPaymentIdentity(paymentId) {
        let payment = request.resource.data;
        return payment.paymentId == paymentId
          && payment.operatorUid == request.auth.uid
          && payment.branchId is string
          && payment.source == 'POS'
          && payment.engineVersion == 2
          && payment.currency == 'UGX'
          && payment.saleId is string
          && payment.checkoutAttemptId is string
          && payment.receiptNumber is string;
      }

      function hasValidPaymentSettlement() {
        let payment = request.resource.data;
        return payment.amount is number
          && payment.amount >= 0
          && payment.settledAmount is number
          && payment.settledAmount >= 0
          && payment.outstandingAmount is number
          && payment.outstandingAmount >= 0
          && payment.settledAmount + payment.outstandingAmount == payment.amount
          && payment.status in ['completed', 'unpaid', 'partially_settled']
          && payment.components is list;
      }

      function paymentMatchesSale(paymentId) {
        let payment = request.resource.data;
        let sale = getAfter(/databases/$(database)/documents/sales/$(payment.saleId)).data;
        return sale.engineVersion == 2
          && sale.tenantId == payment.tenantId
          && sale.branchId == payment.branchId
          && sale.operatorUid == request.auth.uid
          && sale.receiptNumber == payment.receiptNumber
          && sale.checkoutAttemptId == payment.checkoutAttemptId
          && sale.totalAmount == payment.amount
          && sale.canonicalPaymentId == paymentId
          && (isReceivableCreditMethod(sale.paymentMethod) || isReceivableCreditMethod(sale.get('secondaryPaymentMethod', ''))
            ? validCreditPayment(payment, sale)
              && getAfter(/databases/$(database)/documents/credit_receivables/$(payment.saleId)).data.paymentId == paymentId
            : !isReceivableCreditMethod(payment.paymentMethod));
      }

      allow get: if isAuthenticated()
        && (resource == null || isTenantMember(resource.data.tenantId))
        && (isPOSOperator() || canViewFinance() || isIT());
      allow list: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && hasValidPaymentIdentity(paymentId)
        && hasValidPaymentSettlement()
        && paymentMatchesSale(paymentId)
        && (!request.resource.data.get('isRevisionReplacement', false) ||
          !('executionMode' in getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(request.resource.data.revisionRequestId)).data) || atomicFinancialPostingChain());
      allow update, delete: if false;
    }

    match /pos_transaction_outbox/{eventId} {
      function hasValidOutboxEnvelope(eventId) {
        let outbox = request.resource.data;
        return outbox.eventId == eventId
          && outbox.branchId is string
          && outbox.source == 'POS'
          && outbox.engineVersion == 2
          && outbox.payloadVersion == 1
          && outbox.eventType == 'POS_SALE_COMMITTED'
          && outbox.aggregateType == 'POS_SALE'
          && outbox.aggregateId == outbox.saleId
          && outbox.saleId is string
          && outbox.paymentId is string
          && outbox.receiptNumber is string
          && (outbox.status == 'PENDING' || (outbox.status == 'PROCESSED' && isFreshAtomicRevision(outbox.revisionRequestId)))
          && outbox.attemptCount == 0
          && outbox.payload.saleId == outbox.saleId
          && outbox.payload.paymentId == outbox.paymentId;
      }

      function outboxMatchesSale(eventId) {
        let outbox = request.resource.data;
        let sale = getAfter(/databases/$(database)/documents/sales/$(outbox.saleId)).data;
        return sale.engineVersion == 2
          && sale.tenantId == outbox.tenantId
          && sale.branchId == outbox.branchId
          && sale.receiptNumber == outbox.receiptNumber
          && sale.canonicalPaymentId == outbox.paymentId
          && sale.transactionOutboxEventId == eventId;
      }

      function outboxMatchesPayment() {
        let outbox = request.resource.data;
        let payment = getAfter(/databases/$(database)/documents/pos_payments/$(outbox.paymentId)).data;
        return payment.saleId == outbox.saleId
          && payment.tenantId == outbox.tenantId
          && payment.branchId == outbox.branchId;
      }

      allow get: if isAuthenticated()
        && (resource == null || isTenantMember(resource.data.tenantId))
        && (isPOSOperator() || canViewFinance() || isIT());
      allow list: if isAuthenticated()
        && isTenantMember(resource.data.tenantId)
        && (canViewFinance() || isIT());
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && hasValidOutboxEnvelope(eventId)
        && outboxMatchesSale(eventId)
        && outboxMatchesPayment();
      allow update: if atomicOutboxSupersession(eventId);
      allow delete: if false;
    }

    match /pos_checkout_attempts/{attemptDocumentId} {
      function hasValidAttemptEnvelope() {
        let attempt = request.resource.data;
        return attempt.operatorUid == request.auth.uid
          && attempt.branchId is string
          && attempt.status == 'completed'
          && attempt.attemptId is string
          && attempt.fingerprint is string
          && attempt.saleId is string
          && attempt.paymentId is string
          && attempt.outboxEventId is string;
      }

      function attemptMatchesSale() {
        let attempt = request.resource.data;
        let sale = getAfter(/databases/$(database)/documents/sales/$(attempt.saleId)).data;
        return sale.engineVersion == 2
          && sale.tenantId == attempt.tenantId
          && sale.branchId == attempt.branchId
          && sale.operatorUid == request.auth.uid
          && sale.checkoutAttemptId == attempt.attemptId
          && sale.checkoutIntentFingerprint == attempt.fingerprint
          && sale.canonicalPaymentId == attempt.paymentId
          && sale.transactionOutboxEventId == attempt.outboxEventId;
      }

      function attemptMatchesPayment() {
        let attempt = request.resource.data;
        let payment = getAfter(/databases/$(database)/documents/pos_payments/$(attempt.paymentId)).data;
        return payment.saleId == attempt.saleId
          && payment.checkoutAttemptId == attempt.attemptId
          && payment.tenantId == attempt.tenantId
          && payment.branchId == attempt.branchId;
      }

      function attemptMatchesOutbox() {
        let attempt = request.resource.data;
        let outbox = getAfter(/databases/$(database)/documents/pos_transaction_outbox/$(attempt.outboxEventId)).data;
        return outbox.saleId == attempt.saleId
          && outbox.paymentId == attempt.paymentId
          && outbox.tenantId == attempt.tenantId
          && outbox.branchId == attempt.branchId
          && (outbox.status == 'PENDING' || (outbox.status == 'PROCESSED' && isFreshAtomicRevision(attempt.revisionRequestId)));
      }

      allow get: if isPOSOperator() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if false;
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && hasValidAttemptEnvelope()
        && attemptMatchesSale()
        && attemptMatchesPayment()
        && attemptMatchesOutbox();
      allow update, delete: if false;
    }

    match /pos_sale_revision_requests/{requestId} {
      function hasValidRevisionRequestEnvelope() {
        let revision = request.resource.data;
        return revision.keys().hasOnly([
            'requestType', 'engineVersion', 'payloadVersion', 'status',
            'requestId', 'revisionId', 'tenantId', 'branchId',
            'originalSaleId', 'originalReceiptNumber', 'originalSellerId', 'originalTimestamp',
            'requestedBy', 'requestedByName', 'requestedByRole', 'reason', 'sequence',
            'replacementAttemptId', 'replacementSaleId', 'pendingReplacementSaleId',
            'replacementPaymentId', 'replacementOutboxEventId', 'reversalEventId', 'auditId',
            'originalTotal', 'revisedTotal', 'monetaryDelta', 'adjustmentDirection',
            'changeTypes', 'itemChanges', 'before', 'after', 'revisedItems', 'envelope'
          ])
          && revision.requestId == requestId
          && revision.requestType == 'POS_SALE_REVISION_REQUESTED'
          && revision.engineVersion == 2
          && revision.payloadVersion == 1
          && revision.status == 'PENDING'
          && revision.revisionId is string
          && revision.revisionId.size() > 0
          && revision.tenantId is string
          && revision.tenantId.size() > 0
          && revision.branchId is string
          && revision.branchId.size() > 0
          && revision.originalSaleId is string
          && revision.originalSaleId.size() > 0
          && revision.originalReceiptNumber is string
          && revision.originalReceiptNumber.size() > 0
          && revision.requestedBy == request.auth.uid
          && revision.requestedByName is string
          && revision.requestedByName.size() > 0
          && revision.reason is string
          && revision.reason.size() >= 8
          && revision.reason.size() <= 500
          && revision.sequence is int
          && revision.sequence >= 1
          && revision.replacementAttemptId is string
          && revision.replacementSaleId is string
          && revision.pendingReplacementSaleId == revision.replacementSaleId
          && revision.replacementPaymentId is string
          && revision.replacementOutboxEventId is string
          && revision.reversalEventId is string
          && revision.auditId is string
          && revision.originalTotal is number
          && revision.revisedTotal is number
          && revision.monetaryDelta is number
          && revision.revisedTotal - revision.originalTotal == revision.monetaryDelta
          && revision.adjustmentDirection in ['INCREASE', 'DECREASE', 'NO_VALUE_CHANGE']
          && revision.changeTypes is list
          && revision.itemChanges is list
          && revision.revisedItems is list
          && revision.revisedItems.size() > 0
          && revision.before is map
          && revision.after is map
          && revision.envelope is map;
      }

      allow get: if isAuthenticated() && (
        resource == null ||
        (
          isTenantMember(resource.data.tenantId)
          && (
            canViewGlobalRevisionLedger() ||
            canViewBranchRevisionLedger(resource.data.branchId)
          )
        )
      );
      allow list: if isAuthenticated()
        && isTenantMember(resource.data.tenantId)
        && (
          canViewGlobalRevisionLedger() ||
          canViewBranchRevisionLedger(resource.data.branchId)
        );
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && (hasValidRevisionRequestEnvelope() || (request.resource.data.requestType == 'POS_CREDIT_VOID' ? validAtomicCreditVoid(requestId, request.resource.data) : hasAtomicCorrectionChain(requestId)));
      // Revision lifecycle transitions are owned exclusively by the Admin SDK workers.
      allow update, delete: if false;
    }

    match /pos_payment_reversals/{reversalId} {
      allow get: if isPOSOperator() && (resource == null || resource.data.tenantId == getUserData().tenantId);
      allow create: if request.resource.data.reversalId == reversalId && atomicPaymentReversal();
      allow update, delete: if false;
    }

    match /welfare/{recordId} {
      allow create: if atomicWelfareRecord(recordId, 'welfare');
    }
    match /cashTransfers/{recordId} {
      allow create: if atomicWelfareRecord(recordId, 'cashTransfers');
    }
    match /clients/{clientId} {
      allow update: if atomicWelfareBalance(clientId);
    }
    match /{collectionName}/{reversalId} {
      allow get: if collectionName in ['pos_welfare_reversals', 'pos_credit_reversals', 'pos_quotation_reversals']
        && isPOSOperator() && (resource == null || resource.data.tenantId == getUserData().tenantId);
      allow create: if collectionName in ['pos_welfare_reversals', 'pos_credit_reversals', 'pos_quotation_reversals']
        && atomicFinancialReversal(reversalId, collectionName);
    }

    match /audit_logs/{auditId} {
      function hasAuditRevision(data) { return 'revisionRequestId' in data; }
      function validAuditCreate() {
        let data = request.resource.data;
        return data.tenantId == getUserData().tenantId
          && (auditId.matches('e_.*')
            ? (hasAnyRole(['IT Head']) && data.userId == request.auth.uid
              && data.timestamp == request.time && !hasAuditRevision(data))
            : (!hasAuditRevision(data) ||
              (isFreshAtomicRevision(data.revisionRequestId) && data.userId == request.auth.uid)));
      }
      // getUserData requires auth.uid; anonymous requests fail closed in both predicates.
      allow create: if validAuditCreate();
      allow read, update, delete: if resource.data.tenantId == getUserData().tenantId
        && (request.method.matches('get|list') || !(auditId.matches('e_.*') || hasAuditRevision(resource.data)))
        && !(request.method == 'update' && hasAuditRevision(request.resource.data));
    }
    match /sale_revisions/{revisionId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.tenantId == getUserData().tenantId);
      allow list: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId;
      allow create: if isAuthenticated() && request.resource.data.tenantId == getUserData().tenantId
        && (!('revisionRequestId' in request.resource.data) || isFreshAtomicRevision(request.resource.data.revisionRequestId));
      allow update: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId
        && !('revisionRequestId' in resource.data) && !('revisionRequestId' in request.resource.data);
      allow delete: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId && !('revisionRequestId' in resource.data);
    }

    match /welfare_records/{recordId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isHR() && isTenantMember(request.resource.data.tenantId);
      allow update: if isHR() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isHR() && isTenantMember(resource.data.tenantId);
    }

    // Stock In physical receipt and its movement intent are committed together.
    // Branch operators can only create pending intents; analytics replay is
    // a restricted pending -> processed transition for the same tenant/branch.
    match /sellable_receipt_movement_outbox/{intentId} {
      allow get: if isStockOperator() &&
        (resource == null || (isTenantMember(resource.data.tenantId) && isAssignedToBranch(resource.data.branchId)));
      allow list: if isStockOperator() && isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(resource.data.branchId);
      function validReceivingMovement(data) {
        let line = getAfter(/databases/$(database)/documents/transfer_invoice_lines/$(data.lineId)).data;
        return line.tenantId == data.tenantId && line.transfer_id == data.transferId
          && line.product_id == data.productId && line.qty_accepted_base_units == data.quantityBaseUnits;
      }
      allow create: if isStockOperator() && isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && request.resource.data.status == 'pending'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.quantityBaseUnits is int
        && request.resource.data.quantityBaseUnits > 0
        && request.resource.data.transferId is string
        && request.resource.data.lineId is string
        && intentId == 'sellable_stockin_' + request.resource.data.transferId + '_' + request.resource.data.lineId
        && existsAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId))
        && getAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId)).data.destination_branch_id == request.resource.data.branchId
        && getAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId)).data.status in ['fully_accepted', 'queried', 'receiving']
        && (getAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId)).data.status != 'receiving'
          || validReceivingMovement(request.resource.data));
      allow update: if isStockOperator() && isInventoryOperator()
        && isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(resource.data.branchId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'processed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processedAt']);
      allow delete: if false;
    }

    match /inventoryMovementEvents/{eventId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow create: if isTenantMember(request.resource.data.tenantId);
      allow update, delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /branchConsumptionDaily/{summaryId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /replenishmentEngineSettings/{settingsId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /branchReplenishmentSnapshots/{snapId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /inventoryTransferReservations/{resId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /autoGenerateOrderRuns/{runId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /autoGenerateOrderLines/{lineId} {
      allow read: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /pos_quotations/{quotationId} {
      allow get: if isAuthenticated() && (resource == null || (isTenantMember(resource.data.tenantId) && (isAssignedToBranch(resource.data.branchId) || isAdmin())));
      allow list: if isTenantMember(resource.data.tenantId) && (isAssignedToBranch(resource.data.branchId) || isAdmin());
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && get(/databases/$(database)/documents/branches/$(request.resource.data.branchId)).data.tenantId == request.resource.data.tenantId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'Draft';
      allow update: if isPOSOperator()
        && isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(resource.data.branchId)
        && get(/databases/$(database)/documents/branches/$(resource.data.branchId)).data.tenantId == resource.data.tenantId
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'convertedReceiptId', 'convertedAt', 'convertedValue', 'updatedAt'])
        && (request.resource.data.status in ['Converted', 'Expired']);
      allow delete: if false; // quotations are never hard-deleted
    }

    match /pos_quotation_counters/{counterId} {
      allow get: if isAuthenticated() && (resource == null || (isTenantMember(resource.data.tenantId) && (isAssignedToBranch(resource.data.branchId) || isAdmin())));
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && get(/databases/$(database)/documents/branches/$(request.resource.data.branchId)).data.tenantId == request.resource.data.tenantId;
      allow update: if isPOSOperator()
        && isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(resource.data.branchId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.branchCode == resource.data.branchCode
        && request.resource.data.year == resource.data.year
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSequence', 'updatedAt'])
        && request.resource.data.lastSequence > resource.data.lastSequence
        && request.resource.data.lastSequence <= resource.data.lastSequence + 100;
      allow delete: if false;
    }



    // Write-once financial approval history. Only an authenticated procurement
    // operator can create it alongside the order's atomic approved transition.
    match /procurement_approval_audit/{approvalId} {
      allow get: if isProcurement() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && canViewProcurement();
      allow create: if isProcurement()
        && isTenantMember(request.resource.data.tenantId)
        && approvalId == 'approval_' + request.resource.data.orderId
        && request.resource.data.actorId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId))
        && getAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId)).data.approved_by == request.auth.uid
        && getAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId)).data.approval_audit_id == approvalId;
      allow update, delete: if false;
    }

    match /finance_transfers_v1/{transferId} {
      function registeredEndpoint(endpoint, tenant, outgoing) {
        let portfolio = get(/databases/$(database)/documents/finance_portfolios_v1/$(tenant + '__' + endpoint.accountId)).data;
        return portfolio.status == 'active' && portfolio.tenantId == tenant
          && portfolio.id == endpoint.accountId && portfolio.currency == 'UGX'
          && (endpoint.portfolioId == 'system_bank'
            ? endpoint.accountId.matches('^bank_[a-f0-9]{64}$') && portfolio.bankParentId == 'system_bank' && portfolio.classification == 'bank'
              && endpoint.kind == 'bank' && endpoint.branchId == ''
            : endpoint.accountId.matches('^custom_.*') && portfolio.origin == 'custom' && endpoint.portfolioId == portfolio.id
              && (outgoing ? portfolio.allowsTransfersOut : portfolio.allowsTransfersIn)
              && endpoint.branchId == portfolio.scope.get('branchId', ''));
      }
      function validTransferEndpoint(endpoint, tenant, outgoing) {
        let account = get(/databases/$(database)/documents/finance_payment_accounts/$(endpoint.accountDocumentId)).data;
        let key = endpoint.accountId;
        let branch = endpoint.branchId;
        return endpoint.tenantId == tenant && endpoint.accountDocumentId == tenant + '_' + key
          && account.tenantId == tenant && account.accountId == key && account.portfolioId == key
          && endpoint.name == account.name && endpoint.kind == account.kind
          && account.currency == 'UGX' && account.initialized
          && branch == account.scope.get('branchId', '')
          && (branch == '' || (isAssignedToBranch(branch)
            && get(/databases/$(database)/documents/branches/$(branch)).data.tenantId == tenant))
          && (key.matches('^(bank_[a-f0-9]{64}|custom_[A-Za-z0-9_-]+)$')
            ? registeredEndpoint(endpoint, tenant, outgoing)
            : endpoint.portfolioId == key
              && (key in ['system_mtn_mobile_money', 'system_airtel_mobile_money']
                ? branch == '' && endpoint.kind == 'bank'
                : branch != '' && endpoint.kind == 'petty_cash'
                  && key in ['system_branch_cash_sales_' + branch, 'system_petty_cash_' + branch]));
      }
      function allowedTransferRoute(source, destination) {
        let branch = source.branchId;
        let cashSales = branch != '' && source.accountId == 'system_branch_cash_sales_' + branch;
        let bank = source.portfolioId == 'system_bank';
        let toBank = destination.portfolioId == 'system_bank';
        let toPetty = destination.branchId != '' && destination.accountId == 'system_petty_cash_' + destination.branchId;
        return (branch == '' || destination.branchId == '' || branch == destination.branchId)
          && (source.accountId.matches('^custom_.*') || destination.accountId.matches('^custom_.*')
            || (toBank && (cashSales || bank || source.accountId in ['system_mtn_mobile_money','system_airtel_mobile_money']))
            || (toPetty && (cashSales || bank)));
      }
      function validTransferLeg(endpoint, movement, id) {
        let path = managementMovementPath(endpoint.kind, id);
        return movement.id == id
          && movement.collection == (endpoint.kind == 'bank' ? 'banking_records' : 'petty_cash_ledger')
          && !exists(path) && getAfter(path).data.portfolioTransferId == transferId;
      }
      function validTransferCharge(data) {
        let feeId = transferId + '_fee';
        return data.chargeUGX == 0 ? data.chargeMovement == null
          : validTransferLeg(data.source, data.chargeMovement, feeId);
      }
      function validTransfer(data) {
        return isFinance() && isTenantMember(data.tenantId)
          && transferId == data.id && transferId.matches('^pt_[a-f0-9]{64}$')
          && data.idempotencyKey == transferId && data.auditVersion == 1 && data.reversalOf == null
          && data.status == 'completed' && data.currency == 'UGX' && data.transferClass == (data.source.portfolioId == data.destination.portfolioId ? 'intra_portfolio' : 'inter_portfolio')
          && data.principalUGX is int && data.principalUGX > 0 && data.principalUGX <= 9007199254740991
          && data.chargeUGX is int && data.chargeUGX >= 0
          && data.principalUGX + data.chargeUGX <= 9007199254740991 && validTransferCharge(data)
          && data.reference is string && data.reference.size() >= 5 && data.reference.size() <= 100
          && data.initiatedBy == request.auth.uid && data.initiatedAt is string && data.postedAt == request.time
          && data.source.accountDocumentId != data.destination.accountDocumentId
          && validTransferEndpoint(data.source, data.tenantId, true)
          && validTransferEndpoint(data.destination, data.tenantId, false)
          && allowedTransferRoute(data.source, data.destination)
          && validTransferLeg(data.source, data.sourceMovement, transferId + '_out')
          && validTransferLeg(data.destination, data.destinationMovement, transferId + '_in');
      }
      allow get: if canViewFinance() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if canViewFinance() && isTenantMember(resource.data.tenantId);
      allow create: if validTransfer(request.resource.data);
    }

    match /finance_portfolios_v1/{portfolioId} {
      function canReadPortfolio(data) {
        return canViewFinance() && isTenantMember(data.tenantId)
          && (canSettleSupplier(data.tenantId) || isCEO() || data.scope.kind == 'organisation' || isAssignedToBranch(data.scope.branchId));
      }
      allow get, list: if canReadPortfolio(resource.data);
      function validPortfolioRegistration(data) {
        return isTenantMember(data.tenantId) && isCEO()
        && portfolioId == data.tenantId + '__' + data.id
        && data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid
        && data.origin == 'custom'
        && data.status == 'active'
        && data.currency == 'UGX'
        && (data.scope.kind == 'organisation'
          || (data.scope.kind == 'branch' && data.id.matches('^custom_cash_safe_[a-f0-9]{32}$')
            && data.classification == 'cash_equivalent' && !data.supportsChildAccounts
            && data.allowsTransfersIn && data.allowsTransfersOut
            && activeSupplierFundingBranch(data.tenantId, data.scope.branchId)))
        && !('balanceUGX' in data);
      }
      function validLifecycleUpdate() {
        let actor = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;
        let status = after.status;
        let changed = after.diff(before).affectedKeys();
        let funding = /databases/$(database)/documents/finance_payment_accounts/$(before.tenantId + '_' + before.id);
        return isCEO() && isTenantMember(before.tenantId)
          && before.origin == 'custom' && before.status in ['active','inactive']
          && after.updatedBy == actor && after.updatedAt is string
          && (status == 'active' || (after.deactivationReason is string && after.deactivationReason.size() > 0))
          && ((status == (before.status == 'active' ? 'inactive' : 'active')
            && (status == 'active' || !exists(funding) || getAfter(funding).data.balanceUGX == 0)
            && (status == 'active' ||
              (after.deactivatedBy == actor && after.deactivatedAt is string))
            && changed.hasOnly(['status','updatedBy','updatedAt','deactivatedBy','deactivatedAt','deactivationReason']))
          || (before.status == 'inactive' && status == 'deleted' && !before.supportsChildAccounts
            && !existsAfter(funding)
            && changed.hasOnly(['status','deactivationReason','updatedBy','updatedAt'])));
      }
      allow create: if validPortfolioRegistration(request.resource.data);
      allow update: if validLifecycleUpdate();
    }

    // Generic tenant fallback. Dedicated collections retain their explicit rules.
    // Share exclusions and dispatch by method instead of compiling five copies.
    match /{collectionName}/{docId} {
      function dedicatedCollection() {
        return collectionName in ['payroll','payslips','attendance','leave_requests','advance_requests','staff_identity_claims', 'identity_sequence_counters','branches','supplier_registry','opening_stock_sessions','transfer_invoices','transfer_invoice_lines','stock_orders','stock_order_lines','hiring_applications','practical_assessments','disciplinary_incidents','appraisals','pos_checkout_attempts','pos_payments','pos_transaction_outbox','pos_quotations','pos_quotation_counters','operational_inventory','operational_inventory_masters','operational_inventory_identity_claims','operational_inventory_identity_state','operational_inventory_usage','operational_inventory_maintenance','operational_inventory_movements','operational_transfers','operational_transfer_lines','grn_records','operational_grn_lines','operational_finance_events','operational_inventory_migration_audit','operational_inventory_identity_events','procurement_approval_audit','sellable_receipt_movement_outbox'];
      }
      function dedicatedWriteCollection() {
        return dedicatedCollection() || collectionName in ['staff', 'hr_roles', 'product_batches', 'products', 'role_realms_of_operation', 'sales'];
      }
      function immutableFallbackIdentities() {
        return true
        && (collectionName != 'staff' || !('employee_id' in resource.data)
          || request.resource.data.employee_id == resource.data.employee_id)
        && (collectionName != 'staff' || !('staff_code' in resource.data)
          || request.resource.data.staff_code == resource.data.staff_code)
        && (collectionName != 'clients' || !('patient_code' in resource.data)
          || request.resource.data.patient_code == resource.data.patient_code)
        && (collectionName != 'prescribers' || !('prescriber_code' in resource.data)
          || request.resource.data.prescriber_code == resource.data.prescriber_code)
        && (collectionName != 'institutions' || !('institution_code' in resource.data)
          || request.resource.data.institution_code == resource.data.institution_code);
      }
      allow read: if !dedicatedCollection() && !isProtectedFinanceCollection(collectionName)
        && isAuthenticated()
        && ((request.method == 'get' && resource == null) || isTenantMember(resource.data.tenantId));
      allow write: if !dedicatedWriteCollection() && !isProtectedFinanceCollection(collectionName)
        && (request.method == 'delete'
          ? (isAdmin() && isTenantMember(resource.data.tenantId))
          : (isTenantMember(request.resource.data.tenantId)
            && (request.method == 'create'
              || (request.method == 'update' && isTenantMember(resource.data.tenantId) && immutableFallbackIdentities()))));
    }
  }
}

