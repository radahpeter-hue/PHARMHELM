rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check membership in primary or secondary roles
    function hasRole(roleName) {
      return hasAnyRole([roleName]);
    }

    function hasAnyRole(roleNames) {
      let user = getUserData();
      return user.role in roleNames || (("secondaryRoles" in user) && user.secondaryRoles.hasAny(roleNames));
    }

    // The staff document is authoritative for operational roles, secondary roles
    // and branch assignments. Token claims are used only during initial linking.
    function getUserData() {
      let staffPath = /databases/$(database)/documents/staff/$(request.auth.uid);
      let staff = exists(staffPath) ? get(staffPath).data : {
        'role': request.auth.token.get('role', ''), 'tenantId': request.auth.token.get('tenantId', ''),
        'secondaryRoles': request.auth.token.get('roles', request.auth.token.get('secondaryRoles', [])), 'assigned_branches': []
      };
      return staff.get('is_duplicate', false) ? null : staff;
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        getUserData().get('tenantId', request.auth.token.get('tenantId', '')) == tenantId
        || request.auth.token.get('email', '') in ['peterssentongo61@gmail.com', 'peter.sentongo@pharmhelm', 'peter.sentongo@pharmhelm.com']
      );
    }

    // The tenant-scoped settings document is the authoritative operational
    // inventory feature gate. Missing or malformed settings fail closed.
    function isOperationalInventoryEnabled(tenantId) {
      let settingsPath = /databases/$(database)/documents/system_settings/$(tenantId);
      return exists(settingsPath)
        && get(settingsPath).data.tenantId == tenantId
        && ('featureToggles' in get(settingsPath).data)
        && get(settingsPath).data.featureToggles is map
        && ('enableOperationalInventory' in get(settingsPath).data.featureToggles)
        && get(settingsPath).data.featureToggles.enableOperationalInventory;
    }

    function isOperationalInventoryClass(data) {
      return ('inventoryClass' in data) && data.inventoryClass == 'OPERATIONAL';
    }

    function isOperationalOrderData(data) {
      return data.category == 'non_sellable' || isOperationalInventoryClass(data);
    }

    function canOperateOperationalLocation(branchId) {
      return branchId == 'HQ'
        ? (isProcurement() || isAssignedToBranch('HQ'))
        : isAssignedToBranch(branchId);
    }

    function isAdmin() {
      let roles = ['owner', 'Owner', 'CEO', 'ceo', 'CEO / MD', 'ceo / md'];
      return isAuthenticated() && (
        request.auth.token.get('email', '') in ['peterssentongo61@gmail.com', 'peter.sentongo@pharmhelm', 'peter.sentongo@pharmhelm.com']
        || hasAnyRole(roles)
      );
    }

    function isCEO() {
      return isAdmin();
    }

    function isHR() {
      return isAuthenticated() && (hasAnyRole(['HR Head', 'HR Support Personnel', 'HR Manager', 'admin', 'Admin']) || hasCustomModuleFunctional('hr') || isAdmin());
    }

    function isFinance() {
      return isAuthenticated() && (hasAnyRole(['Finance Head', 'Finance Officer', 'Accountant', 'admin', 'Admin']) || hasCustomModuleFunctional('finance') || isAdmin());
    }

    function isLogisticsHead() {
      return isAuthenticated() && (hasAnyRole(['Logistics Head', 'Transport & Logistics Personnel', 'Logistics Manager', 'admin', 'Admin']) || hasCustomModuleFunctional('logistics') || isAdmin());
    }

    function isBranchManager() {
      return isAuthenticated() && (hasAnyRole(['Branch Manager', 'branch manager', 'admin']) || isAdmin());
    }

    function hasBranchManagerRole() {
      return isAuthenticated() && (
        hasAnyRole(['Branch Manager', 'branch manager', 'admin'])
      );
    }


    function isDepartmentHead() {
      return isAuthenticated() && (
        hasAnyRole([
          'Finance Head', 'Procurement Head', 'Logistics Head', 'Transport & Logistics Head',
          'Marketing Head', 'QA Head', 'HR Head', 'IT Head'
        ])
      );
    }

    function isPeopleSupervisor() {
      return isAuthenticated() && (isBranchManager() || isDepartmentHead() || isAdmin());
    }

    function isAssignedToBranch(branchId) {
      let user = getUserData();
      return isAuthenticated() && (
        (("assigned_branches" in user) && user.assigned_branches.hasAny([branchId])) ||
        (("branch_id" in user) && user.branch_id == branchId) ||
        (("default_branch_id" in user) && user.default_branch_id == branchId) ||
        isAdmin()
      );
    }

    function isQA() {
      return isAuthenticated() && (hasAnyRole(['QA Head', 'QA Officer', 'QA Manager', 'admin', 'Admin']) || hasCustomModuleFunctional('qa') || isAdmin());
    }

    function isITPersonnel() {
      return isAuthenticated() && (
        hasAnyRole(['IT Head', 'IT Support Staff', 'IT Support Personnel', 'IT Staff'])
      );
    }

    function isIT() {
      return isAuthenticated() && (isITPersonnel() || isAdmin());
    }

    function hasCustomModuleAccess(moduleKey, accessLevels) {
      let user = getUserData();
      let configuredId = user.get('roleRealmId', '');
      let realmId = configuredId is string && configuredId.size() > 0 ? configuredId
        : user.tenantId + '_' + user.role.replace('\\s+', '_').lower();
      let realmPath = /databases/$(database)/documents/role_realms_of_operation/$(realmId);
      let realm = exists(realmPath) ? get(realmPath).data : {};
      return isAuthenticated() && realm.get('tenantId', '') == user.tenantId
        && realm.get('roleType', '') == 'custom' && realm.get('roleName', '') == user.role
        && moduleKey in realm.get('permissions', {})
        && realm.permissions[moduleKey].accessLevel in accessLevels;
    }

    function hasCustomModuleFunctional(moduleKey) {
      return hasCustomModuleAccess(moduleKey, ['view_functional', 'all']);
    }

    function isSettingsAdmin() {
      return isAuthenticated() && (isAdmin() || isIT() || hasCustomModuleFunctional('settings'));
    }

    function isProcurement() {
      return isAuthenticated() && (
        hasAnyRole(['Procurement Head', 'Procurement Officer', 'Procurement Manager', 'Procurement Personnel']) ||
        hasCustomModuleFunctional('procurement') ||
        isAdmin()
      );
    }

    function hasProcurementRole() {
      return isAuthenticated() && (
        hasAnyRole(['Procurement Head', 'Procurement Officer', 'Procurement Manager', 'Procurement Personnel'])
      );
    }

    function isInventoryOperator() {
      return isAuthenticated() && (
        hasAnyRole([
          'Branch Manager', 'branch manager', 'Pharmacist', 'pharmacist',
          'Procurement Head', 'Procurement Officer', 'Procurement Manager', 'Procurement Personnel', 'admin', 'Admin'
        ]) ||
        hasCustomModuleFunctional('inventory') ||
        isAdmin()
      );
    }

    function isStockOperator() {
      return isAuthenticated() && (
        hasAnyRole([
          'Branch Manager', 'branch manager', 'Pharmacist', 'pharmacist',
          'Dispenser', 'dispenser', 'Procurement Head', 'Procurement Officer', 'Procurement Manager'
        ]) ||
        hasCustomModuleFunctional('stock') ||
        isAdmin()
      );
    }

    function activeStaffFields(profile) {
      return ('active' in profile && profile.active)
        || ('status' in profile && profile.status in ['active', 'Active', 'ACTIVE']);
    }
    function hasActiveStaffProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && activeStaffFields(get(/databases/$(database)/documents/staff/$(request.auth.uid)).data);
    }

    function isPOSOperator() {
      return hasActiveStaffProfile()
        && getUserData().role != 'cashier'
        && getUserData().role != 'Cashier'
        && (
        hasAnyRole(['Pharmacist', 'pharmacist', 'Dispenser', 'dispenser', 'Branch Manager', 'branch manager']) ||
        hasCustomModuleFunctional('sales') ||
        isAdmin()
      );
    }

    // Fresh, append-only correction evidence authorizes only this atomic commit.
    function isFreshAtomicRevision(requestId) {
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(requestId)).data;
      let staff = getUserData();
      let operationalRoles = ['Pharmacist', 'pharmacist', 'Dispenser', 'dispenser', 'Branch Manager', 'branch manager'];
      let globalRoles = ['owner', 'Owner', 'CEO', 'ceo', 'CEO / MD', 'ceo / md'];
      let roles = staff.get('secondaryRoles', []);
      return isAuthenticated()
        && (staff.get('active', false) || staff.get('status', '') in ['active', 'Active', 'ACTIVE'])
        && !(staff.role in ['cashier', 'Cashier'])
        && (staff.role in operationalRoles || roles.hasAny(operationalRoles) || staff.role in globalRoles || roles.hasAny(globalRoles) || hasCustomModuleFunctional('sales'))
        && !exists(/databases/$(database)/documents/pos_sale_revision_requests/$(requestId))
        && correction.executionMode == 'SPARK_ATOMIC' && correction.status == 'COMPLETED'
        && correction.createdAt == request.time && correction.requestedBy == request.auth.uid
        && correction.tenantId == staff.tenantId
        && (staff.get('assigned_branches', []).hasAny([correction.branchId]) || staff.get('branch_id', '') == correction.branchId || staff.role in globalRoles || roles.hasAny(globalRoles));
    }

    function isAtomicOriginalUpdate(saleId) {
      let next = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(next.revisionRequestId)).data;
      return isFreshAtomicRevision(next.revisionRequestId)
        && resource.data.engineVersion == 2 && resource.data.status == 'completed'
        && resource.data.get('revisionId', '') == '' && !resource.data.get('revisionLocked', false)
        && resource.data.get('supersededBySaleId', '') == ''
        && resource.data.createdAt is timestamp
        && request.time >= resource.data.createdAt
        && request.time - resource.data.createdAt <= duration.value(72, 'h')
        && correction.originalSaleId == saleId
        && correction.tenantId == resource.data.tenantId && correction.branchId == resource.data.branchId
        && correction.originalTotal == resource.data.totalAmount
        && correction.originalPaymentId == resource.data.canonicalPaymentId
        && correction.originalOutboxEventId == resource.data.transactionOutboxEventId
        && next.revisionId == correction.revisionId
        && next.revisionLifecycle == 'COMPLETED' && next.revisionLocked
        && (correction.requestType == 'POS_CREDIT_VOID'
          ? next.status == 'voided' && next.voidedBy == request.auth.uid && next.voidReason == correction.reason
            && next.get('supersededBySaleId', '') == ''
          : next.status == 'completed' && next.supersededBySaleId == correction.replacementSaleId
            && next.supersededByReceiptNumber == correction.replacementReceiptNumber)
        && next.revisionRequestedBy == request.auth.uid
        && next.revisionReason == correction.reason
        && next.revisionCompletedAt == request.time
        && (!correction.originalCreditPosted || atomicCreditCommit(correction))
        && (!(correction.originalWelfarePosted || correction.welfareAmount > 0) || atomicWelfareCommit(correction, resource.data))
        && next.diff(resource.data).affectedKeys().hasOnly([
          'revisionId', 'revisionRequestId', 'revisionLocked', 'revisionLifecycle',
          'pendingReplacementSaleId', 'supersededBySaleId', 'supersededByReceiptNumber',
          'revisionReason', 'revisionRequestedBy', 'revisionRequestedByName',
          'revisionRequestedAt', 'revisionCompletedAt', 'updatedAt',
          'quotationConversionStatus', 'quotationConversionReversalId', 'quotationConversionReversedAt',
          'status','voidReason','voidedBy','voidedAt'
        ])
        && (correction.requestType == 'POS_CREDIT_VOID' || !next.diff(resource.data).affectedKeys().hasAny(['voidReason','voidedBy','voidedAt']));
    }

    function hasAtomicCorrectionChain(requestId) {
      let correction = request.resource.data;
      let original = getAfter(/databases/$(database)/documents/sales/$(correction.originalSaleId)).data;
      let replacement = getAfter(/databases/$(database)/documents/sales/$(correction.replacementSaleId)).data;
      let reversal = getAfter(/databases/$(database)/documents/pos_payment_reversals/$(correction.paymentReversalId)).data;
      let audit = getAfter(/databases/$(database)/documents/audit_logs/$(correction.auditId)).data;
      let outbox = getAfter(/databases/$(database)/documents/pos_transaction_outbox/$(correction.originalOutboxEventId)).data;
      return correction.requestId == requestId && isFreshAtomicRevision(requestId)
        && correction.requestType == 'POS_SALE_REVISION_REQUESTED'
        && correction.engineVersion == 2 && correction.payloadVersion == 1
        && correction.reason is string && correction.reason.size() >= 8 && correction.reason.size() <= 500
        && correction.intentFingerprint is string && correction.intentFingerprint.size() > 0
        && correction.completedAt == request.time
        && original.revisionRequestId == requestId && original.supersededBySaleId == correction.replacementSaleId
        && original.tenantId == correction.tenantId && original.branchId == correction.branchId
        && original.receiptNumber == correction.originalReceiptNumber
        && correction.originalWelfarePosted == (original.get('welfarePostingStatus', '') == 'posted')
        && correction.originalCreditPosted == exists(/databases/$(database)/documents/credit_receivables/$(correction.originalSaleId))
        && replacement.revisionOfSaleId == correction.originalSaleId && replacement.revisionRequestId == requestId
        && replacement.revisionId == correction.revisionId
        && replacement.tenantId == correction.tenantId && replacement.branchId == correction.branchId
        && replacement.canonicalPaymentId == correction.replacementPaymentId
        && replacement.transactionOutboxEventId == correction.replacementOutboxEventId
        && replacement.operatorUid == request.auth.uid
        && replacement.totalAmount == correction.revisedTotal
        && replacement.total == correction.revisedTotal
        && replacement.receiptNumber == correction.replacementReceiptNumber
        && correction.revisedTotal - correction.originalTotal == correction.monetaryDelta
        && reversal.originalSaleId == correction.originalSaleId && reversal.revisionId == correction.revisionId
        && reversal.status == 'COMPLETED' && reversal.amountDelta == -correction.originalTotal
        && audit.userId == request.auth.uid && audit.objectId == correction.originalSaleId
        && audit.revisionRequestId == requestId && audit.reason == correction.reason && audit.createdAt == request.time
        && outbox.status == 'SUPERSEDED' && outbox.revisionRequestId == requestId;
    }

    function validAtomicCreditVoid(requestId, correction) {
      let before = get(/databases/$(database)/documents/sales/$(correction.originalSaleId)).data;
      let after = getAfter(/databases/$(database)/documents/sales/$(correction.originalSaleId)).data;
      let reversal = getAfter(/databases/$(database)/documents/pos_payment_reversals/$(correction.paymentReversalId)).data;
      let audit = getAfter(/databases/$(database)/documents/audit_logs/$(correction.auditId)).data;
      let outbox = getAfter(/databases/$(database)/documents/pos_transaction_outbox/$(correction.originalOutboxEventId)).data;
      return correction.requestType == 'POS_CREDIT_VOID' && requestId == 'credit_void_' + correction.originalSaleId
        && correction.requestId == requestId && correction.revisionId == requestId && isFreshAtomicRevision(requestId)
        && correction.engineVersion == 2 && correction.payloadVersion == 1 && correction.completedAt == request.time
        && correction.reason is string && correction.reason.size() >= 8 && correction.reason.size() <= 500
        && correction.originalCreditPosted && correction.originalWelfarePosted == false && correction.welfareAmount == 0
        && correction.creditReversal.carriedCollectionsUGX == 0 && correction.replacementOutboxEventId == null
        && correction.originalReceiptNumber == before.receiptNumber
        && (isReceivableCreditMethod(before.paymentMethod) || isReceivableCreditMethod(before.get('secondaryPaymentMethod', '')))
        && before.status == 'completed' && after.status == 'voided' && after.revisionRequestId == requestId
        && before.tenantId == correction.tenantId && before.branchId == correction.branchId
        && correction.originalTotal == before.totalAmount && correction.revisedTotal == 0 && correction.monetaryDelta == -before.totalAmount
        && reversal.originalSaleId == correction.originalSaleId && reversal.revisionId == requestId
        && reversal.status == 'COMPLETED' && reversal.amountDelta == -before.totalAmount
        && audit.userId == request.auth.uid && audit.objectId == correction.originalSaleId
        && audit.revisionRequestId == requestId && audit.reason == correction.reason && audit.createdAt == request.time
        && outbox.status == 'SUPERSEDED' && outbox.revisionRequestId == requestId;
    }

    function atomicPaymentReversal() {
      let row = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId)).data;
      let payment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      return isFreshAtomicRevision(row.atomicRevisionRequestId)
        && row.reversalId == correction.paymentReversalId
        && row.originalPaymentId == correction.originalPaymentId
        && row.originalSaleId == correction.originalSaleId && row.revisionId == correction.revisionId
        && row.tenantId == correction.tenantId && row.branchId == correction.branchId
        && row.requestedBy == request.auth.uid && row.reason == correction.reason
        && row.source == 'POS_REVISION' && row.engineVersion == 2
        && row.status == 'COMPLETED' && row.completedAt == request.time
        && row.amountDelta == -payment.amount && row.settledDelta == -payment.settledAmount
        && row.outstandingDelta == -payment.outstandingAmount;
    }

    function atomicOutboxSupersession(eventId) {
      let next = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(next.revisionRequestId)).data;
      return isFreshAtomicRevision(next.revisionRequestId)
        && eventId == correction.originalOutboxEventId
        && resource.data.saleId == correction.originalSaleId
        && resource.data.paymentId == correction.originalPaymentId
        && resource.data.tenantId == correction.tenantId && resource.data.branchId == correction.branchId
        && resource.data.status != 'SUPERSEDED'
        && next.status == 'SUPERSEDED' && next.supersededByEventId == correction.replacementOutboxEventId
        && next.leaseOwner == null && next.leaseExpiresAt == null
        && next.diff(resource.data).affectedKeys().hasOnly(['status', 'supersededByEventId', 'revisionRequestId', 'leaseOwner', 'leaseExpiresAt', 'updatedAt']);
    }

    function canReadPosFinancial() {
      let row = resource.data;
      let saleId = row.get('saleId', row.get('receipt_id', ''));
      let sale = get(/databases/$(database)/documents/sales/$(saleId)).data;
      return isPOSOperator() && sale.engineVersion == 2
        && sale.tenantId == getUserData().tenantId && row.tenantId == sale.tenantId
        && isAssignedToBranch(sale.branchId);
    }

    function isReceivableCreditMethod(method) {
      return method in ['institutional_credit', 'credit'];
    }
    function creditComponent(row, method, amount) {
      return row.method == method && row.amount == amount
        && row.outstandingAmount == (isReceivableCreditMethod(method) ? amount : 0)
        && row.settledAmount == (isReceivableCreditMethod(method) ? 0 : amount);
    }
    function validCreditPayment(p, sale) {
      let primary = sale.paymentMethod;
      let second = sale.get('secondaryPaymentMethod', '');
      let split = second != '' && second != null;
      let secondAmount = split ? sale.secondaryAmount : 0;
      return p.paymentMethod == primary && p.outstandingAmount is number && p.outstandingAmount > 0
        && p.outstandingAmount <= 9007199254740991
        && ((isReceivableCreditMethod(primary) && (!split || second in ['cash','mtn_momo','airtel_money','card','momo','airtel']))
          || (isReceivableCreditMethod(second) && primary in ['cash','mtn_momo','airtel_money','card','momo','airtel']))
        && p.components.size() == (split ? 2 : 1)
        && creditComponent(p.components[0], primary, p.amount - secondAmount)
        && (!split || (secondAmount > 0 && secondAmount < p.amount && creditComponent(p.components[1], second, secondAmount)))
        && p.outstandingAmount == (isReceivableCreditMethod(primary) ? p.amount - secondAmount : secondAmount);
    }
    function creditDebtorMatches(row, sale) {
      let institution = sale.get('institutionId', null);
      let client = sale.get('patientId', null) != null ? sale.patientId : sale.get('clientId', null);
      let kind = institution != null ? 'institutions' : 'clients';
      let debtor = get(/databases/$(database)/documents/$(kind)/$(row.debtorId)).data;
      let linked = (institution != null && client != null) ? get(/databases/$(database)/documents/clients/$(client)).data : {};
      return row.debtorId == (institution != null ? institution : client)
        && row.debtorType == (institution != null ? 'institution' : 'client')
        && row.institution_id == institution && row.client_id == client
        && debtor.tenantId == row.tenantId && debtor.get('care_status', debtor.get('status', 'active')).lower() == 'active'
        && debtor.get('active', true) && debtor.get('isActive', true)
        && debtor.get('creditEligible', true) && debtor.get('credit_eligible', true)
        && debtor.get('billingEligible', true) && debtor.get('billing_eligible', true)
        && debtor.get('branch_id', row.branch_id) == row.branch_id && debtor.get('branchId', row.branch_id) == row.branch_id
        && (institution != null ? debtor.get('role', 'billable').lower() in ['billable', 'both']
            : debtor.get('billing_type', 'self-pay') != 'institutional-pay')
        && (institution == null || client == null || (linked.tenantId == row.tenantId
          && (linked.get('billing_type', 'self-pay') != 'institutional-pay' || linked.institution_to_bill_id == institution)))
        && row.client_name != '' && row.client_name == (institution != null
          ? debtor.get('supplier_name', debtor.get('institution_name', debtor.get('name', '')))
          : debtor.get('full_name', debtor.get('fullName', debtor.get('name', ''))))
        && row.credit_terms == debtor.get('payment_terms', null);
    }
    function validCreditRecognition(id, row) {
      let salePath = /databases/$(database)/documents/sales/$(id);
      let sale = getAfter(salePath).data;
      let payment = getAfter(/databases/$(database)/documents/pos_payments/$(row.paymentId)).data;
      return !exists(salePath) && row.recognizedBy == request.auth.uid && sale.operatorUid == request.auth.uid
        && row.keys().hasOnly(['tenantId','branch_id','receipt_id','paymentId','invoice_number','debtorType',
          'debtorId','client_id','institution_id','client_name','invoice_amount_ugx','amount_ugx','outstanding_ugx',
          'status','credit_terms','due_date','created_at','originalSaleId','recognizedBy','source','engineVersion',
          'controlVersion','currency','createdAt','updatedAt','atomicRevisionRequestId','carriedCollectionsUGX'])
        && row.controlVersion == 2 && row.engineVersion == 2 && row.source == 'POS' && row.currency == 'UGX'
        && row.receipt_id == id && row.due_date == null && row.createdAt == request.time && row.updatedAt == request.time
        && sale.engineVersion == 2 && sale.status == 'completed' && sale.inventoryPosted == true
        && row.tenantId == getUserData().tenantId && row.tenantId == sale.tenantId && row.branch_id == sale.branchId
        && row.paymentId == sale.canonicalPaymentId && payment.saleId == id
        && row.invoice_number == sale.receiptNumber && row.created_at == sale.timestamp
        && row.originalSaleId == sale.get('revisionOfSaleId', id)
        && (isReceivableCreditMethod(sale.paymentMethod) || isReceivableCreditMethod(sale.get('secondaryPaymentMethod', '')))
        && row.invoice_amount_ugx == sale.totalAmount && row.amount_ugx == payment.outstandingAmount && row.amount_ugx > 0
        && row.outstanding_ugx == row.amount_ugx - row.get('carriedCollectionsUGX', 0) && row.outstanding_ugx >= 0
        && row.status == (row.outstanding_ugx == 0 ? 'paid' : row.outstanding_ugx == row.amount_ugx ? 'outstanding' : 'partial')
        && (row.get('carriedCollectionsUGX', 0) == 0 || validCreditCarry(row, sale))
        && creditDebtorMatches(row, sale);
    }
    function validCreditCarry(row, sale) {
      let path = /databases/$(database)/documents/pos_sale_revision_requests/$(sale.revisionRequestId);
      let correction = getAfter(path).data;
      let original = get(/databases/$(database)/documents/credit_receivables/$(row.originalSaleId)).data;
      return !exists(path) && correction.createdAt == request.time && correction.originalCreditPosted
        && correction.originalSaleId == row.originalSaleId && correction.replacementSaleId == row.receipt_id
        && row.carriedCollectionsUGX > 0 && row.carriedCollectionsUGX == correction.creditReversal.carriedCollectionsUGX
        && row.debtorId == original.debtorId && row.debtorType == original.debtorType;
    }

    function atomicCreditUpdate(receivableId) {
      let row = request.resource.data;
      let before = resource.data;
      let path = /databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId);
      let correction = getAfter(path).data;
      let reversalPath = /databases/$(database)/documents/pos_credit_reversals/$(row.reversalId);
      let reversal = getAfter(reversalPath).data;
      return !exists(path) && !exists(reversalPath) && correction.createdAt == request.time
        && correction.originalCreditPosted && receivableId == correction.originalSaleId && before.receipt_id == receivableId
        && before.tenantId == correction.tenantId && before.branch_id == correction.branchId
        && row.outstanding_ugx == 0 && row.status == 'reversed'
        && row.revisionId == correction.revisionId && row.reversalId == correction.creditReversal.reversalId
        && row.reversedAmount == before.outstanding_ugx && row.refundDueUGX == reversal.refundDueUGX
        && row.reversedAt == request.time && row.reversedBy == request.auth.uid && row.reversalReason == correction.reason
        && row.diff(before).affectedKeys().hasOnly(['status','outstanding_ugx','reversalId','revisionId','reversedAmount',
          'reversedAt','reversedBy','reversedByName','reversalReason','updatedAt','atomicRevisionRequestId','refundDueUGX']);
    }

    function atomicWelfareRecord(recordId, collectionName) {
      let row = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId)).data;
      let replacement = row.saleId == correction.replacementSaleId;
      let expectedId = replacement
        ? (collectionName == 'welfare' ? correction.replacementWelfareId : collectionName == 'branch_expenses' ? correction.replacementWelfareExpenseId : correction.replacementWelfareTransferId)
        : (collectionName == 'welfare' ? correction.welfareReversal.welfareId : collectionName == 'branch_expenses' ? correction.welfareReversal.expenseId : correction.welfareReversal.transferId);
      let expectedAmount = replacement ? correction.welfareAmount : correction.welfareReversal.amountDelta;
      return isFreshAtomicRevision(row.atomicRevisionRequestId)
        && recordId == expectedId && row.tenantId == correction.tenantId
        && row.saleId in [correction.originalSaleId, correction.replacementSaleId]
        && row.get('amountDelta', row.amount) == expectedAmount
        && expectedAmount != 0
        && (collectionName == 'cashTransfers' || row.branchId == correction.branchId)
        && (replacement || (row.revisionId == correction.revisionId && row.status == 'reversed'));
    }

    function atomicWelfareBalance(beneficiaryId) {
      let next = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(next.atomicRevisionRequestId)).data;
      let original = getAfter(/databases/$(database)/documents/sales/$(correction.originalSaleId)).data;
      let oldPayment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      let oldAmount = correction.originalWelfarePosted ? -oldPayment.components[0].amount : 0;
      let nextSpent = resource.data.get('welfare_spent', 0) + oldAmount + correction.welfareAmount;
      return isFreshAtomicRevision(next.atomicRevisionRequestId)
        && resource.data.tenantId == correction.tenantId
        && beneficiaryId == original.patientId
        && (correction.welfareAmount == 0 || beneficiaryId == correction.welfareBeneficiaryId)
        && (!resource.data.get('is_duplicate', false) || correction.welfareAmount == 0)
        && next.welfare_spent == nextSpent && next.welfare_spent >= 0
        && next.welfare_used_ytd == resource.data.get('welfare_used_ytd', 0) + oldAmount + correction.welfareAmount
        && next.welfare_used_ytd >= 0
        && next.diff(resource.data).affectedKeys().hasOnly(['welfare_spent', 'welfare_used_ytd', 'updatedAt', 'atomicRevisionRequestId']);
    }

    function atomicFinancialPostingChain() {
      let payment = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(payment.revisionRequestId)).data;
      return isFreshAtomicRevision(payment.revisionRequestId)
        && (payment.paymentMethod != 'staff_welfare' ||
          (correction.welfareAmount == payment.components[0].amount
          && payment.components[0].method == 'staff_welfare'
          && getAfter(/databases/$(database)/documents/welfare/$(correction.replacementWelfareId)).data.amount == correction.welfareAmount
          && getAfter(/databases/$(database)/documents/branch_expenses/$(correction.replacementWelfareExpenseId)).data.amount == correction.welfareAmount
          && getAfter(/databases/$(database)/documents/cashTransfers/$(correction.replacementWelfareTransferId)).data.amount == correction.welfareAmount));
    }

    function atomicFinancialReversal(reversalId, collectionName) {
      let row = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId)).data;
      let payment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      let expectedId = collectionName == 'pos_credit_reversals' ? correction.creditReversal.reversalId
        : collectionName == 'pos_welfare_reversals' ? correction.welfareReversal.reversalId : correction.quotationReversal.reversalId;
      return isFreshAtomicRevision(row.atomicRevisionRequestId)
        && reversalId == expectedId && row.revisionId == correction.revisionId
        && row.tenantId == correction.tenantId && row.branchId == correction.branchId
        && row.requestedBy == request.auth.uid && row.reason == correction.reason
        && row.status == 'COMPLETED' && row.completedAt == request.time
        && (collectionName == 'pos_quotation_reversals' || row.originalSaleId == correction.originalSaleId)
        && (collectionName != 'pos_credit_reversals' || validCreditRevisionAmounts(row, correction, payment))
        && (collectionName != 'pos_welfare_reversals' || row.amountDelta == -payment.components[0].amount);
    }

    function verifiedCreditCollection(before, receivableId) {
      let p = get(receivableSettlementPath(before.lastSettlementId)).data;
      return p.tenantId == before.tenantId && p.receivableId == receivableId
        && p.outstandingAfterUGX == before.outstanding_ugx;
    }
    function validCreditRevisionAmounts(reversal, correction, payment) {
      let path = /databases/$(database)/documents/credit_receivables/$(correction.originalSaleId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let carry = reversal.carriedCollectionsUGX;
      let collected = before.amount_ugx - before.outstanding_ugx;
      let next = carry > 0 ? getAfter(/databases/$(database)/documents/credit_receivables/$(correction.replacementSaleId)).data : {};
      return correction.originalCreditPosted && before.amount_ugx == payment.outstandingAmount
        && before.outstanding_ugx >= 0 && collected >= 0 && (collected == 0 || verifiedCreditCollection(before, correction.originalSaleId))
        && !('reversalId' in before) && after.reversalId == reversal.reversalId
        && reversal.originalReceivableId == correction.originalSaleId && reversal.originalPaymentId == correction.originalPaymentId
        && reversal.amount == before.amount_ugx && reversal.amountDelta == -before.outstanding_ugx
        && reversal.outstandingDelta == reversal.amountDelta && reversal.collectedUGX == collected
        && carry >= 0 && carry <= collected && carry == correction.creditReversal.carriedCollectionsUGX
        && (carry == 0 || (next.originalSaleId == correction.originalSaleId && next.carriedCollectionsUGX == carry))
        && reversal.refundDueUGX == collected - carry + (correction.get('requestType', '') == 'POS_CREDIT_VOID' ? payment.settledAmount : 0);
    }
    function atomicCreditCommit(correction) {
      let path = /databases/$(database)/documents/credit_receivables/$(correction.originalSaleId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let reversalPath = /databases/$(database)/documents/pos_credit_reversals/$(correction.creditReversal.reversalId);
      let reversal = getAfter(reversalPath).data;
      return !exists(reversalPath) && before.tenantId == correction.tenantId && after.tenantId == correction.tenantId
        && after.outstanding_ugx == 0 && after.status == 'reversed'
        && after.reversalId == correction.creditReversal.reversalId
        && reversal.originalSaleId == correction.originalSaleId && reversal.amountDelta == -before.outstanding_ugx;
    }

    function atomicWelfareCommit(correction, original) {
      let beneficiaryCollection = original.get('welfareBeneficiaryIsStaff', false) ? 'staff' : 'clients';
      let beneficiaryId = original.patientId;
      let before = get(/databases/$(database)/documents/$(beneficiaryCollection)/$(beneficiaryId)).data;
      let after = getAfter(/databases/$(database)/documents/$(beneficiaryCollection)/$(beneficiaryId)).data;
      let payment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      let oldAmount = correction.originalWelfarePosted ? payment.components[0].amount : 0;
      return before.tenantId == correction.tenantId && after.tenantId == correction.tenantId
        && after.welfare_spent == before.get('welfare_spent', 0) - oldAmount + correction.welfareAmount
        && after.welfare_used_ytd == before.get('welfare_used_ytd', 0) - oldAmount + correction.welfareAmount
        && after.welfare_spent >= 0 && after.welfare_used_ytd >= 0
        && (correction.welfareAmount == 0 || correction.welfareBeneficiaryId == beneficiaryId)
        && (!correction.originalWelfarePosted ||
          (correction.welfareReversal.amountDelta == -oldAmount
          && getAfter(/databases/$(database)/documents/welfare/$(correction.welfareReversal.welfareId)).data.amount == -oldAmount
          && getAfter(/databases/$(database)/documents/branch_expenses/$(correction.welfareReversal.expenseId)).data.amount == -oldAmount
          && getAfter(/databases/$(database)/documents/cashTransfers/$(correction.welfareReversal.transferId)).data.amountDelta == -oldAmount
          && getAfter(/databases/$(database)/documents/pos_welfare_reversals/$(correction.welfareReversal.reversalId)).data.amountDelta == -oldAmount));
    }

    function isMarketing() {
      return isAuthenticated() && (
        hasAnyRole(['Marketing Head', 'Marketing Personnel', 'Marketing Manager', 'admin', 'Admin']) ||
        hasCustomModuleFunctional('marketing') || isAdmin()
      );
    }

    function hasCustomModuleView(moduleKey) {
      return hasCustomModuleAccess(moduleKey, ['view_only', 'view_functional', 'all']);
    }

    function canViewFinance() {
      return isFinance() || isITPersonnel() || hasCustomModuleView('finance');
    }

    function hasBranchFinanceRole() {
      return isAuthenticated() && (
        hasAnyRole(['Branch Manager', 'branch manager', 'Cashier', 'cashier'])
      );
    }

    function canViewBranchFinance() {
      return isAuthenticated() && (
        hasBranchFinanceRole() ||
        hasAnyRole(['Finance Head', 'Accountant', 'admin', 'Admin']) ||
        isITPersonnel() || hasCustomModuleView('finance') || isAdmin()
      );
    }

    function canOperateBranchFinance() {
      return isAuthenticated() && (
        hasBranchFinanceRole() ||
        hasAnyRole(['Finance Head', 'Accountant', 'admin', 'Admin']) ||
        hasCustomModuleFunctional('finance') || isAdmin()
      );
    }

    function isProtectedFinanceCollection(collectionName) {
      return collectionName in [
        'finance_ledger', 'eod_reconciliations', 'branch_expenses', 'cash_requisitions',
        'credit_receivables', 'supplier_payables', 'banking_records',
        'client_credit_ledger', 'institution_credit_ledger', 'supplier_credit_ledger',
        'petty_cash_ledger', 'finance_payment_accounts', 'cash_grn_payments', 'cashTransfers', 'invoices', 'procurement_invoices', 'creditLedger', 'creditPayments', 'financial_posting_audit', 'financial_metrics', 'management_expenses',
        'audit_logs', 'sale_revisions', 'pos_sale_revision_requests', 'pos_payment_reversals', 'pos_welfare_reversals', 'pos_credit_reversals', 'pos_quotation_reversals'
      ] || collectionName.matches('finance_.*_v1');
    }

    function canPostManagementCash() {
      return isAuthenticated() && (
        hasAnyRole(['Finance Head','Finance Officer','Accountant','HR Head','HR Support Personnel','HR Manager','Logistics Head','Transport & Logistics Personnel','Logistics Manager','Procurement Head','Procurement Officer','Procurement Manager','Procurement Personnel','admin','Admin'])
        || hasCustomModuleFunctional('finance') || hasCustomModuleFunctional('hr')
        || hasCustomModuleFunctional('logistics') || hasCustomModuleFunctional('procurement') || isAdmin());
    }
    function managementMovementPath(kind, id) {
      return kind == 'bank'
        ? /databases/$(database)/documents/banking_records/$(id)
        : /databases/$(database)/documents/petty_cash_ledger/$(id);
    }
    function validBranchEodSubmission(id, audit) {
      let operator = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
      let branch = get(/databases/$(database)/documents/branches/$(audit.branch_id)).data;
      return audit.financial_posting == 'portfolios_v1'
        && (audit.branch_id in operator.get('assigned_branches', []) || operator.get('branch_id', '') == audit.branch_id || isFinance())
        && branch.tenantId == audit.tenantId && operator.tenantId == audit.tenantId
        && audit.cashier_id == request.auth.uid && branch.shifts[audit.shift_id].enabled
        && audit.shift_start == branch.shifts[audit.shift_id].startTime && audit.shift_end == branch.shifts[audit.shift_id].endTime
        && id == audit.reconciliation_key
        && id == 'eod~' + audit.tenantId + '~' + audit.branch_id + '~' + audit.reconciliation_date + '~' + audit.shift_id
        && audit.get('card_settlement_account_id', null) == branch.get('cardSettlement', {}).get('bankPortfolioId', null);
    }
    // Every EOD movement requires the paired audit create/correction to pass its own Rules.
    function validBranchEodMovement(id, data) {
      let path = /databases/$(database)/documents/eod_reconciliations/$(data.eodReconciliationId);
      let audit = getAfter(path).data;
      let correcting = exists(path);
      let channel = data.eodChannel;
      let target = channel == 'cash' ? 'system_branch_cash_sales_' + audit.branch_id
        : channel == 'momo' ? 'system_mtn_mobile_money'
        : channel == 'airtel' ? 'system_airtel_mobile_money'
        : audit.card_settlement_account_id;
      return audit.financial_posting == 'portfolios_v1'
        && channel in ['cash','momo','airtel','card']
        && data.tenantId == audit.tenantId && data.branchId == audit.branch_id
        && data.accountDocumentId == audit.tenantId + '_' + target
        && (correcting
          ? (audit.correction_posting_id == data.eodCorrectionId
            && audit.correction_posting_id != get(path).data.get('correction_posting_id', '')
            && audit.corrected_at == request.time
            && id == audit.correction_posting_id + '~' + channel
            && data.accountDeltaUGX == audit[channel + '_actual'] - get(path).data[channel + '_actual'])
          : (id == audit.reconciliation_key + '~' + channel
            && data.type == 'incoming' && data.amount == audit[channel + '_actual']));
    }
    function eodChannelPosted(id, audit, channel, bank) {
      let prior = /databases/$(database)/documents/eod_reconciliations/$(id);
      let correcting = exists(prior);
      let delta = audit[channel + '_actual'] - (correcting ? get(prior).data[channel + '_actual'] : 0);
      let posting = correcting ? audit.correction_posting_id : id;
      let path = managementMovementPath(bank ? 'bank' : 'petty_cash', posting + '~' + channel);
      return audit[channel + '_actual'] is int && audit[channel + '_actual'] >= 0
        && (delta == 0 || (!exists(path) && getAfter(path).data.eodReconciliationId == id));
    }
    function linkedPortfolioTransfer(id, data, before, after) {
      let path = /databases/$(database)/documents/finance_transfers_v1/$(data.portfolioTransferId);
      let transfer = getAfter(path).data;
      let incoming = id == transfer.destinationMovement.id;
      let charge = id == transfer.id + '_fee';
      let expectedAmount = charge ? transfer.chargeUGX : transfer.principalUGX;
      return !exists(path) && transfer.postedAt == request.time
        && (incoming || id == transfer.sourceMovement.id || (charge && transfer.chargeUGX > 0))
        && data.tenantId == transfer.tenantId && data.postedBy == transfer.initiatedBy
        && data.amount == expectedAmount && data.reference_number == transfer.reference
        && data.accountDocumentId == (incoming ? transfer.destination.accountDocumentId : transfer.source.accountDocumentId)
        && data.accountDeltaUGX == (incoming ? expectedAmount : -expectedAmount)
        && data.movementClass == (incoming ? 'transfer_in' : charge ? 'transfer_charge' : 'transfer_out')
        && after.lastPostingId == (incoming ? transfer.destinationMovement.id : transfer.sourceMovement.id)
        && after.balanceUGX == before.balanceUGX + (incoming ? transfer.principalUGX : -transfer.principalUGX - transfer.chargeUGX);
    }
    function canPayBranchExpense(branchId, tenantId) {
      let actor = getUserData();
      let roles = actor.get('secondaryRoles', []);
      return actor.tenantId == tenantId
        && (actor.role == 'Finance Head' || 'Finance Head' in roles
          || ((actor.role in ['Branch Manager', 'branch manager'] || roles.hasAny(['Branch Manager', 'branch manager']))
            && (branchId in actor.get('assigned_branches', []) || branchId == actor.get('branch_id', '')
              || branchId == actor.get('default_branch_id', ''))));
    }
    function linkedExternalExpense(id, data, account) {
      let collectionName = data.externalExpenseCollection;
      let sourceId = data.externalExpenseId;
      let path = /databases/$(database)/documents/$(collectionName)/$(sourceId);
      let expense = getAfter(path).data;
      return data.type == 'outgoing' && account.initialized && account.currency == 'UGX'
        && expense.tenantId == data.tenantId && data.tenantId == account.tenantId
        && (collectionName == 'branch_expenses'
          ? id == 'expense_payment_' + sourceId && expense.cashPaymentVersion == 1
            && expense.cashPaidAt == request.time && expense.cashOutflowPostingId == id
            && expense.amount_ugx == data.amount && expense.category == data.expenseCategory
            && expense.branch_id == data.branchId && account.accountId == 'system_petty_cash_' + expense.branch_id
            && account.scope.kind == 'branch' && account.scope.branchId == expense.branch_id
            && get(path).data.status == 'approved'
          : account.accountId == 'management_petty_cash' &&
            (collectionName == 'management_expenses'
              ? isFinance() && id == 'expense_payment_' + sourceId && expense.status == 'approved'
                && expense.cashOutflowPostingId == id && expense.amount == data.amount && expense.category == data.expenseCategory
              : collectionName in ['fuel_logs','maintenance_logs','traffic_fine_logs','logistics_expenses']
                && id == 'logistics_payment_' + sourceId && !exists(path)
                && expense.get('cost_ugx', expense.get('fine_amount_ugx', 0)) == data.amount));
    }
    function canSettleSupplier(tenantId) {
      let staff = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
      let financeRoles = ['Finance Head', 'Finance Officer'];
      return isAuthenticated() && staff.tenantId == tenantId && !staff.get('is_duplicate', false) && staff.get('active', true)
        && staff.get('status', staff.get('active', false) ? 'active' : '') == 'active'
        && !staff.role.lower().matches('^(branch manager|cashier|dispenser|pharmacist|branch pharmacist)$')
        && (staff.role in financeRoles || staff.get('secondaryRoles', []).hasAny(financeRoles));
    }
    function activeSupplierFundingBranch(tenantId, branchId) {
      let branch = getAfter(/databases/$(database)/documents/branches/$(branchId)).data;
      return branch.tenantId == tenantId && !(branch.get('status', 'Active') in ['Inactive', 'Closed']);
    }
    function eligibleSupplierAccount(account, branchId) {
      let key = account.accountId;
      let scope = account.get('scope', {'kind': 'organisation'});
      let classification = account.get('portfolioClassification', '');
      let path = /databases/$(database)/documents/finance_portfolios_v1/$(account.tenantId + '__' + key);
      let registered = key.matches('^(bank_[a-f0-9]{64}|custom_[A-Za-z0-9_-]+)$');
      let portfolio = registered ? getAfter(path).data : {};
      return account.initialized && account.currency == 'UGX'
        && account.get('status', 'active') == 'active' && account.get('active', true)
        && scope.kind == (branchId == '' ? 'organisation' : 'branch') && scope.get('branchId', '') == branchId
        && (branchId == '' || activeSupplierFundingBranch(account.tenantId, branchId))
        && (key in ['management_petty_cash', 'management_bank']
          ? branchId == '' && account.kind == (key == 'management_bank' ? 'bank' : 'petty_cash')
          : account.portfolioId == key
            && (registered
              ? portfolio.status == 'active' && portfolio.tenantId == account.tenantId && portfolio.id == key
                && portfolio.origin == 'custom' && portfolio.currency == 'UGX'
                && portfolio.scope == scope && portfolio.classification == classification
                && account.kind == (classification in ['bank', 'mobile_money'] ? 'bank' : 'petty_cash')
                && (key.matches('^bank_.*') ? branchId == '' && classification == 'bank' && portfolio.bankParentId == 'system_bank'
                  : portfolio.allowsTransfersOut && classification in ['bank','mobile_money','cash_equivalent','petty_cash'])
              : (branchId == '' && key in ['system_mtn_mobile_money','system_airtel_mobile_money']
                  && account.kind == 'bank' && classification == 'mobile_money')
                || (branchId != '' && account.kind == 'petty_cash'
                  && ((key == 'system_branch_cash_sales_' + branchId && classification == 'cash_equivalent')
                    || (key == 'system_petty_cash_' + branchId && classification == 'petty_cash')))));
    }
    function supplierPaymentPath(id, credit) {
      let name = credit ? 'creditPayments' : 'cash_grn_payments';
      return /databases/$(database)/documents/$(name)/$(id);
    }
    function supplierMovement(id, data, before, after) {
      let credit = data.supplierPosting == 'credit';
      let path = supplierPaymentPath(data.paymentId, credit);
      let payment = getAfter(path).data;
      let fee = data.supplierCharge;
      let chargePath = managementMovementPath(before.kind, payment.movementId + '_fee');
      return data.supplierPosting in ['cash', 'credit'] && !exists(path) && payment.processedAt == request.time
        && data.tenantId == payment.tenantId && data.postedBy == payment.processedBy
        && data.invoiceId == payment.invoiceId && data.grnId == payment.grnId
        && (!credit || data.creditLedgerId == payment.creditLedgerId)
        && data.externalReference == payment.externalReference
        && data.reference_number == (credit ? payment.paymentReference : payment.reference)
        && before.tenantId == payment.tenantId && before.accountId == payment.paymentAccountId
        && data.paymentAccountId == before.accountId && before.kind == payment.paymentAccountKind
        && payment.fundingAccountName == before.name
        && data.accountDocumentId == payment.tenantId + '_' + before.accountId
        && data.fundingBranchId == payment.fundingBranchId
        && data.get('branchId', '') == payment.fundingBranchId
        && data.type == 'outgoing' && after.lastPostingId == payment.movementId
        && after.balanceUGX == before.balanceUGX - payment.totalDebitUGX
        && (fee == true
          ? id == payment.chargeMovementId && id == payment.movementId + '_fee'
            && data.amount == payment.chargeUGX && data.expenseCategory == 'Financial service expenses'
            && data.excludeFromOpexRollup == false
          : fee == false && id == payment.movementId && data.excludeFromOpexRollup
            && data.amount == (credit ? payment.amount : payment.amountUGX)
            && (payment.chargeUGX == 0 || (!exists(chargePath) && getAfter(chargePath).data.paymentId == data.paymentId)));
    }
    function isSupplierMovement(id, data) {
      return id.matches('^(procurement_cash_settlement_|credit_payment_).*')
        || data.keys().hasAny(['supplierPosting','supplierCharge','paymentId','creditLedgerId'])
        || data.get('source', '') in ['Procurement Cash GRN settlement', 'Supplier credit settlement', 'Supplier payment transaction charge'];
    }
    function receivableSettlementPath(id) {
      return /databases/$(database)/documents/finance_receivable_settlements_v1/$(id);
    }
    function receivableBranch(row) {
      return row.get('branch_id', row.get('branchId', ''));
    }
    function canCollectReceivable(tenantId, branchId) {
      let staff = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
      let branch = get(/databases/$(database)/documents/branches/$(branchId)).data;
      let centralRoles = ['Finance Head', 'Accountant', 'admin', 'Admin'];
      return isFinance() && staff.tenantId == tenantId && hasActiveStaffProfile()
        && !staff.get('is_duplicate', false) && staff.get('active', true)
        && staff.get('status', 'active').lower() == 'active'
        && branch.tenantId == tenantId && branch.get('status','active').lower() == 'active'
        && (staff.role in centralRoles || (('secondaryRoles' in staff) && staff.secondaryRoles.hasAny(centralRoles))
          || isAssignedToBranch(branchId)
          || (staff.get('assigned_branches', []).size() == 0 && staff.get('branch_id', '') == ''
            && staff.get('default_branch_id', '') == ''));
    }
    function eligibleReceivableDestination(a, branchId) {
      let key = a.accountId;
      let scope = a.scope;
      let kind = a.portfolioClassification;
      let path = /databases/$(database)/documents/finance_portfolios_v1/$(a.tenantId + '__' + key);
      let registered = key.matches('^(bank_[a-f0-9]{64}|custom_[A-Za-z0-9_-]+)$');
      let p = registered ? getAfter(path).data : {};
      return a.initialized == true && a.currency == 'UGX' && a.portfolioId == key
        && a.get('status', 'active') == 'active' && a.get('active', true)
        && (scope == {'kind': 'organisation'} || scope == {'kind': 'branch', 'branchId': branchId})
        && a.kind == (kind in ['bank', 'mobile_money'] ? 'bank' : 'petty_cash')
        && (registered
          ? p.id == key && p.origin == 'custom' && p.tenantId == a.tenantId && p.status == 'active'
            && p.currency == 'UGX' && p.scope == scope && p.classification == kind
            && kind in ['bank', 'mobile_money', 'cash_equivalent', 'petty_cash']
            && (p.get('bankParentId', '') == 'system_bank' || p.allowsTransfersIn)
          : (key == 'system_branch_cash_sales_' + branchId && scope.kind == 'branch' && kind == 'cash_equivalent')
            || (key in ['system_mtn_mobile_money','system_airtel_mobile_money'] && scope.kind == 'organisation' && kind == 'mobile_money'));
    }
    function isReceivableMovement(id, data) {
      return id.matches('^(receivable_payment_|transfer_receivable_).*')
        || data.keys().hasAny(['receivableSettlementId', 'receivableId'])
        || data.get('source', '') == 'Credit receivable payment';
    }
    function validReceivableMovement(id, data, account) {
      let path = receivableSettlementPath(data.receivableSettlementId);
      let p = getAfter(path).data;
      return !exists(path) && p.recordedAt == request.time && id == p.movementId
        && data.keys().hasOnly(['tenantId','branchId','portfolioId','accountDocumentId','accountDeltaUGX',
          'amount','type','source','reference_number','receivableSettlementId','receivableId','invoiceNumber',
          'postedBy','date','createdAt','updatedAt'])
        && data.type == 'incoming' && data.source == 'Credit receivable payment' && data.amount == p.amountUGX
        && data.tenantId == p.tenantId && data.branchId == p.branchId && data.portfolioId == account.accountId
        && data.accountDocumentId == p.accountDocumentId && data.postedBy == p.actorId && data.date == p.date
        && data.receivableId == p.receivableId && data.invoiceNumber == p.invoiceNumber
        && data.reference_number == p.reference && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function validReceivableRowSettlement(id, before, after) {
      let path = receivableSettlementPath(after.lastSettlementId);
      let p = getAfter(path).data;
      return !exists(path) && p.recordedAt == request.time && p.receivableId == id
        && p.tenantId == before.tenantId && before.outstanding_ugx > 0 && before.outstanding_ugx <= before.amount_ugx
        && !(before.get('status', 'outstanding').lower() in ['paid', 'reversed', 'voided'])
        && p.outstandingBeforeUGX == before.outstanding_ugx
        && after.outstanding_ugx == p.outstandingAfterUGX && after.outstanding_ugx >= 0
        && after.outstanding_ugx == before.outstanding_ugx - p.amountUGX
        && after.status == (after.outstanding_ugx == 0 ? 'paid' : 'partial')
        && after.lastProcessedAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['outstanding_ugx','status','lastSettlementId','lastProcessedAt']);
    }
    match /finance_receivable_settlements_v1/{requestId} {
      function validSettlement(p) {
        let debtPath = /databases/$(database)/documents/credit_receivables/$(p.receivableId);
        let debt = get(debtPath).data;
        let next = getAfter(debtPath).data;
        let accountPath = /databases/$(database)/documents/finance_payment_accounts/$(p.accountDocumentId);
        let account = get(accountPath).data;
        let accountAfter = getAfter(accountPath).data;
        let move = managementMovementPath(p.destinationKind, p.movementId);
        let movement = getAfter(move).data;
        let day = p.date.split('-');
        let start = timestamp.date(int(day[0]), int(day[1]), int(day[2])) - duration.value(3, 'h');
        return requestId.matches('^[A-Za-z0-9_-]{20,100}$')
          && p.keys().hasOnly(['tenantId','receivableId','destinationAccountId','amountUGX','reference','requestId',
            'actorId','settlementId','branchId','sourceSaleId','originalSaleId','invoiceId','invoiceNumber','customerId','customerName',
            'outstandingBeforeUGX','outstandingAfterUGX','destinationPortfolio','destinationKind','destinationName',
            'accountDocumentId','movementId','date','recordedAt'])
          && p.actorId == request.auth.uid && p.recordedAt == request.time
          && p.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.time >= start && request.time < start + duration.value(1, 'd')
          && p.settlementId == requestId && p.requestId == requestId && p.movementId == 'receivable_payment_' + requestId
          && p.amountUGX is int && p.amountUGX > 0 && p.reference is string && p.reference.size() >= 3 && p.reference.size() <= 120
          && canCollectReceivable(p.tenantId, p.branchId) && debt.tenantId == p.tenantId && receivableBranch(debt) == p.branchId
          && (p.sourceSaleId != '' || p.invoiceId != '')
          && p.sourceSaleId == debt.get('receipt_id', debt.get('saleId', ''))
          && p.originalSaleId == debt.get('originalSaleId', p.sourceSaleId)
          && p.invoiceId == debt.get('invoiceId', debt.get('invoice_id', ''))
          && p.invoiceNumber == debt.get('invoice_number', debt.get('receiptNumber', ''))
          && p.customerId == (debt.get('debtorId', null) != null ? debt.debtorId
            : debt.get('institution_id', null) != null ? debt.institution_id
            : debt.get('client_id', null) != null ? debt.client_id : '')
          && p.customerName == debt.get('client_name', debt.get('institution_name', ''))
          && next.lastSettlementId == requestId && debt.get('lastSettlementId', '') != requestId
          && p.accountDocumentId == p.tenantId + '_' + p.destinationAccountId
          && account.tenantId == p.tenantId && account.accountId == p.destinationAccountId
          && account.name == p.destinationName && account.kind == p.destinationKind
          && account.portfolioClassification == p.destinationPortfolio && eligibleReceivableDestination(account, p.branchId)
          && accountAfter.lastPostingId == p.movementId && accountAfter.balanceUGX == account.balanceUGX + p.amountUGX
          && !exists(move) && movement.receivableSettlementId == requestId;
      }
      allow get: if canViewFinance() && (resource == null || resource.data.tenantId == getUserData().tenantId);
      allow list: if resource.data.tenantId == getUserData().tenantId && (canViewFinance() ||
        ((canViewBranchFinance() || isPOSOperator() || hasCustomModuleView('clients')) && isAssignedToBranch(resource.data.branchId)));
      allow create: if validSettlement(request.resource.data);
    }
    function validManagementMovement(id, data, kind) {
      let accountPath = /databases/$(database)/documents/finance_payment_accounts/$(data.accountDocumentId);
      let before = get(accountPath).data;
      let after = getAfter(accountPath).data;
      let payroll = isPayrollMovement(id,data);
      let receivable = !payroll && isReceivableMovement(id,data);
      let supplier = !payroll && !receivable && isSupplierMovement(id,data);
      let transfer = !payroll && !receivable && !supplier
        && (id.matches('^pt_.*') || data.keys().hasAny(['portfolioTransferId','movementClass']));
      return data.postedBy == request.auth.uid
        && data.amount is int && data.amount > 0
        && data.type in ['incoming','deposit','topup','outgoing','withdrawal']
        && data.accountDeltaUGX == (data.type in ['incoming','deposit','topup'] ? data.amount : -data.amount)
        && before.kind == kind
        && (!data.keys().hasAny(['externalExpenseCollection','externalExpenseId']) || linkedExternalExpense(id, data, before))
        && ((payroll && validPayrollMovement(id,data,before,after))
          || (receivable && after.lastPostingId == id && after.balanceUGX == before.balanceUGX + data.amount
            && validReceivableMovement(id,data,before))
          || (supplier && !data.keys().hasAny(['portfolioTransferId','movementClass','transferId','externalExpenseCollection','externalExpenseId','eodChannel'])
            && supplierMovement(id,data,before,after))
          || (transfer && linkedPortfolioTransfer(id,data,before,after))
          || (!payroll && !receivable && !supplier && !transfer
            && after.lastPostingId == id && after.balanceUGX == before.balanceUGX + data.accountDeltaUGX));
    }
    // Canonical built-ins and legacy Management accounts have no custom registry.
    // getAfter prevents a posting from racing with lifecycle closure in the same batch.
    function activePortfolioAccount(data) {
      let path = /databases/$(database)/documents/finance_portfolios_v1/$(data.tenantId + '__' + data.accountId);
      return !exists(path) || getAfter(path).data.status == 'active';
    }
    function validManagementAccountUpdate(accountId, before, after) {
      let movementPath = managementMovementPath(before.kind, after.lastPostingId);
      let movement = getAfter(movementPath).data;
      let transferDebit = movement.get('movementClass', '') == 'transfer_out';
      let supplier = movement.get('supplierPosting', '') in ['cash', 'credit'];
      let branchExpense = !supplier && movement.get('externalExpenseCollection','') == 'branch_expenses';
      return ((supplier && canSettleSupplier(before.tenantId) && eligibleSupplierAccount(before,movement.fundingBranchId))
        || (!supplier && isTenantMember(before.tenantId) && activePortfolioAccount(before)
          && ((branchExpense && before.accountId == 'system_petty_cash_' + before.scope.branchId)
            || (!branchExpense && ((movement.get('eodChannel','') != '' && validBranchEodMovement(after.lastPostingId,movement))
              || isFinance() || (before.accountId == 'management_petty_cash' && canPostManagementCash()))))))
        // Every ledger create requires this paired update; authorize cash credits once here.
        && (movement.accountDeltaUGX <= 0 || before.accountId != 'management_petty_cash' || isFinance() || isHR())
        && after.diff(before).affectedKeys().hasOnly(['balanceUGX','lastPostingId','updatedAt'])
        && after.balanceUGX is int && after.balanceUGX >= 0 && after.balanceUGX <= 9007199254740991
        && !exists(movementPath)
        && movement.tenantId == before.tenantId && movement.accountDocumentId == accountId
        && (supplier || transferDebit || after.balanceUGX == before.balanceUGX + movement.accountDeltaUGX);
    }
    function validSupplierPaymentBase(id, data, credit) {
      let path = managementMovementPath(data.paymentAccountKind, data.movementId);
      let movement = getAfter(path).data;
      let amount = credit ? data.amount : data.amountUGX;
      return canSettleSupplier(data.tenantId) && data.processedBy == request.auth.uid
        && data.processedAt == request.time && data.status == 'posted' && data.excludeFromOpexRollup
        && amount is int && amount > 0
        && data.chargeUGX is int && data.chargeUGX >= 0
        && data.totalDebitUGX == amount + data.chargeUGX && data.totalDebitUGX <= 9007199254740991
        && data.movementId == (credit ? 'credit_payment_' + id : id)
        && data.chargeMovementId == (data.chargeUGX == 0 ? '' : data.movementId + '_fee')
        && data.requestId.matches('^[A-Za-z0-9_-]{1,150}$')
        && data.externalReference is string && data.externalReference.size() >= 3 && data.externalReference.size() <= 150
        && !exists(path) && movement.paymentId == id && movement.supplierCharge == false
        && movement.supplierPosting == (credit ? 'credit' : 'cash');
    }
    function freshSupplierLink(data, payment, path) {
      return !exists(path) && payment.processedAt == request.time && payment.tenantId == data.tenantId
        && payment.processedBy == request.auth.uid;
    }
    function validSupplierInvoiceUpdate(id, before, after, legacy) {
      let credit = before.get('paymentType', '') != 'cash';
      let path = supplierPaymentPath(after.lastPaymentId, credit);
      let payment = getAfter(path).data;
      let remaining = credit ? payment.balanceAfter : payment.remainingUGX;
      let amount = credit ? payment.amount : payment.amountUGX;
      return freshSupplierLink(after, payment, path)
        && (legacy ? payment.procurementInvoiceId == id : payment.invoiceId == id)
        && after.diff(before).affectedKeys().hasOnly(legacy
          ? ['paid_amount_ugx','paidAmountUGX','creditBalance','status','paymentStatus','updatedAt','lastPaymentReference','lastPaymentId']
          : ['paidAmountUGX','paymentStatus','creditBalance','updatedAt','lastPaymentReference','lastPaymentId'])
        && after.paidAmountUGX == payment.previouslyPaidUGX + amount
        && after.paymentStatus == (credit ? (remaining == 0 ? 'paid' : 'partial') : (remaining == 0 ? 'Paid' : 'Partially Paid'))
        && after.creditBalance == remaining && after.lastPaymentReference == payment.externalReference
        && (!legacy || (after.paidAmountUGX == after.paid_amount_ugx
          && after.status == (remaining == 0 ? 'Paid' : 'Partial')));
    }
    function validSupplierGrnPayment(id, before, after) {
      let credit = after.lastPaymentId.matches('^supplier_credit_settlement_.*');
      let path = supplierPaymentPath(after.lastPaymentId, credit);
      let payment = getAfter(path).data;
      let remaining = credit ? payment.balanceAfter : payment.remainingUGX;
      return freshSupplierLink(after, payment, path) && payment.grnId == id
        && before.get('invoice_id', payment.invoiceId) == payment.invoiceId
        && before.get('procurement_invoice_id', payment.get('procurementInvoiceId', '')) == payment.get('procurementInvoiceId', '')
        && after.diff(before).affectedKeys().hasOnly(['payment_status','lastPaymentId','updatedAt'])
        && after.payment_status == (remaining == 0 ? 'paid' : 'partial');
    }
    match /finance_payment_accounts/{accountId} {
      function eligiblePortfolioAccount(data) {
        let identity = data.accountId;
        let path = /databases/$(database)/documents/finance_portfolios_v1/$(data.tenantId + '__' + identity);
        return isCEO() && data.portfolioId == identity
          && data.kind in ['bank','petty_cash']
          && (identity.matches('^system_(mtn_mobile_money|airtel_mobile_money|branch_cash_sales_[A-Za-z0-9_-]+|petty_cash_[A-Za-z0-9_-]+)$')
            || (exists(path) && getAfter(path).data.status == 'active'));
      }
      allow get: if (canOperateBranchFinance() || canViewFinance() || canPostManagementCash()) && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if canViewFinance() && isTenantMember(resource.data.tenantId);
      function validAccountRegistration(data) {
        let identity = data.accountId;
        return isTenantMember(data.tenantId)
        && get(/databases/$(database)/documents/system_settings/$(data.tenantId)).data.managementCashAccountControlV1
        && accountId == data.tenantId + '_' + identity
        && (((isFinance() && identity in ['management_petty_cash','management_bank'])
          && data.kind == (identity == 'management_bank' ? 'bank' : 'petty_cash'))
          || eligiblePortfolioAccount(data))
        && data.currency == 'UGX' && data.controlVersion == 1
        && data.initialized && data.lastPostingId == null
        && data.balanceUGX is int && data.balanceUGX >= 0 && data.balanceUGX <= 9007199254740991
        && data.balanceUGX == data.openingBalanceUGX
        && data.registeredBy == request.auth.uid
        && data.name is string
        && data.reconciliationReference is string && data.reconciliationReference.size() >= 5;
      }
      allow create: if validAccountRegistration(request.resource.data);
      allow update: if validManagementAccountUpdate(accountId, resource.data, request.resource.data);
    }
    match /cash_grn_payments/{paymentId} {
      function validSettlement(data) {
        let invoicePath = /databases/$(database)/documents/invoices/$(data.invoiceId);
        let before = get(invoicePath).data;
        let invoice = getAfter(invoicePath).data;
        let grn = getAfter(/databases/$(database)/documents/grn_records/$(data.grnId)).data;
        let draft = getAfter(/databases/$(database)/documents/management_expenses/$(data.draftId)).data;
        let legacy = getAfter(/databases/$(database)/documents/procurement_invoices/$(data.procurementInvoiceId)).data;
        return validSupplierPaymentBase(paymentId, data, false)
          && get(/databases/$(database)/documents/system_settings/$(data.tenantId)).data.managementCashSettlementV1
          && paymentId == 'procurement_cash_settlement_' + data.tenantId + '_' + data.draftId + '_' + data.requestId
          && data.previouslyPaidUGX == before.get('paidAmountUGX', 0)
          && data.totalInvoiceUGX == before.invoiceValue
          && data.remainingUGX == data.totalInvoiceUGX - data.previouslyPaidUGX - data.amountUGX && data.remainingUGX >= 0
          && before.tenantId == data.tenantId && before.grnId == data.grnId && before.paymentType == 'cash'
          && invoice.lastPaymentId == paymentId && invoice.paidAmountUGX == data.previouslyPaidUGX + data.amountUGX
          && grn.tenantId == data.tenantId && grn.invoice_id == data.invoiceId && grn.procurement_invoice_id == data.procurementInvoiceId && grn.lastPaymentId == paymentId
          && draft.tenantId == data.tenantId && draft.source == 'procurement_cash_grn'
          && draft.invoiceId == data.invoiceId && draft.grnId == data.grnId && draft.lastPaymentId == paymentId
          && legacy.tenantId == data.tenantId && legacy.grnId == data.grnId && legacy.lastPaymentId == paymentId;
      }
      allow get: if (canOperateBranchFinance() || canViewFinance()) && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if canViewFinance() && isTenantMember(resource.data.tenantId);
      allow create: if validSettlement(request.resource.data);
      allow update, delete: if false;
    }
    match /cashTransfers/{transferId} {
      function canonicalNonCashWelfareTransfer(data) {
        let sale = getAfter(/databases/$(database)/documents/sales/$(data.saleId)).data;
        return isPOSOperator() && isTenantMember(data.tenantId)
          && sale.tenantId == data.tenantId
          && transferId == 'pos_welfare_transfer_' + data.tenantId + '_' + data.saleId
          && data.fromPortfolio == 'welfare' && data.toPortfolio == 'banked'
          && data.amount == (sale.paymentMethod == 'staff_welfare' ? sale.get('welfareAmount', sale.get('totalAmount', sale.get('total', 0))) : 0)
          && data.status == (data.amount > 0 ? 'posted' : 'reversed');
      }
      // Existing POS welfare allocations are non-cash accounting records. They
      // never credit a registered bank account or bypass its funding guard.
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId);
      allow create, update: if canonicalNonCashWelfareTransfer(request.resource.data);
      allow create: if isFinance() && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.fromPortfolio != 'receivables' && request.resource.data.toPortfolio != 'receivables'
        && !request.resource.data.keys().hasAny(['receivableId','remainingReceivableUGX'])
        && (request.resource.data.fromPortfolio == 'banked' || request.resource.data.toPortfolio == 'banked')
        && request.resource.data.bankMovementId == 'transfer_' + transferId
        && getAfter(/databases/$(database)/documents/banking_records/$('transfer_' + transferId)).data.transferId == transferId
        && getAfter(/databases/$(database)/documents/banking_records/$('transfer_' + transferId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/banking_records/$('transfer_' + transferId)).data.accountDeltaUGX == (request.resource.data.toPortfolio == 'banked' ? request.resource.data.amount : -request.resource.data.amount)
        && (!(request.resource.data.fromPortfolio == 'petty_cash' || request.resource.data.toPortfolio == 'petty_cash')
          || (getAfter(/databases/$(database)/documents/petty_cash_ledger/$(request.resource.data.cashMovementId)).data.transferId == transferId
            && getAfter(/databases/$(database)/documents/petty_cash_ledger/$(request.resource.data.cashMovementId)).data.tenantId == request.resource.data.tenantId
            && getAfter(/databases/$(database)/documents/petty_cash_ledger/$(request.resource.data.cashMovementId)).data.accountDeltaUGX == (request.resource.data.toPortfolio == 'petty_cash' ? request.resource.data.amount : -request.resource.data.amount)));
      allow update, delete: if false;
    }

    function canViewProcurement() {
      return isProcurement()
        || isFinance()
        || hasAnyRole(['QA Head', 'QA Officer', 'Logistics Head', 'Pharmacist', 'pharmacist'])
        || isITPersonnel()
        || hasCustomModuleView('procurement');
    }

    function canViewMarketing() {
      return isMarketing()
        || hasAnyRole(['QA Head', 'Finance Head'])
        || isITPersonnel()
        || hasCustomModuleView('marketing');
    }

    function canViewGlobalRevisionLedger() {
      return isAuthenticated() && (
        isAdmin() ||
        isFinance() ||
        isIT() ||
        hasAnyRole(['QA Head', 'QA Manager'])
      );
    }

    function canViewBranchRevisionLedger(branchId) {
      return isAuthenticated()
        && isAssignedToBranch(branchId)
        && (
          isPOSOperator() ||
          isBranchManager() ||
          hasAnyRole(['QA Officer', 'QA Head', 'QA Manager']) ||
          hasCustomModuleView('sales')
        );
    }


    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (("legacyStaffId" in getUserData()) && getUserData().legacyStaffId == userId)
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /vehicles/{vehicleId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /trips/{tripId} {
      allow read: if isAuthenticated() && (isLogisticsHead() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /trip_legs/{legId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /fuel_logs/{logId} {
      allow read: if isAuthenticated() && (isLogisticsHead() || isFinance() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if isTenantMember(request.resource.data.tenantId) && (isLogisticsHead() || isOwner(request.resource.data.personnelId));
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /maintenance_logs/{logId} {
      allow read: if isAuthenticated() && (isLogisticsHead() || isFinance() || isTenantMember(resource.data.tenantId));
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /traffic_fine_logs/{logId} {
      allow read: if isAuthenticated() && (isLogisticsHead() || isHR() || isFinance() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if (isLogisticsHead() || isHR()) && isTenantMember(request.resource.data.tenantId);
      allow update: if (isLogisticsHead() || isHR()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if (isLogisticsHead() || isHR()) && isTenantMember(resource.data.tenantId);
    }

    match /hiring_applications/{applicationId} {
      function isSupervisorPracticalAssessmentUpdate() {
        return isPeopleSupervisor()
          && isTenantMember(resource.data.tenantId)
          && isTenantMember(request.resource.data.tenantId)
          && request.resource.data.tenantId == resource.data.tenantId
          && resource.data.status == 'practical_scheduled'
          && request.resource.data.status == 'practical_completed'
          && request.resource.data.practical_score is number
          && request.resource.data.practical_score >= 0
          && request.resource.data.practical_score <= 100
          && request.resource.data.practical_assessed_by_user_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'practical_score', 'status',
            'practical_assessed_by_user_id', 'practical_assessed_by_name', 'practical_assessed_by_role',
            'practical_assessed_at', 'practical_assessed_branch_id', 'updatedAt'
          ]);
      }

      function isSupervisorTraineeAssessmentUpdate() {
        return isPeopleSupervisor()
          && isTenantMember(resource.data.tenantId)
          && isTenantMember(request.resource.data.tenantId)
          && request.resource.data.tenantId == resource.data.tenantId
          && resource.data.status == 'training_accepted'
          && request.resource.data.status == 'training_accepted'
          && request.resource.data.training_assessment_last_by_user_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'week4_appraisal_score', 'week4_theory_score', 'week4_assessment_date',
            'week4_assessed_by_user_id', 'week4_assessed_by_name', 'week4_assessed_by_role', 'week4_assessed_at',
            'week8_appraisal_score', 'week8_theory_score', 'week8_assessment_date',
            'week8_assessed_by_user_id', 'week8_assessed_by_name', 'week8_assessed_by_role', 'week8_assessed_at',
            'week12_appraisal_score', 'week12_theory_score', 'week12_assessment_date',
            'week12_assessed_by_user_id', 'week12_assessed_by_name', 'week12_assessed_by_role', 'week12_assessed_at',
            'training_assessment_last_by_user_id', 'training_assessment_last_by_name',
            'training_assessment_last_by_role', 'training_assessment_last_at', 'updatedAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'week4_appraisal_score', 'week4_theory_score',
            'week8_appraisal_score', 'week8_theory_score',
            'week12_appraisal_score', 'week12_theory_score'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week4_appraisal_score']) || (request.resource.data.week4_appraisal_score is number && request.resource.data.week4_appraisal_score >= 0 && request.resource.data.week4_appraisal_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week4_theory_score']) || (request.resource.data.week4_theory_score is number && request.resource.data.week4_theory_score >= 0 && request.resource.data.week4_theory_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week8_appraisal_score']) || (request.resource.data.week8_appraisal_score is number && request.resource.data.week8_appraisal_score >= 0 && request.resource.data.week8_appraisal_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week8_theory_score']) || (request.resource.data.week8_theory_score is number && request.resource.data.week8_theory_score >= 0 && request.resource.data.week8_theory_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week12_appraisal_score']) || (request.resource.data.week12_appraisal_score is number && request.resource.data.week12_appraisal_score >= 0 && request.resource.data.week12_appraisal_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week12_theory_score']) || (request.resource.data.week12_theory_score is number && request.resource.data.week12_theory_score >= 0 && request.resource.data.week12_theory_score <= 100));
      }

      allow read: if isTenantMember(resource.data.tenantId) && (
        isHR() ||
        (isPeopleSupervisor() && resource.data.status in ['practical_scheduled', 'practical_completed', 'training_accepted'])
      );
      allow create, delete: if isHR();
      allow update: if isHR() || isSupervisorPracticalAssessmentUpdate() || isSupervisorTraineeAssessmentUpdate();
    }

    match /theory_tests/{testId} {
      allow read, write: if isHR();
    }

    match /oral_interviews/{interviewId} {
      allow read, write: if isHR();
    }

    match /practical_assessments/{assessmentId} {
      allow read: if isHR() || (isPeopleSupervisor() && isTenantMember(resource.data.tenantId));
      allow create: if isHR() || (isPeopleSupervisor() && isTenantMember(request.resource.data.tenantId) && request.resource.data.supervisorId == request.auth.uid);
      allow update: if isHR() || (isPeopleSupervisor() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && resource.data.supervisorId == request.auth.uid && request.resource.data.supervisorId == request.auth.uid);
      allow delete: if isHR();
    }

    match /attendance_records/{recordId} {
      allow read: if isAuthenticated() && (isHR() || isBranchManager() || isOwner(resource.data.staffId) || isTenantMember(resource.data.tenantId));
      allow write: if isHR() || isBranchManager();
    }

    match /disciplinary_incidents/{incidentId} {
      allow read: if isTenantMember(resource.data.tenantId) && (
        isHR() || isOwner(resource.data.staffId) || resource.data.reportedByUserId == request.auth.uid
      );
      allow create: if isTenantMember(request.resource.data.tenantId) && (
        isHR() ||
        ((isPeopleSupervisor() || isQA())
          && request.resource.data.reportedByUserId == request.auth.uid
          && request.resource.data.status == 'open')
      );
      allow update: if isHR();
      allow delete: if isAdmin();
    }

    // Sequenced, human-readable identity counters. Never reuse or decrease a code.
    // Platform tenant numbering and tenant-scoped branch numbering remain separate.
    match /identity_sequence_counters/{counterId} {
      function validIncrement() {
        return request.resource.data.lastSequence is int
          && request.resource.data.lastSequence > 0
          && request.resource.data.updatedAt is string;
      }
      function platformCounter() {
        return counterId == 'platform_tenants'
          && request.resource.data.scope == 'platform'
          && request.resource.data.kind == 'tenants'
          && isAdmin();
      }
      function branchCounter() {
        return request.resource.data.kind == 'branches'
          && request.resource.data.tenantId is string
          && counterId == request.resource.data.tenantId + '_branches'
          && isCEO()
          && isTenantMember(request.resource.data.tenantId);
      }
      function scopedCounter() {
        return request.resource.data.kind in ['patients', 'prescribers', 'institutions', 'products', 'staff', 'operational_assets', 'operational_consumables']
          && request.resource.data.tenantId is string
          && counterId == request.resource.data.tenantId + '_' + request.resource.data.kind
          && isTenantMember(request.resource.data.tenantId)
          && (request.resource.data.kind == 'staff'
            ? (isHR() || isIT())
            : request.resource.data.kind in ['products', 'operational_assets', 'operational_consumables']
              ? isInventoryOperator()
              : isAuthenticated());
      }
      allow get: if isAuthenticated() && (resource == null
        || (resource.data.get('scope', '') == 'platform' && isAdmin())
        || (resource.data.get('tenantId', '') is string
          && isTenantMember(resource.data.tenantId)));
      allow list: if false;
      allow create: if validIncrement() && request.resource.data.lastSequence == 1
        && (platformCounter() || branchCounter() || scopedCounter());
      allow update: if validIncrement()
        && request.resource.data.lastSequence == resource.data.lastSequence + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSequence', 'updatedAt'])
        && (platformCounter() || branchCounter() || scopedCounter());
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if true; // Allow public read for tenant detection
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (!('tenant_code' in resource.data)
          || request.resource.data.tenant_code == resource.data.tenant_code);
      allow delete: if isAdmin();

      match /usernameRegistry/{handle} {
        allow read, write: if isAuthenticated() && (isAdmin() || isIT()) && isTenantMember(tenantId);
      }
    }

    match /branches/{branchId} {
      function hasValidBranchShape() {
        return request.resource.data.keys().hasAll([
          'tenantId', 'name', 'branch_code', 'type', 'address', 'phone',
          'status', 'created_at', 'created_by'
        ])
        && request.resource.data.tenantId is string
        && request.resource.data.name is string
        && request.resource.data.branch_code is string
        && request.resource.data.status in ['Active', 'Inactive', 'Closed'];
      }

      // Checkout and quotation validation point-read missing branch IDs before
      // reporting an invalid branch. Never expose existing cross-tenant records.
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if isCEO() && isTenantMember(request.resource.data.tenantId) && hasValidBranchShape();
      allow update: if isSettingsAdmin() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branch_code == resource.data.branch_code
        && (request.resource.data.get('cardSettlement', null) == resource.data.get('cardSettlement', null) || isCEO());
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    // A staff number is permanently reserved to its original staff document.
    function validStaffIdentity(staffId, data) {
      let code = data.get('staff_code', '');
      let claim = /databases/$(database)/documents/staff_identity_claims/$(data.tenantId + '_' + code);
      return code == '' || (code is string && existsAfter(claim)
        && getAfter(claim).data.tenantId == data.tenantId
        && (getAfter(claim).data.staffId == staffId
          || (data.get('legacyStaffId', '') == getAfter(claim).data.staffId
            && data.get('uid', '') == staffId
            && getAfter(/databases/$(database)/documents/staff/$(data.legacyStaffId)).data.get('canonical_staff_id', '') == staffId)));
    }
    match /staff_identity_claims/{claimId} {
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && (isHR() || isIT());
      allow create: if isAuthenticated() && (isHR() || isIT())
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.keys().hasOnly(['tenantId', 'staffId', 'code', 'createdAt'])
        && request.resource.data.code is string && request.resource.data.code.size() > 0
        && claimId == request.resource.data.tenantId + '_' + request.resource.data.code
        && getAfter(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.staff_code == request.resource.data.code
        && getAfter(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.tenantId == request.resource.data.tenantId;
      allow update, delete: if false;
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == staffId ||
        resource.data.email == request.auth.token.email ||
        resource.data.authEmail == request.auth.token.email ||
        isTenantMember(resource.data.tenantId)
      );
      allow create: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(request.resource.data.tenantId) && validStaffIdentity(staffId, request.resource.data);
      // HR assigns organisational roles and branch placement. IT may perform account
      // activation/support updates but cannot silently change the HR-assigned role realm.
      allow update: if atomicWelfareBalance(staffId);
      function canUpdateStaff() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return isAuthenticated()
        && !resource.data.get('is_duplicate', false)
        && !changed.hasAny(['duplicate_of', 'is_duplicate', 'identity_alias_ids'])
        && isTenantMember(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId
        && (resource.data.get('canonical_staff_id', '') == ''
          || request.resource.data.get('canonical_staff_id', '') == resource.data.canonical_staff_id)
        && (!changed.hasAny(['canonical_staff_id']) || isIT())
        && (request.resource.data.get('staff_code', '') == resource.data.get('staff_code', '')
          || (resource.data.get('staff_code', '') in ['', null] && validStaffIdentity(staffId, request.resource.data)))
        && (!('employee_id' in resource.data) || request.resource.data.employee_id == resource.data.employee_id)
        && (
        isAdmin() || isHR() ||
        (isITPersonnel() &&
          !changed.hasAny([
            'tenantId', 'role', 'secondaryRoles', 'roleRealmId',
            'assigned_branches', 'branch_id', 'default_branch_id'
          ])) ||
        (request.auth.uid == staffId &&
          !changed.hasAny([
            'tenantId', 'role', 'secondaryRoles', 'assigned_branches',
            'branch_id', 'default_branch_id', 'status', 'active',
            'authEmail', 'loginHandle', 'username', 'uid', 'password_set',
            'legacyStaffId', 'roleRealmId'
          ]))
      );
      }
      allow update: if canUpdateStaff();
      allow delete: if (isAdmin() || isIT()) && isTenantMember(resource.data.tenantId)
        && resource.data.get('staff_code', '') == '' && !resource.data.get('is_duplicate', false);
    }

    match /leave_requests/{requestId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || isHR() || isFinance());
      allow create: if isOwner(request.resource.data.staffId) && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.status == 'Pending' && request.resource.data.get('hr_approval_status','Pending') == 'Pending'
        && request.resource.data.get('ceo_approval_status','Pending') == 'Pending';
      allow update: if isTenantMember(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.staffId == resource.data.staffId
        && (isHR() || (isOwner(resource.data.staffId) && resource.data.status.lower() == 'pending'
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('hr_approval_status','Pending') == resource.data.get('hr_approval_status','Pending')
          && request.resource.data.get('ceo_approval_status','Pending') == resource.data.get('ceo_approval_status','Pending')));
      allow delete: if isTenantMember(resource.data.tenantId) && (isAdmin() || isHR());
    }

    match /advance_requests/{requestId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || isHR() || isFinance());
      allow create: if isOwner(request.resource.data.staffId) && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.status == 'Pending';
      allow update: if isTenantMember(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.staffId == resource.data.staffId && (isHR() || isFinance());
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    function canVerifyAttendance(data) {
      return isTenantMember(data.tenantId) && hasActiveStaffProfile()
        && (isHR() || (isBranchManager() && isAssignedToBranch(data.branch_id)));
    }
    match /attendance/{attendanceId} {
      function validAttendance(data) {
        let employee = get(/databases/$(database)/documents/staff/$(data.staffId)).data;
        return data.tenantId == employee.tenantId && data.branch_id == (employee.get('branch_id','') == '' ? 'HQ' : employee.branch_id)
          && data.status in ['present','absent','on-leave'] && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.hours_worked is number && data.hours_worked >= 0 && data.hours_worked <= 24;
      }
      function canLog(data) {
        return isTenantMember(data.tenantId) && hasActiveStaffProfile()
          && (isHR() || ((isBranchManager() || hasRole('Cashier')) && isAssignedToBranch(data.branch_id)));
      }
      allow read: if isTenantMember(resource.data.tenantId)
        && (isHR() || canViewFinance() || isAssignedToBranch(resource.data.branch_id));
      allow create: if canLog(request.resource.data) && validAttendance(request.resource.data)
        && request.resource.data.verificationStatus == 'unverified' && request.resource.data.verifiedBy == null;
      allow update: if request.resource.data.tenantId == resource.data.tenantId && request.resource.data.staffId == resource.data.staffId
        && validAttendance(request.resource.data)
        && (request.resource.data.verificationStatus == 'approved' ? canVerifyAttendance(resource.data)
          && request.resource.data.verifiedBy == request.auth.uid && request.resource.data.verifiedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus','verifiedBy','verifiedAt'])
          : canLog(resource.data) && request.resource.data.verificationStatus == 'unverified'
            && request.resource.data.verifiedBy == null && request.resource.data.verifiedAt == null);
      allow delete: if canVerifyAttendance(resource.data);
    }

    // Level 11 payroll: staged employee accumulator, immutable revisions, approval and funded settlement.
    function payrollBatchPath(id) {
      return /databases/$(database)/documents/finance_payroll_batches_v1/$(id);
    }
    function payrollEventPath(id, revision, action) {
      return /databases/$(database)/documents/finance_payroll_events_v1/$(id + '_r' + string(revision) + '_' + action);
    }
    function payrollSnapshotPath(data) {
      return /databases/$(database)/documents/finance_payroll_lines_v1/$(data.batchId + '_r' + string(data.revision) + '__' + data.staffId);
    }
    function payrollActor(tenantId, hr) {
      let staff = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
      let central = hr ? ['HR Head','HR Manager','HR Support Personnel','admin','Admin','owner','Owner','CEO','ceo','CEO / MD']
        : ['Finance Head','Accountant','admin','Admin','owner','Owner','CEO','ceo','CEO / MD'];
      return isAuthenticated() && staff.tenantId == tenantId && !staff.get('is_duplicate',false) && staff.get('active',true)
        && staff.get('status','active').lower() == 'active'
        && (hr ? isHR() : isFinance())
        && (hasAnyRole(central) || (staff.get('assigned_branches',[]).size() == 0
          && staff.get('branch_id','') == '' && staff.get('default_branch_id','') == ''));
    }
    function viewPayroll(tenantId) {
      return isTenantMember(tenantId) && (isHR() || canViewFinance());
    }
    function payrollInt(n) { return n is int && n >= 0 && n <= 9007199254740991; }
    function validPayrollComponents(l) {
      return l.reviewed == true && l.staffId is string && l.staffId.size() > 0 && l.staffName is string
        && l.loggedHours is number && l.loggedHours >= 0 && l.paidLeaveHours is number && l.paidLeaveHours >= 0
        && payrollInt(l.baseSalary) && payrollInt(l.bonuses) && payrollInt(l.advanceDeduction)
        && payrollInt(l.fineDeduction) && payrollInt(l.nssfEmployee) && payrollInt(l.nssfEmployer)
        && payrollInt(l.paye) && payrollInt(l.customDeduction) && payrollInt(l.netSalary)
        && l.deductions == l.advanceDeduction + l.fineDeduction + l.nssfEmployee + l.paye + l.customDeduction
        && l.netSalary == l.baseSalary + l.bonuses - l.deductions
        && (l.bonuses == 0 || (l.bonusNotes is string && l.bonusNotes.size() > 0));
    }
    function payrollTotalsStep(before, after, line) {
      return payrollInt(after.net) && payrollInt(after.gross) && payrollInt(after.employerNssf) && payrollInt(after.employeeNssf) && payrollInt(after.paye) && payrollInt(after.otherDeductions) && after.net == before.net + line.netSalary && after.gross == before.gross + line.baseSalary + line.bonuses
        && after.employerNssf == before.employerNssf + line.nssfEmployer
        && after.employeeNssf == before.employeeNssf + line.nssfEmployee && after.paye == before.paye + line.paye
        && after.otherDeductions == before.otherDeductions + line.advanceDeduction + line.fineDeduction + line.customDeduction;
    }
    function payrollDay(value) {
      let p = value.split('-');
      return int(timestamp.date(int(p[0]),int(p[1]),int(p[2])).toMillis() / 86400000);
    }
    function payrollDayPath(staffId, day) {
      return /databases/$(database)/documents/finance_payroll_days_v1/$(staffId + '_' + string(day));
    }
    match /finance_payroll_days_v1/{dayId} {
      allow read: if isAuthenticated() && (resource == null ? isHR() : viewPayroll(resource.data.tenantId));
      allow create: if validDay(request.resource.data);
      function validDay(d) {
        let b = get(payrollBatchPath(d.batchId)).data;
        return payrollActor(b.tenantId,true) && d.tenantId == b.tenantId
          && dayId == d.staffId + '_' + string(d.day) && d.day is int
          && d.day >= payrollDay(b.periodStart) && d.day <= payrollDay(b.periodEnd)
          && (d.day == payrollDay(b.periodStart) || getAfter(payrollDayPath(d.staffId,d.day - 1)).data.batchId == b.id)
          && get(/databases/$(database)/documents/staff/$(d.staffId)).data.tenantId == b.tenantId
          && d.keys().hasOnly(['tenantId','staffId','batchId','day']);
      }
    }
    function validPayrollSnapshot(data) {
      let before = get(payrollBatchPath(data.batchId)).data;
      let after = getAfter(payrollBatchPath(data.batchId)).data;
      let staff = get(/databases/$(database)/documents/staff/$(data.staffId)).data;
      let allocation = staff.get('branch_id','') == '' ? 'HQ' : staff.branch_id;
      return before.tenantId == data.tenantId && before.status == 'draft'
        && after.status == 'draft' && before.revision == data.revision && after.revision == data.revision
        && data.index == before.nextIndex && after.nextIndex == before.nextIndex + 1
        && after.lastStaffId == data.staffId && data.staffId == data.line.staffId
        && staff.tenantId == data.tenantId && !staff.get('is_duplicate', false)
        && data.branch_id == allocation && data.line.branchId == data.branch_id
        && data.periodStart == before.periodStart && data.periodEnd == before.periodEnd && data.month == before.month
        && data.payrollVersion == 11 && data.payrollReference == before.reference
        && (before.get('coverageVersion',0) == 0 || get(payrollDayPath(data.staffId,payrollDay(before.periodEnd))).data.batchId == before.id)
        && validPayrollComponents(data.line) && payrollTotalsStep(before.totals,after.totals,data.line)
        && data.paidUGX == 0 && data.status == 'pending_finance'
        && data.keys().hasOnly(['tenantId','payrollVersion','batchId','payrollReference','revision','index','staffId',
          'branch_id','periodStart','periodEnd','month','line','paidUGX','status','stagedAt']);
    }
    function payrollMirrorStaging(id, data) {
      let path = payrollSnapshotPath(data);
      let snapshot = getAfter(path).data;
      return id == data.batchId + '__' + data.staffId && !exists(path)
        && data.diff(snapshot).affectedKeys().hasOnly(['stagedAt'])
        && snapshot.stagedAt == request.time;
    }
    function payrollEvent(data, action) {
      let path = payrollEventPath(data.id,data.revision,action);
      let event = getAfter(path).data;
      return !exists(path) && event.tenantId == data.tenantId && event.batchId == data.id && event.revision == data.revision
        && event.actorId == request.auth.uid && event.action == action && event.recordedAt == request.time
        && event.totals == data.totals;
    }
    function payrollDraftLink(data) {
      let batch = getAfter(payrollBatchPath(data.batchId)).data;
      return data.payrollVersion == 11 && data.batchId == batch.id && data.tenantId == batch.tenantId
        && data.revision == batch.revision && data.amount == batch.totals.net && data.amount_ugx == data.amount
        && data.source == 'hr_salary' && data.sourceType == 'hr' && data.department == 'HR'
        && data.payrollReference == batch.reference && data.employeeCount == batch.employeeCount && data.excludeFromOpexRollup
        && !data.keys().hasAny(['cashOutflowPostingId','paid_date','payment_method','lastPaymentId']);
    }
    function validPayrollDraft(id, data) {
      let before = get(payrollBatchPath(id)).data;
      let after = getAfter(payrollBatchPath(id)).data;
      return id == data.batchId && payrollDraftLink(data)
        && (before.status == 'draft' && after.status == 'pending_finance' && data.status == 'pending'

          || before.status == 'pending_finance' && after.status in ['approved','returned']
            && data.status == (after.status == 'approved' ? 'approved' : 'rejected')
            && data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }
    function payrollPaymentPath(id) {return /databases/$(database)/documents/finance_payroll_payments_v1/$(id);}
    function payrollPaidUpdate(before, after) {
      let path = payrollPaymentPath(after.lastPaymentId);
      let payment = getAfter(path).data;
      return !exists(path) && payment.recordedAt == request.time && payment.actorId == request.auth.uid
        && payment.tenantId == before.tenantId && payment.batchId == before.batchId && payment.staffId == before.staffId
        && payment.revision == before.revision && after.paidUGX == before.paidUGX + payment.amountUGX
        && after.status == (after.paidUGX == before.line.netSalary ? 'paid' : 'partial')
        && (after.status != 'paid' || after.paid_date == payment.date)
        && after.diff(before).affectedKeys().hasOnly(['paidUGX','status','paid_date','lastPaymentId']);
    }
    function isPayrollMovement(id, data) {
      return id.matches('^salary_payment_.*') || data.keys().hasAny(['payrollPaymentId'])
        || data.get('source','') == 'Payroll salary settlement';
    }
    function validPayrollMovement(id, data, before, after) {
      let path = payrollPaymentPath(data.payrollPaymentId);
      let p = getAfter(path).data;
      return !exists(path) && p.recordedAt == request.time && id == p.movementId && data.source == 'Payroll salary settlement'
        && data.excludeFromOpexRollup && data.type == 'outgoing' && data.amount == p.amountUGX
        && data.tenantId == p.tenantId && data.portfolioId == p.accountId && data.accountDocumentId == p.accountDocumentId
        && data.postedBy == p.actorId && data.reference_number == p.reference && data.staffId == p.staffId
        && data.batchId == p.batchId && data.branchId == p.branchId && data.createdAt == request.time && data.updatedAt == request.time
        && before.tenantId == p.tenantId && after.lastPostingId == id && after.balanceUGX == before.balanceUGX - p.amountUGX;
    }
    function payrollStatusMirror(data) {
      let status = getAfter(/databases/$(database)/documents/finance_payroll_status_v1/$(data.id)).data;
      return status.tenantId == data.tenantId && status.batchId == data.id && status.revision == data.revision && status.status == data.status;
    }
    match /finance_payroll_status_v1/{batchId} {
      allow get: if resource != null && isTenantMember(resource.data.tenantId)
        && (viewPayroll(resource.data.tenantId) || exists(/databases/$(database)/documents/payslips/$(batchId + '__' + request.auth.uid)));
      allow create, update: if request.resource.data.batchId == batchId
        && request.resource.data.keys().hasOnly(['tenantId','batchId','revision','status'])
        && getAfter(payrollBatchPath(batchId)).data.updatedAt == request.time
        && payrollStatusMirror(getAfter(payrollBatchPath(batchId)).data);
    }
    function validLegacyPayrollRecovery(b) {
      let e = get(/databases/$(database)/documents/management_expenses/$(b.legacySourceId)).data;
      return e.tenantId == b.tenantId && e.get('payrollVersion',0) != 11
        && e.source == 'hr_salary' && e.status.lower() == 'rejected'
        && e.get('paidAmountUGX',0) == 0 && e.get('cashOutflowPostingId','') == ''
        && !exists(/databases/$(database)/documents/finance_payroll_recovery_v1/$(b.legacySourceId))
        && getAfter(/databases/$(database)/documents/finance_payroll_recovery_v1/$(b.legacySourceId)).data.batchId == b.id;
    }
    match /finance_payroll_recovery_v1/{sourceId} {
      allow read: if isAuthenticated() && (resource == null ? isHR() : viewPayroll(resource.data.tenantId));
      allow create: if payrollActor(request.resource.data.tenantId,true)
        && getAfter(payrollBatchPath(request.resource.data.batchId)).data.legacySourceId == sourceId
        && getAfter(payrollBatchPath(request.resource.data.batchId)).data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['tenantId','batchId']);
    }
    match /finance_payroll_batches_v1/{batchId} {
      function validStart(data) {
        return payrollActor(data.tenantId,true) && payrollStatusMirror(data) && data.id == batchId
          && batchId == data.tenantId + '_PAY_' + data.periodStart + '_' + data.periodEnd
          && data.periodStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.periodEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.periodStart <= data.periodEnd && data.periodEnd.matches('^' + data.month + '-[0-9]{2}$')
          && (data.get('legacySourceId','') == '' || validLegacyPayrollRecovery(data))
          && data.coverageVersion == 1 && data.status == 'draft' && data.revision == 1 && data.nextIndex == 0 && data.employeeCount is int && data.employeeCount > 0
          && data.totals == {'net':0,'gross':0,'employerNssf':0,'employeeNssf':0,'paye':0,'otherDeductions':0}
          && data.paidUGX == 0 && data.submittedBy == request.auth.uid && data.planHash is string && data.planHash.size() == 64
          && data.createdAt == request.time && data.updatedAt == request.time
          && data.keys().hasOnly(['id','tenantId','reference','periodStart','periodEnd','month','revision','status','employeeCount',
            'nextIndex','totals','paidUGX','submittedBy','submittedByName','planHash','createdAt','updatedAt','coverageVersion','legacySourceId']);
      }
      function validTransition(before, after) {
        let changed = after.diff(before).affectedKeys();
        return payrollActor(before.tenantId,before.status in ['draft','returned']) && after.tenantId == before.tenantId && after.id == before.id && after.updatedAt == request.time
          && ((after.status == before.status && after.revision == before.revision) || payrollStatusMirror(after))
          && (before.status in ['returned','draft'] && after.status == 'draft' && after.revision == before.revision + 1
            && (before.status == 'returned' || payrollEvent(after,'restart'))
            && after.revision == before.revision + 1 && after.nextIndex == 0 && after.submittedBy == request.auth.uid
            && after.employeeCount is int && after.employeeCount > 0 && after.paidUGX == 0
            && (before.status == 'draft' || after.employeeCount == before.employeeCount)
            && after.totals == {'net':0,'gross':0,'employerNssf':0,'employeeNssf':0,'paye':0,'otherDeductions':0}
            && changed.hasOnly(['status','revision','nextIndex','totals','employeeCount','planHash','submittedBy','submittedByName','updatedAt'])
          || before.status == 'draft' && after.status == 'draft'
            && before.nextIndex < before.employeeCount && after.nextIndex == before.nextIndex + 1
            && changed.hasOnly(['nextIndex','totals','lastStaffId','updatedAt'])
            && getAfter(/databases/$(database)/documents/finance_payroll_lines_v1/$(batchId + '_r' + string(before.revision) + '__' + after.lastStaffId)).data.stagedAt == request.time
            && !exists(/databases/$(database)/documents/finance_payroll_lines_v1/$(batchId + '_r' + string(before.revision) + '__' + after.lastStaffId))
          || before.status == 'draft' && after.status == 'pending_finance'
            && before.nextIndex == before.employeeCount && after.submittedAt == request.time && payrollEvent(after,'submitted')
            && getAfter(/databases/$(database)/documents/management_expenses/$(batchId)).data.revision == after.revision
            && changed.hasOnly(['status','submittedAt','updatedAt'])
          || before.status == 'pending_finance' && after.status in ['approved','returned']
            && getAfter(/databases/$(database)/documents/management_expenses/$(batchId)).data.status == (after.status == 'approved' ? 'approved' : 'rejected')
            && (after.status == 'approved' ? after.approvedAt == request.time && after.approvedBy == request.auth.uid
              && payrollEvent(after,'approve') && changed.hasOnly(['status','approvedAt','approvedBy','updatedAt'])
              : after.returnReason is string && after.returnReason.size() >= 5 && after.returnedAt == request.time
                && after.returnedBy == request.auth.uid && payrollEvent(after,'return')
                && changed.hasOnly(['status','returnReason','returnedAt','returnedBy','updatedAt']))
          || before.status in ['approved','partial']
            && changed.hasOnly(['status','paidUGX','lastPaymentId','updatedAt'])
            && freshPayrollBatchPayment(before,after));
      }
      allow get: if isAuthenticated() && (resource == null ? (isHR() || canViewFinance()) : viewPayroll(resource.data.tenantId));
      allow list: if viewPayroll(resource.data.tenantId);
      allow create: if validStart(request.resource.data);
      allow update: if validTransition(resource.data,request.resource.data);
    }
    function freshPayrollBatchPayment(before,after) {
      let path = payrollPaymentPath(after.lastPaymentId);
      let payment = getAfter(path).data;
      return !exists(path) && payment.recordedAt == request.time && payment.batchId == before.id && payment.tenantId == before.tenantId
        && after.paidUGX == before.paidUGX + payment.amountUGX && after.paidUGX <= before.totals.net
        && after.status == (after.paidUGX == before.totals.net ? 'paid' : 'partial');
    }
    match /finance_payroll_lines_v1/{lineId} {
      allow read: if viewPayroll(resource.data.tenantId);
      allow create: if lineId == request.resource.data.batchId + '_r' + string(request.resource.data.revision) + '__' + request.resource.data.staffId
        && request.resource.data.stagedAt == request.time && validPayrollSnapshot(request.resource.data)
        && getAfter(/databases/$(database)/documents/payroll/$(request.resource.data.batchId + '__' + request.resource.data.staffId)).data.line == request.resource.data.line
        && getAfter(/databases/$(database)/documents/payslips/$(request.resource.data.batchId + '__' + request.resource.data.staffId)).data.line == request.resource.data.line;
    }
    match /payroll/{employeeId} {
      allow read: if viewPayroll(resource.data.tenantId);
      allow create: if payrollMirrorStaging(employeeId,request.resource.data);
      allow update: if resource.data.get('payrollVersion',0) == 11
        && (payrollMirrorStaging(employeeId,request.resource.data) || payrollPaidUpdate(resource.data,request.resource.data));
    }
    match /finance_payroll_events_v1/{eventId} {
      allow read: if viewPayroll(resource.data.tenantId);
      allow get: if (isHR() || canViewFinance()) && resource == null;
      allow create: if eventId == request.resource.data.batchId + '_r' + string(request.resource.data.revision) + '_' + request.resource.data.action
        && request.resource.data.actorId == request.auth.uid && request.resource.data.recordedAt == request.time
        && validPayrollEvent(request.resource.data);
    }
    function validPayrollEvent(data) {
      let before = get(payrollBatchPath(data.batchId)).data;
      let after = getAfter(payrollBatchPath(data.batchId)).data;
      return before.tenantId == data.tenantId && data.revision == after.revision && data.totals == after.totals
        && (data.action == 'restart' ? before.status == 'draft' && after.status == 'draft' && after.revision == before.revision + 1
          && data.previousPlanHash == before.planHash && data.previousStagedEmployees == before.nextIndex
          : data.action == 'submitted' ? before.status == 'draft' && after.status == 'pending_finance'
          : before.status == 'pending_finance'
            && (data.action == 'approve' && after.status == 'approved'
              || data.action == 'return' && after.status == 'returned' && data.reason == after.returnReason));
    }
    match /finance_payroll_payment_requests_v1/{requestId} {
      allow get: if (isHR() || canViewFinance()) && (resource == null || isTenantMember(resource.data.tenantId));
      allow create: if isAuthenticated()
        && getAfter(payrollPaymentPath(request.resource.data.paymentId)).data.tenantId == request.resource.data.tenantId
        && requestId == request.resource.data.requestId && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recordedAt == request.time
        && !exists(payrollPaymentPath(request.resource.data.paymentId))
        && getAfter(payrollPaymentPath(request.resource.data.paymentId)).data.requestId == requestId;
    }
    match /finance_payroll_payments_v1/{paymentId} {
      function validPayment(p) {
        let batch = get(payrollBatchPath(p.batchId)).data;
        let nextBatch = getAfter(payrollBatchPath(p.batchId)).data;
        let rowPath = /databases/$(database)/documents/payroll/$(p.batchId + '__' + p.staffId);
        let row = get(rowPath).data;
        let accountPath = /databases/$(database)/documents/finance_payment_accounts/$(p.accountDocumentId);
        let account = get(accountPath).data;
        let move = managementMovementPath(p.accountKind,p.movementId);
        let claim = /databases/$(database)/documents/finance_payroll_payment_requests_v1/$(p.requestId);
        let day = p.date.split('-');
        let start = timestamp.date(int(day[0]),int(day[1]),int(day[2])) - duration.value(3,'h');
        return payrollActor(p.tenantId,false) && p.actorId == request.auth.uid && p.recordedAt == request.time
          && request.time >= start && request.time < start + duration.value(1,'d')
          && paymentId == 'salary_' + p.tenantId + '__' + p.accountId + '__' + p.reference.upper().replace('[^A-Z0-9_-]','_')
          && !exists(claim) && getAfter(claim).data.paymentId == paymentId
          && paymentId == p.paymentId && p.requestId.matches('^[A-Za-z0-9_-]{20,100}$')
          && p.amountUGX is int && p.amountUGX > 0 && p.reference is string && p.reference.size() >= 3 && p.reference.size() <= 120
          && batch.tenantId == p.tenantId && batch.revision == p.revision && batch.status in ['approved','partial']
          && row.tenantId == p.tenantId && row.batchId == p.batchId && row.revision == p.revision && row.staffId == p.staffId
          && row.branch_id == p.branchId && row.paidUGX == p.paidBeforeUGX && p.paidAfterUGX == row.paidUGX + p.amountUGX
          && p.paidAfterUGX <= row.line.netSalary && p.outstandingUGX == row.line.netSalary - p.paidAfterUGX
          && batch.paidUGX == p.batchPaidBeforeUGX && p.batchPaidAfterUGX == batch.paidUGX + p.amountUGX
          && nextBatch.paidUGX == p.batchPaidAfterUGX && nextBatch.lastPaymentId == paymentId
          && getAfter(rowPath).data.lastPaymentId == paymentId
          && getAfter(/databases/$(database)/documents/payslips/$(p.batchId + '__' + p.staffId)).data.lastPaymentId == paymentId
          && account.tenantId == p.tenantId && account.accountId == p.accountId && account.name == p.accountName && account.kind == p.accountKind
          && p.accountDocumentId == p.tenantId + '_' + p.accountId && eligibleSupplierAccount(account,account.get('scope',{}).get('branchId',''))
          && (account.get('scope',{}).get('kind','organisation') != 'branch' || account.scope.branchId == p.branchId)
          && account.balanceUGX >= p.amountUGX && getAfter(accountPath).data.balanceUGX == account.balanceUGX - p.amountUGX
          && getAfter(accountPath).data.lastPostingId == p.movementId && p.movementId == 'salary_payment_' + paymentId
          && !exists(move) && getAfter(move).data.payrollPaymentId == paymentId;
      }
      allow get: if (isHR() || canViewFinance()) && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if viewPayroll(resource.data.tenantId);
      allow create: if validPayment(request.resource.data);
    }

    match /payslips/{payslipId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || isHR() || canViewFinance());
      allow create: if payrollMirrorStaging(payslipId,request.resource.data);
      allow update: if resource.data.get('payrollVersion',0) == 11
        && (payrollMirrorStaging(payslipId,request.resource.data) || payrollPaidUpdate(resource.data,request.resource.data));
    }

    match /cme_records/{recordId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffId) || isHR() || isTenantMember(resource.data.tenantId));
      allow write: if isHR();
    }

    match /appraisal_scores/{scoreId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffId) || isHR() || isTenantMember(resource.data.tenantId));
      allow write: if isHR();
    }

    match /system_settings/{settingsId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isSettingsAdmin() && isTenantMember(request.resource.data.tenantId);
    }

    match /master_registries/{registryId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isSettingsAdmin() && isTenantMember(request.resource.data.tenantId);
    }

    match /role_realms_of_operation/{realmId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isITPersonnel() && isTenantMember(request.resource.data.tenantId);
      allow update: if isITPersonnel() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isITPersonnel() && isTenantMember(resource.data.tenantId);
    }

    match /hr_roles/{roleId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isITPersonnel() && isTenantMember(request.resource.data.tenantId);
      allow update: if isITPersonnel() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isITPersonnel() && isTenantMember(resource.data.tenantId);
    }

    match /global_audit_logs/{logId} {
      allow read: if (isAdmin() || isIT() || hasRole('QA Head')) && isTenantMember(resource.data.tenantId);
      allow create: if isTenantMember(request.resource.data.tenantId);
      allow update, delete: if false; // Immutable
    }
    match /platform_users/{userId} {
      allow read, write: if isAdmin();
    }

    match /platform_revenue/{revenueId} {
      allow read, write: if isAdmin();
    }

    match /platform_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /predictive_settings/{settingId} {
      allow read, write: if isAdmin();
    }
    match /pending_activations/{activationId} {
      allow read: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(request.resource.data.tenantId);
      allow update, delete: if isAuthenticated() && (isAdmin() || isIT()) && isTenantMember(resource.data.tenantId);
    }

    match /finance_ledger/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance() && isTenantMember(request.resource.data.tenantId);
    }

    // Immutable handoff from finalized Operational GRNs to the future Finance V2 consumer.
    match /operational_finance_events/{eventId} {
      function sourceGrnPath() {
        return /databases/$(database)/documents/grn_records/$(request.resource.data.sourceId);
      }
      allow get: if isAuthenticated() && (isProcurement() || canViewFinance()) && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow create: if isProcurement()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.eventKind in ['OPERATIONAL_CONSUMABLE_OPEX', 'FIXED_ASSET_ACQUISITION']
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && request.resource.data.eventKind == (request.resource.data.operationalType == 'FIXED_ASSET' ? 'FIXED_ASSET_ACQUISITION' : 'OPERATIONAL_CONSUMABLE_OPEX')
        && request.resource.data.status == 'READY_FOR_FINANCE'
        && request.resource.data.amountUGX is number
        && request.resource.data.amountUGX >= 0
        && request.resource.data.sourceType == 'OPERATIONAL_GRN'
        && request.resource.data.destinationStoreId == getAfter(sourceGrnPath()).data.destination_store_id
        && existsAfter(sourceGrnPath())
        && getAfter(sourceGrnPath()).data.tenantId == request.resource.data.tenantId
        && getAfter(sourceGrnPath()).data.inventoryClass == 'OPERATIONAL'
        && getAfter(sourceGrnPath()).data.financial_posting_status == 'event_created'
        && getAfter(sourceGrnPath()).data.total_value_ugx >= request.resource.data.amountUGX;
      allow update, delete: if false;
    }

    match /operational_inventory_migration_audit/{auditId} {
      allow read: if isTenantMember(resource.data.tenantId)
        && (isInventoryOperator() || isProcurement() || isITPersonnel() || isAdmin());
      allow create, update, delete: if false;
    }

    match /operational_inventory_identity_events/{eventId} {
      function linkedItemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.itemId);
      }
      function linkedMasterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
      }
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isInventoryOperator() || isProcurement() || isITPersonnel() || isAdmin());
      allow create: if isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.eventType in ['MASTER_CREATED', 'LOCATION_LINKED', 'LEGACY_ITEM_LINKED']
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.itemId is string
        && request.resource.data.masterItemId is string
        && eventId == 'opidentity_' + request.resource.data.itemId
        && existsAfter(linkedItemPath())
        && getAfter(linkedItemPath()).data.tenantId == request.resource.data.tenantId
        && getAfter(linkedItemPath()).data.branchId == request.resource.data.branchId
        && getAfter(linkedItemPath()).data.inventoryClass == 'OPERATIONAL'
        && getAfter(linkedItemPath()).data.masterItemId == request.resource.data.masterItemId
        && existsAfter(linkedMasterPath())
        && getAfter(linkedMasterPath()).data.tenantId == request.resource.data.tenantId
        && getAfter(linkedMasterPath()).data.inventoryClass == 'OPERATIONAL';
      allow update, delete: if false;
    }

    function operationalIdentityFingerprint(data) {
      return data.name.trim().lower().replace('\\s+', ' ') + '|'
        + data.get('category', '').trim().lower().replace('\\s+', ' ') + '|'
        + data.type + '|' + string(data.unitPerPack) + '|'
        + data.unitOfIssue.trim().lower().replace('\\s+', ' ');
    }
    function operationalIdentityClaimId(data) {
      return 'opidentity_' + (data.tenantId + '|' + operationalIdentityFingerprint(data)).toUtf8().toBase64()
        .replace('/', '_').replace('[+]', '-').replace('=', '');
    }
    function operationalIdentityReady(tenantId) {
      let state = /databases/$(database)/documents/operational_inventory_identity_state/$(tenantId);
      return exists(state) && get(state).data.tenantId == tenantId && get(state).data.status == 'READY';
    }
    match /operational_inventory_identity_state/{tenantId} {
      allow get: if isTenantMember(tenantId);
      allow list, write: if false;
    }

    // Tenant-wide identity claims serialize first registration and legacy
    // linking transactions that use different location document IDs.
    match /operational_inventory_identity_claims/{claimId} {
      function claimedMasterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
      }
      allow get: if isAuthenticated()
        && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isInventoryOperator() || isProcurement() || isITPersonnel() || isAdmin());
      allow create: if isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && operationalIdentityReady(request.resource.data.tenantId)
        && request.resource.data.identityFingerprint is string
        && request.resource.data.masterItemId is string
        && request.resource.data.actorId == request.auth.uid
        && existsAfter(claimedMasterPath())
        && getAfter(claimedMasterPath()).data.tenantId == request.resource.data.tenantId
        && getAfter(claimedMasterPath()).data.inventoryClass == 'OPERATIONAL'
        && claimId == operationalIdentityClaimId(getAfter(claimedMasterPath()).data)
        && request.resource.data.identityFingerprint == operationalIdentityFingerprint(getAfter(claimedMasterPath()).data);
      allow update, delete: if false;
    }

    // Deterministic procurement posting IDs require an existence check before
    // creation. A missing document exposes no tenant data; existing documents
    // remain tenant-scoped by the second clause and by the collection rules.
    match /grn_records/{recordId} {
      function hasOperationalSourceOrder(data) {
        return ('order_id' in data)
          && exists(/databases/$(database)/documents/stock_orders/$(data.order_id))
          && get(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.tenantId == data.tenantId
          && isOperationalOrderData(get(/databases/$(database)/documents/stock_orders/$(data.order_id)).data);
      }
      function validGrnInventoryClass(data) {
        return (('inventoryClass' in data)
            && data.inventoryClass == 'OPERATIONAL'
            && hasOperationalSourceOrder(data)
            && (!('deliveryRoute' in data) || getAfter(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.operational_delivery_route == data.deliveryRoute)
            && ((data.get('deliveryRoute', 'VIA_HQ') == 'VIA_HQ' && data.destination_store_id == 'HQ_OPERATIONAL')
              || (data.get('deliveryRoute', '') == 'DIRECT_BRANCH'
                && data.destination_store_id == 'SUPPLIER_TRANSIT'
                && data.destination_branch_id != 'HQ'
                && data.destination_branch_id == get(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.requesting_branch_id
                && getAfter(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.operational_delivery_route == 'DIRECT_BRANCH'))
            && data.grn_status == 'completed'
            && data.status == 'completed'
            && !('items' in data)
            && data.itemCount is number
            && data.itemCount > 0
            && data.itemCount <= 150
            && data.receivedBy == request.auth.uid
            && isOperationalInventoryEnabled(data.tenantId))
          || (('inventoryClass' in data)
            && data.inventoryClass == 'SELLABLE'
            && !hasOperationalSourceOrder(data))
          || (!('inventoryClass' in data)
            && !('operationalType' in data)
            && !hasOperationalSourceOrder(data));
      }
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated()
        && isTenantMember(request.resource.data.tenantId)
        && (!('inventoryClass' in request.resource.data)
          || request.resource.data.inventoryClass != 'OPERATIONAL'
          || isProcurement())
        && validGrnInventoryClass(request.resource.data);
      allow update: if isAuthenticated()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && !hasOperationalSourceOrder(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'payment_status','lastPaymentId','payment_type','invoice_id','procurement_invoice_id','credit_ledger_id'
        ])
        && (!('inventoryClass' in resource.data) || request.resource.data.inventoryClass == resource.data.inventoryClass)
        && (!('inventoryClass' in resource.data) || resource.data.inventoryClass != 'OPERATIONAL')
        && validGrnInventoryClass(request.resource.data);
      allow update: if resource.data.status == 'posting' && resource.data.inventoryClass == 'SELLABLE'
        && isProcurement() && isTenantMember(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.order_id == resource.data.order_id
        && request.resource.data.transfer_id == resource.data.transfer_id
        && request.resource.data.status == 'completed';
      allow update: if validSupplierGrnPayment(recordId, resource.data, request.resource.data);
      allow delete: if resource.data.inventoryClass != 'OPERATIONAL'
        && !hasOperationalSourceOrder(resource.data)
        && isAdmin() && isTenantMember(resource.data.tenantId);
    }
    match /invoices/{invoiceId} {
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && (canViewFinance() || isProcurement());
      allow create: if isTenantMember(request.resource.data.tenantId) && (isFinance() || isProcurement());
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId)
        && ((resource.data.get('paymentType','') == 'credit' || resource.data.get('creditBalance', 0) > 0 ||
            resource.data.get('lastPaymentId', '') != '' ||
            (resource.data.get('paymentType','') == 'cash' && resource.data.get('grnId','') != ''))
          ? validSupplierInvoiceUpdate(invoiceId, resource.data, request.resource.data, false)
          : (isFinance() || isProcurement()));
      allow delete: if false;
    }
    match /procurement_invoices/{invoiceId} {
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && (canViewFinance() || isProcurement());
      allow create: if isTenantMember(request.resource.data.tenantId) && (isFinance() || isProcurement());
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId)
        && ((resource.data.get('paymentType','') == 'credit' || resource.data.get('creditBalance', 0) > 0 ||
            resource.data.get('lastPaymentId', '') != '' ||
            (resource.data.get('paymentType','') == 'cash' && resource.data.get('grnId','') != ''))
          ? validSupplierInvoiceUpdate(invoiceId, resource.data, request.resource.data, true)
          : (isFinance() || isProcurement()));
      allow delete: if false;
    }
    match /creditLedger/{entryId} {
      function validCreditLiability(data) {
        let invoicePath = /databases/$(database)/documents/invoices/$(data.invoiceId);
        let invoice = getAfter(invoicePath).data;
        let expectedId = 'supplier_credit_' + data.grnId.replace('^grn_', '');
        return (isProcurement() || isFinance()) && isTenantMember(data.tenantId)
          && !exists(invoicePath) && invoice.tenantId == data.tenantId
          && data.originalCreditAmount == invoice.invoiceValue
          && data.remainingCreditBalance == data.originalCreditAmount && data.remainingCreditBalance > 0
          && data.status == 'outstanding' && invoice.paymentType == 'credit'
          && data.grnId == invoice.grnId && entryId == expectedId;
      }
      function validCreditLiabilitySettlement(before, after) {
        let path = supplierPaymentPath(after.lastPaymentId, true);
        let payment = getAfter(path).data;
        let draft = getAfter(/databases/$(database)/documents/management_expenses/$(payment.draftId)).data;
        let priorIds = before.get('paymentHistoryIds', []);
        let open = draft.status == 'partial';
        return freshSupplierLink(after, payment, path) && payment.creditLedgerId == entryId
          && after.diff(before).affectedKeys().hasOnly(['remainingCreditBalance','balance','status','paymentHistoryIds',
            'lastProcessedAt','updatedAt','lastPaymentReference','lastPaymentId','pendingDraftId'])
          && after.remainingCreditBalance == payment.balanceAfter && after.balance == payment.balanceAfter
          && after.status == (payment.balanceAfter == 0 ? 'paid' : (open ? 'processing' : 'partial'))
          && after.pendingDraftId == (open ? payment.draftId : '')
          && after.paymentHistoryIds == priorIds.concat([after.lastPaymentId])
          && after.lastPaymentReference == payment.externalReference;
      }
      function opensCreditDraft(before, after) {
        let path = /databases/$(database)/documents/management_expenses/$(after.pendingDraftId);
        let draft = getAfter(path).data;
        return canSettleSupplier(before.tenantId)
          && before.get('status', 'outstanding').lower() in ['outstanding', 'partial', 'unpaid', 'pending']
          && before.get('pendingDraftId', '') == ''
          && after.diff(before).affectedKeys().hasOnly(['status','lastProcessedAt','pendingDraftId'])
          && after.status == 'processing' && after.lastProcessedAt == request.time
          && !exists(path) && draft.sourceRefId == entryId && draft.tenantId == before.tenantId;
      }
      function rejectsCreditDraft(before, after) {
        let path = /databases/$(database)/documents/management_expenses/$(after.rejectedDraftId);
        let draft = getAfter(path).data;
        let balance = before.get('remainingCreditBalance', before.get('balance', before.get('amount_ugx', 0)));
        return canSettleSupplier(before.tenantId)
          && before.get('pendingDraftId', '') in ['', after.rejectedDraftId] && after.pendingDraftId == ''
          && after.diff(before).affectedKeys().hasOnly(['status','lastProcessedAt','pendingDraftId','rejectedDraftId'])
          && after.status == (balance == 0 ? 'paid' : (balance < before.get('originalCreditAmount', before.get('amount', before.get('amount_ugx', 0))) ? 'partial' : 'outstanding'))
          && after.lastProcessedAt == request.time && draft.rejectedAt == request.time
          && draft.sourceRefId == entryId && draft.status == 'rejected' && draft.tenantId == before.tenantId;
      }
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if validCreditLiability(request.resource.data);
      allow update: if validCreditLiabilitySettlement(resource.data, request.resource.data)
        || opensCreditDraft(resource.data, request.resource.data) || rejectsCreditDraft(resource.data, request.resource.data);
    }
    match /petty_cash_ledger/{entryId} {
      allow get: if isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if (canViewFinance() || canPostManagementCash()) && isTenantMember(resource.data.tenantId);
      allow create: if validManagementMovement(entryId, request.resource.data, 'petty_cash');
      allow update, delete: if false;
    }

    match /eod_reconciliations/{reconciliationId} {
      function withinCorrectionWindow() {
        let parts = resource.data.reconciliation_date.split('-');
        let start = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) - duration.value(3, 'h');
        return resource.data.reconciliation_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.time >= start && request.time < start + duration.value(14, 'd');
      }
      allow read: if isTenantMember(resource.data.tenantId) && canViewBranchFinance();
      allow create: if canOperateBranchFinance() && validBranchEodSubmission(reconciliationId, request.resource.data)
        && eodChannelPosted(reconciliationId, request.resource.data, 'cash', false)
        && eodChannelPosted(reconciliationId, request.resource.data, 'momo', true)
        && eodChannelPosted(reconciliationId, request.resource.data, 'airtel', true)
        && eodChannelPosted(reconciliationId, request.resource.data, 'card', true);
      allow update: if isTenantMember(resource.data.tenantId)
        && hasAnyRole(['IT Head']) && withinCorrectionWindow()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cash_actual', 'cash_variance', 'momo_actual', 'momo_variance',
          'airtel_actual', 'airtel_variance', 'card_actual', 'card_variance',
          'insurance_actual', 'insurance_variance', 'institutional_credit_actual', 'institutional_credit_variance',
          'staff_welfare_actual', 'staff_welfare_variance', 'total_actual', 'total_variance',
          'variance_reason', 'correction_reason', 'corrected_by', 'corrected_at', 'correction_posting_id'
        ])
        && request.resource.data.correction_reason is string
        && request.resource.data.correction_reason.trim().size() > 0 && request.resource.data.correction_reason.size() <= 1000
        && request.resource.data.corrected_by == request.auth.uid
        && request.resource.data.corrected_at == request.time
        && (resource.data.get('financial_posting', 'none') != 'portfolios_v1' ||
          (request.resource.data.correction_posting_id is string
          && request.resource.data.correction_posting_id != resource.data.get('correction_posting_id', '')
          && eodChannelPosted(reconciliationId, request.resource.data, 'cash', false)
          && eodChannelPosted(reconciliationId, request.resource.data, 'momo', true)
          && eodChannelPosted(reconciliationId, request.resource.data, 'airtel', true)
          && eodChannelPosted(reconciliationId, request.resource.data, 'card', true)));
      allow delete: if false;
    }

    match /branch_expenses/{expenseId} {
      function expenseBranchBelongs(data) {
        return get(/databases/$(database)/documents/branches/$(data.branch_id)).data.tenantId == data.tenantId;
      }
      function validBranchExpenseChange(before, after) {
        let changed = after.diff(before).affectedKeys();
        let postingId = 'expense_payment_' + expenseId;
        let movementPath = managementMovementPath('petty_cash', postingId);
        return before.cashPaymentVersion == 1 && after.cashPaymentVersion == 1
          && (before.status in ['Pending','pending'] && hasAnyRole(['Finance Head'])
            && ((after.status == before.status && after.amount_ugx is int && after.amount_ugx > 0
                && changed.hasOnly(['expense_date','category','description','issued_to','recipient_type','recipient_staff_id','recipient_staff_code','amount_ugx','updatedAt']))
              || (after.status == 'approved' && after.cashApprovedBy == request.auth.uid && after.cashApprovedAt == request.time
                && changed.hasOnly(['status','cashApprovedBy','cashApprovedAt'])))
            || (before.status == 'approved' && canPayBranchExpense(before.branch_id, before.tenantId)
              && after.status == 'paid' && after.cashOutflowPostingId == postingId
              && after.cashPaidBy == request.auth.uid && after.cashPaidAt == request.time
              && changed.hasOnly(['status','cashOutflowPostingId','cashPaidBy','cashPaidAt'])
              && !exists(movementPath) && getAfter(movementPath).data.externalExpenseCollection == 'branch_expenses'
              && getAfter(movementPath).data.externalExpenseId == expenseId));
      }
      allow get: if isAuthenticated() && ((resource == null && isPOSOperator()) || canReadPosFinancial());
      allow read: if isTenantMember(resource.data.tenantId) && canViewBranchFinance();
      allow create: if !('cashPaymentVersion' in request.resource.data) && atomicWelfareRecord(expenseId, 'branch_expenses');
      allow create: if isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance()
        && !request.resource.data.keys().hasAny(['cashOutflowPostingId','cashPaidBy','cashPaidAt','cashApprovedBy','cashApprovedAt'])
        && (request.resource.data.get('cashPaymentVersion', 0) == 0
          || (request.resource.data.cashPaymentVersion == 1 && request.resource.data.status in ['Pending','pending']
            && request.resource.data.amount_ugx is int && request.resource.data.amount_ugx > 0
            && request.resource.data.logged_by == request.auth.uid && expenseBranchBelongs(request.resource.data)
            && (isAssignedToBranch(request.resource.data.branch_id) || isFinance())));
      allow update: if isTenantMember(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId
        && (resource.data.get('cashPaymentVersion', 0) == 0
          ? canOperateBranchFinance() && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['cashPaymentVersion','cashOutflowPostingId','cashPaidBy','cashPaidAt','cashApprovedBy','cashApprovedAt'])
          : expenseBranchBelongs(resource.data) && validBranchExpenseChange(resource.data, request.resource.data));
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId)
        && resource.data.get('cashPaymentVersion', 0) == 0;
    }

    match /cash_requisitions/{requisitionId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewBranchFinance();
      allow create: if isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance();
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance();
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /credit_receivables/{receivableId} {
      allow get: if isAuthenticated() && ((resource == null && isPOSOperator()) || canReadPosFinancial());
      allow read: if resource.data.tenantId == getUserData().tenantId && (
        canViewFinance() || ((canViewBranchFinance() || isPOSOperator() || hasCustomModuleView('clients'))
          && isAssignedToBranch(resource.data.branch_id)));
      allow create: if validCreditRecognition(receivableId, request.resource.data);
      allow update: if (request.resource.data.get('lastSettlementId', '') != resource.data.get('lastSettlementId', '')
        ? validReceivableRowSettlement(receivableId, resource.data, request.resource.data)
        : atomicCreditUpdate(receivableId));
    }

    match /supplier_payables/{payableId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance();
    }

    match /banking_records/{recordId} {
      allow get: if (canOperateBranchFinance() || canViewFinance()) && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if canViewFinance() && isTenantMember(resource.data.tenantId);
      allow create: if validManagementMovement(recordId, request.resource.data, 'bank');
      allow update, delete: if false;
    }

    match /client_credit_ledger/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance();
    }

    match /institution_credit_ledger/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance();
    }

    match /supplier_credit_ledger/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance();
    }

    match /creditPayments/{paymentId} {
      allow get: if isFinance() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && canViewFinance();
      function validCreditSettlement(data) {
        let invoicePath = /databases/$(database)/documents/invoices/$(data.invoiceId);
        let liabilityPath = /databases/$(database)/documents/creditLedger/$(data.creditLedgerId);
        let before = get(invoicePath).data;
        let liability = get(liabilityPath).data;
        let draft = getAfter(/databases/$(database)/documents/management_expenses/$(data.draftId)).data;
        let grn = data.grnId == '' ? {} : getAfter(/databases/$(database)/documents/grn_records/$(data.grnId)).data;
        let register = data.procurementInvoiceId == '' ? {}
          : getAfter(/databases/$(database)/documents/procurement_invoices/$(data.procurementInvoiceId)).data;
        return validSupplierPaymentBase(paymentId, data, true)
          && paymentId == 'supplier_credit_settlement_' + data.tenantId + '_' + data.requestId
          && data.expenseId == data.draftId && data.paymentSource == data.paymentAccountId
          && before.tenantId == data.tenantId && before.get('paymentType', 'credit') == 'credit'
          && before.get('grnId', '') == data.grnId && data.totalInvoiceUGX == before.invoiceValue
          && (before.get('lastPaymentId', '') == '' || data.previouslyPaidUGX == before.paidAmountUGX)
          && liability.tenantId == data.tenantId && liability.get('invoiceId', liability.get('invoice_id', '')) == data.invoiceId
          && liability.get('grnId', liability.get('grn_id', data.grnId)) == data.grnId
          && liability.get('pendingDraftId', '') in ['', data.draftId]
          && data.balanceBefore == liability.get('remainingCreditBalance', liability.get('balance', liability.get('amount_ugx', liability.get('amount', 0))))
          && data.balanceBefore == before.creditBalance && data.previouslyPaidUGX == data.totalInvoiceUGX - data.balanceBefore
          && data.previouslyPaidUGX >= 0
          && data.balanceAfter == data.balanceBefore - data.amount && data.balanceAfter >= 0
          && getAfter(invoicePath).data.lastPaymentId == paymentId
          && getAfter(liabilityPath).data.lastPaymentId == paymentId
          && draft.tenantId == data.tenantId && draft.source == 'credit_payment' && draft.sourceType == 'credit'
          && draft.invoiceId == data.invoiceId && draft.sourceRefId == data.creditLedgerId && draft.lastPaymentId == paymentId
          && grn.get('procurement_invoice_id', '') == data.procurementInvoiceId
          && (data.grnId == '' || (grn.tenantId == data.tenantId && grn.lastPaymentId == paymentId
            && grn.get('credit_ledger_id', data.creditLedgerId) == data.creditLedgerId
            && (before.get('paymentType', '') == '' || grn.payment_type == 'credit')))
          && (data.procurementInvoiceId == '' || (register.tenantId == data.tenantId
            && register.grnId == data.grnId && register.lastPaymentId == paymentId));
      }
      allow create: if validCreditSettlement(request.resource.data);
      allow update, delete: if false;
    }

    match /financial_posting_audit/{auditId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isFinance() || isProcurement());
      allow create: if isTenantMember(request.resource.data.tenantId) && (isFinance() || isProcurement());
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && (isFinance());
      allow delete: if false;
    }

    match /financial_metrics/{metricId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isFinance());
      allow write: if isFinance();
    }

    match /management_expenses/{expenseId} {
      function freshManagementExpensePayment(data) {
        let postingId = 'expense_payment_' + expenseId;
        let path = managementMovementPath('petty_cash', postingId);
        let movement = getAfter(path).data;
        return isFinance() && data.cashOutflowPostingId == postingId && !exists(path)
          && movement.externalExpenseCollection == 'management_expenses' && movement.externalExpenseId == expenseId;
      }
      allow get: if isFinance() && resource == null
        && expenseId.matches('^(mcpay_[A-Za-z0-9]+|credit_payment_[A-Za-z0-9_-]+)$');
      // Procurement can only read deterministic GRN cash drafts for atomic
      // collision checks. Ordinary management expenses remain Finance/HR only.
      allow get: if isProcurement()
        && expenseId.matches('management_payment_draft_(grn_|op_grn_).*')
        && (resource == null || isTenantMember(resource.data.tenantId));
      allow read: if isTenantMember(resource.data.tenantId) && (isHR() || canViewFinance());
      function validGrnDraftSource(data) {
        let grn = getAfter(/databases/$(database)/documents/grn_records/$(data.grnId)).data;
        let invoice = getAfter(/databases/$(database)/documents/invoices/$(data.invoiceId)).data;
        return grn.tenantId == data.tenantId && grn.payment_type == 'cash'
          && grn.payment_status == 'pending_payment' && grn.invoice_id == data.invoiceId
          && invoice.tenantId == data.tenantId && invoice.invoiceValue == data.amount
          && invoice.paymentStatus == 'Pending Payment';
      }
      function validGrnDraftSettlement(data) {
        let path = supplierPaymentPath(data.lastPaymentId, false);
        let payment = getAfter(path).data;
        let paid = payment.remainingUGX == 0;
        return freshSupplierLink(data, payment, path) && payment.draftId == expenseId
          && resource.data.status in ['draft', 'partial']
          && resource.data.amount == payment.totalInvoiceUGX && resource.data.get('paidAmountUGX', 0) == payment.previouslyPaidUGX
          && data.diff(resource.data).affectedKeys().hasOnly(['status','paymentStatus','paidAmountUGX','balanceUGX','excludeFromOpexRollup','updatedAt','issuedAt','issuedBy','lastPaymentId'])
          && data.paidAmountUGX == payment.previouslyPaidUGX + payment.amountUGX
          && data.balanceUGX == payment.remainingUGX && data.excludeFromOpexRollup
          && data.status == (paid ? 'approved' : 'partial') && data.paymentStatus == (paid ? 'paid' : 'partial')
          && (!paid || (data.issuedAt == request.time && data.issuedBy == request.auth.uid));
      }
      function validCreditDraft(data) {
        let credit = getAfter(/databases/$(database)/documents/creditLedger/$(data.sourceRefId)).data;
        let outstanding = credit.get('remainingCreditBalance', credit.get('balance', credit.get('amount_ugx', 0)));
        return canSettleSupplier(data.tenantId) && data.source == 'credit_payment' && data.sourceType == 'credit'
          && credit.tenantId == data.tenantId && credit.get('invoiceId', credit.get('invoice_id', '')) == data.invoiceId && credit.status == 'processing'
          && credit.pendingDraftId == expenseId && credit.lastProcessedAt == request.time
          && data.originalAmount == outstanding && data.amount is int && data.amount > 0 && data.amount <= outstanding
          && data.requestId.matches('^[A-Za-z0-9_-]{1,150}$')
          && expenseId == 'credit_payment_' + data.sourceRefId + '_' + data.requestId
          && data.status == 'draft' && data.excludeFromOpexRollup && data.createdBy == request.auth.uid
          && !data.keys().hasAny(['cashOutflowPostingId','lastPaymentId','paidAmountUGX','balanceUGX']);
      }
      function validCreditDraftSettlement(data) {
        let before = resource.data;
        let path = supplierPaymentPath(data.lastPaymentId, true);
        let payment = getAfter(path).data;
        let remaining = before.amount - before.get('paidAmountUGX', 0) - payment.amount;
        let balance = remaining < payment.balanceAfter ? remaining : payment.balanceAfter;
        let paid = balance == 0;
        return freshSupplierLink(data, payment, path) && payment.draftId == expenseId
          && before.status in ['draft','pending','partial'] && before.amount <= before.get('originalAmount', before.amount)
          && data.diff(before).affectedKeys().hasOnly(['status','paymentStatus','paidAmountUGX','balanceUGX','paymentReference',
            'excludeFromOpexRollup','updatedAt','issuedAt','issuedBy','lastPaymentId'])
          && data.paidAmountUGX == before.get('paidAmountUGX', 0) + payment.amount
          && balance >= 0 && data.balanceUGX == balance && data.excludeFromOpexRollup
          && data.paymentReference == payment.externalReference
          && data.status == (paid ? 'approved' : 'partial') && data.paymentStatus == (paid ? 'paid' : 'partial')
          && (!paid || (data.issuedAt == request.time && data.issuedBy == request.auth.uid));
      }
      function validCreditDraftRejection(data) {
        let before = resource.data;
        let credit = getAfter(/databases/$(database)/documents/creditLedger/$(before.sourceRefId)).data;
        return canSettleSupplier(before.tenantId) && before.status in ['draft','pending','partial']
          && data.status == 'rejected' && data.rejectedAt == request.time && data.rejectedBy == request.auth.uid
          && data.diff(before).affectedKeys().hasOnly(['status','rejectedAt','rejectedBy'])
          && credit.tenantId == before.tenantId && credit.get('invoiceId', credit.get('invoice_id', '')) == before.invoiceId
          && credit.rejectedDraftId == expenseId && credit.lastProcessedAt == request.time;
      }
      function supplierDraft(data) {
        return data.get('source', '') in ['procurement_cash_grn', 'credit_payment', 'cash_grn']
          || data.get('sourceType', '') in ['credit', 'procurement'];
      }
      // A cash GRN creates a payment draft tied to the GRN and invoice in the same commit.
      allow create: if request.resource.data.get('payrollVersion',0) != 11 && isProcurement()
        && isTenantMember(request.resource.data.tenantId)
        && expenseId == 'management_payment_draft_' + request.resource.data.grnId
        && request.resource.data.source == 'procurement_cash_grn'
        && !('cashOutflowPostingId' in request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.paymentStatus == 'pending_payment'
        && request.resource.data.excludeFromOpexRollup
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount == request.resource.data.amount_ugx
        && request.resource.data.amount > 0
        && validGrnDraftSource(request.resource.data);
      allow create: if request.resource.data.get('source','') == 'credit_payment' && validCreditDraft(request.resource.data);
      allow create: if request.resource.data.get('payrollVersion',0) != 11 && isTenantMember(request.resource.data.tenantId) && (isFinance() || isHR())
        && !supplierDraft(request.resource.data)
        && (!('cashOutflowPostingId' in request.resource.data) || freshManagementExpensePayment(request.resource.data));
      allow update: if resource.data.get('payrollVersion',0) != 11 && request.resource.data.get('payrollVersion',0) != 11
        && isTenantMember(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId
        && !('cashOutflowPostingId' in resource.data)
        && (resource.data.get('source','') == 'procurement_cash_grn' ? validGrnDraftSettlement(request.resource.data)
          : resource.data.get('source','') == 'credit_payment'
            ? ((request.resource.data.status == 'rejected' && validCreditDraftRejection(request.resource.data))
              || (request.resource.data.status != 'rejected' && validCreditDraftSettlement(request.resource.data)))
            : isFinance() && !supplierDraft(resource.data) && !supplierDraft(request.resource.data)
              && (!('cashOutflowPostingId' in request.resource.data) || freshManagementExpensePayment(request.resource.data)));
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId) && !('cashOutflowPostingId' in resource.data)
        && !supplierDraft(resource.data) && resource.data.get('payrollVersion',0) != 11;
      allow create, update: if request.resource.data.get('payrollVersion',0) == 11
        && validPayrollDraft(expenseId,request.resource.data);
    }

    match /campaigns/{campaignId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /health_messages/{messageId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /marketing_expenses/{expenseId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if (isMarketing() || isFinance()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /outreach_events/{eventId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /prescriber_disbursements/{disbursementId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if (isMarketing() || isFinance()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /pharmpoints_settings/{settingsId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /controlled_drug_register/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isQA() || isBranchManager());
      allow create: if isAuthenticated() && (isQA() || isBranchManager());
      allow update, delete: if isAdmin(); // Highly sensitive
    }

    match /expiry_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /quarantine_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /room_temp_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager() || isAuthenticated(); // Staff can log
    }

    match /fridge_temp_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager() || isAuthenticated(); // Staff can log
    }

    match /cleaning_tasks/{taskId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /cleaning_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated(); // Staff can log completion
    }

    match /recalls/{recallId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isAdmin();
    }

    match /premises_licenses/{licenseId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isAdmin();
    }

    match /cme_sessions/{sessionId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isHR();
    }

    match /cme_attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffId) || isQA() || isHR() || isTenantMember(resource.data.tenantId));
      allow write: if isQA() || isHR();
    }

    match /appraisal_cycles/{cycleId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isHR();
    }

    match /appraisals/{appraisalId} {
      allow read: if isTenantMember(resource.data.tenantId) && (
        isOwner(resource.data.staffId) || isQA() || isHR() ||
        (isPeopleSupervisor() && isAssignedToBranch(resource.data.branchId))
      );
      allow create: if isTenantMember(request.resource.data.tenantId) && (
        isQA() || isHR() ||
        (isPeopleSupervisor()
          && isAssignedToBranch(request.resource.data.branchId)
          && request.resource.data.staffId != request.auth.uid
          && request.resource.data.appraisedByUserId == request.auth.uid)
      );
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && (
        isQA() || isHR() ||
        (isPeopleSupervisor()
          && resource.data.appraisedByUserId == request.auth.uid
          && request.resource.data.appraisedByUserId == resource.data.appraisedByUserId
          && request.resource.data.appraisedByName == resource.data.appraisedByName
          && request.resource.data.appraisedByRole == resource.data.appraisedByRole
          && request.resource.data.appraisedAt == resource.data.appraisedAt
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.staffId != request.auth.uid
          && request.resource.data.lastUpdatedByUserId == request.auth.uid)
      );
      allow delete: if isQA() || isHR();
    }

    match /operational_inventory_masters/{masterItemId} {
      function hasIdentityClaim() {
        let claimId = operationalIdentityClaimId(request.resource.data);
        let claim = /databases/$(database)/documents/operational_inventory_identity_claims/$(claimId);
        return operationalIdentityReady(request.resource.data.tenantId)
          && request.resource.data.unitPerPack is int && request.resource.data.unitPerPack > 0
          && request.resource.data.identityClaimId == claimId
          && existsAfter(claim) && getAfter(claim).data.tenantId == request.resource.data.tenantId
          && getAfter(claim).data.masterItemId == masterItemId;
      }
      // Client transactions read their deterministic target documents before
      // creating them. Permit authenticated point-gets of missing documents;
      // existing documents and all collection queries remain tenant-scoped.
      allow get: if isAuthenticated()
        && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && hasIdentityClaim()
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && request.resource.data.type in ['fixed', 'non-fixed']
        && ((request.resource.data.type == 'fixed' && request.resource.data.operationalType == 'FIXED_ASSET')
          || (request.resource.data.type == 'non-fixed' && request.resource.data.operationalType == 'CONSUMABLE_OPERATIONAL'));
      allow update: if isInventoryOperator()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && isOperationalInventoryEnabled(resource.data.tenantId)
        && request.resource.data.inventoryClass == resource.data.inventoryClass
        && request.resource.data.operationalType == resource.data.operationalType
        && request.resource.data.type == resource.data.type
        && operationalIdentityFingerprint(request.resource.data) == operationalIdentityFingerprint(resource.data)
        && request.resource.data.get('identityClaimId', '') == resource.data.get('identityClaimId', '')
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && request.resource.data.type in ['fixed', 'non-fixed'];
      allow delete: if false;
    }

    match /operational_inventory/{itemId} {
      function hasOperationalMaster() {
        let masterPath = /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
        return request.resource.data.masterItemId is string
          && operationalIdentityReady(request.resource.data.tenantId)
          && existsAfter(masterPath)
          && getAfter(masterPath).data.tenantId == request.resource.data.tenantId
          && getAfter(masterPath).data.inventoryClass == 'OPERATIONAL'
          && getAfter(masterPath).data.operationalType == request.resource.data.operationalType
          && operationalIdentityFingerprint(getAfter(masterPath).data) == operationalIdentityFingerprint(request.resource.data);
      }
      function hasMatchingOperationalMovement() {
        let movementId = request.resource.data.lastMovementId;
        let movementPath = /databases/$(database)/documents/operational_inventory_movements/$(movementId);
        let movement = getAfter(movementPath).data;
        return movementId is string
          && existsAfter(movementPath)
          && movement.tenantId == resource.data.tenantId
          && movement.inventoryClass == 'OPERATIONAL'
          && movement.itemId == itemId
          && movement.locationId == (resource.data.branchId == 'HQ' ? 'HQ_OPERATIONAL' : 'BRANCH_' + resource.data.branchId)
          && movement.balanceBefore == resource.data.quantityInStock
          && movement.balanceAfter == request.resource.data.quantityInStock
          && movement.quantityDelta == request.resource.data.quantityInStock - resource.data.quantityInStock;
      }
      function hasOpeningOperationalMovement() {
        let movementId = request.resource.data.lastMovementId;
        let movementPath = /databases/$(database)/documents/operational_inventory_movements/$(movementId);
        return request.resource.data.quantityInStock == 0
          || (movementId is string
            && existsAfter(movementPath)
            && getAfter(movementPath).data.tenantId == request.resource.data.tenantId
            && getAfter(movementPath).data.inventoryClass == 'OPERATIONAL'
            && getAfter(movementPath).data.itemId == itemId
            && getAfter(movementPath).data.movementType == 'ADJUSTMENT'
            && getAfter(movementPath).data.balanceBefore == 0
            && getAfter(movementPath).data.balanceAfter == request.resource.data.quantityInStock
            && getAfter(movementPath).data.quantityDelta == request.resource.data.quantityInStock
            && getAfter(movementPath).data.actorId == request.auth.uid);
      }
      allow get: if isAuthenticated()
        && (resource == null || (isTenantMember(resource.data.tenantId)
          && (isProcurement() || canOperateOperationalLocation(resource.data.branchId))));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || canOperateOperationalLocation(resource.data.branchId));
      allow create: if isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && canOperateOperationalLocation(request.resource.data.branchId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && hasOperationalMaster()
        && hasOpeningOperationalMovement()
        && request.resource.data.type in ['fixed', 'non-fixed'];
      allow update: if isAuthenticated()
        && resource.data.get('inventoryClass', 'OPERATIONAL') == 'OPERATIONAL'
        && ((isInventoryOperator() && canOperateOperationalLocation(resource.data.branchId)) || (isProcurement()
          && resource.data.branchId == 'HQ'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantityInStock', 'lastMovementId', 'costPerPack', 'updatedAt'])))
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branchId == resource.data.branchId
        && isOperationalInventoryEnabled(resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && (!('masterItemId' in resource.data) || request.resource.data.masterItemId == resource.data.masterItemId)
        && (!('masterItemId' in request.resource.data) || hasOperationalMaster())
        && request.resource.data.type == resource.data.type
        && (!('operationalType' in resource.data) || request.resource.data.operationalType == resource.data.operationalType)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['quantityInStock'])
          || hasMatchingOperationalMovement());
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId) && isOperationalInventoryEnabled(resource.data.tenantId);
    }

    match /operational_inventory_movements/{movementId} {
      function itemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.itemId);
      }
      function masterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.get('masterItemId', ''));
      }
      function transferPath() {
        return /databases/$(database)/documents/operational_transfers/$(request.resource.data.get('sourceTransactionId', ''));
      }
      function transferLinePath() {
        return /databases/$(database)/documents/operational_transfer_lines/$(request.resource.data.get('sourceLineId', ''));
      }
      function usagePath() {
        return /databases/$(database)/documents/operational_inventory_usage/$(request.resource.data.get('sourceTransactionId', ''));
      }
      function validUsageMovement(item) {
        let usage = getAfter(usagePath()).data;
        return request.resource.data.movementType == 'USAGE'
          && request.resource.data.quantityDelta < 0
          && request.resource.data.sourceTransactionId is string
          && request.resource.data.sourceLineId == request.resource.data.sourceTransactionId
          && existsAfter(usagePath())
          && usage.tenantId == request.resource.data.tenantId
          && usage.inventoryClass == 'OPERATIONAL'
          && usage.operationalType == 'CONSUMABLE_OPERATIONAL'
          && usage.inventoryId == request.resource.data.itemId
          && usage.branchId == item.branchId
          && usage.movementId == 'opm_' + request.resource.data.idempotencyKey
          && usage.issuedAmount == -request.resource.data.quantityDelta
          && usage.staffId == request.resource.data.actorId
          && usage.reference == request.resource.data.reference;
      }
      function validTransferMovement(item) {
        let transferPathValue = transferPath();
        let transferLinePathValue = transferLinePath();
        let transfer = getAfter(transferPathValue).data;
        let transferLine = getAfter(transferLinePathValue).data;
        let data = request.resource.data;
        return data.sourceTransactionId is string
          && data.sourceLineId is string
          && existsAfter(transferPathValue)
          && transfer.tenantId == data.tenantId
          && transfer.inventoryClass == 'OPERATIONAL'
          && existsAfter(transferLinePathValue)
          && transferLine.tenantId == data.tenantId
          && transferLine.transferId == data.sourceTransactionId
          && transferLine.masterItemId == data.masterItemId
          && ((data.movementType == 'TRANSFER_OUT'
              && item.branchId == 'HQ'
              && transfer.sourceLocationId == 'HQ_OPERATIONAL'
              && transferLine.sourceItemId == data.itemId)
            || (data.movementType == 'TRANSFER_OUT'
              && transfer.transferType == 'BRANCH_RETURN'
              && item.branchId == transfer.sourceBranchId
              && transfer.sourceLocationId == 'BRANCH_' + item.branchId
              && transferLine.sourceItemId == data.itemId)
            || (data.movementType == 'TRANSFER_IN'
              && transfer.transferType == 'BRANCH_RETURN'
              && item.branchId == 'HQ'
              && transfer.destinationBranchId == 'HQ'
              && transferLine.destinationItemId == data.itemId)
            || (data.movementType == 'TRANSFER_IN'
              && item.branchId != 'HQ'
              && transfer.destinationBranchId == item.branchId
              && transferLine.destinationItemId == data.itemId));
      }
      allow get: if isAuthenticated()
        && (resource == null || (isTenantMember(resource.data.tenantId)
          && canOperateOperationalLocation(resource.data.branchId)));
      allow list: if isTenantMember(resource.data.tenantId)
        && canOperateOperationalLocation(resource.data.branchId);
      function validMovementCreate() {
        let data = request.resource.data;
        let item = getAfter(itemPath()).data;
        let master = getAfter(masterPath()).data;
        return isAuthenticated()
        && isTenantMember(data.tenantId)
        && isOperationalInventoryEnabled(data.tenantId)
        && data.inventoryClass == 'OPERATIONAL'
        && (isInventoryOperator() || isProcurement())
        && data.movementType in ['RECEIPT', 'DISPATCH', 'RETURN', 'TRANSFER_IN', 'TRANSFER_OUT', 'USAGE', 'ADJUSTMENT', 'WRITE_OFF']
        && data.quantityDelta is number
        && data.quantityDelta != 0
        && data.balanceBefore is number
        && data.balanceAfter is number
        && data.balanceBefore >= 0
        && data.balanceAfter >= 0
        && data.balanceAfter == data.balanceBefore + data.quantityDelta
        && data.reference is string
        && data.reference.size() > 0
        && data.idempotencyKey is string
        && data.idempotencyKey.matches('^[A-Za-z0-9_-]{1,190}$')
        && movementId == 'opm_' + data.idempotencyKey
        && data.actorId == request.auth.uid
        && existsAfter(itemPath())
        && item.tenantId == data.tenantId
        && item.inventoryClass == 'OPERATIONAL'
        && data.branchId == item.branchId
        && data.locationId == (item.branchId == 'HQ' ? 'HQ_OPERATIONAL' : 'BRANCH_' + item.branchId)
        && ((item.branchId == 'HQ' && (isProcurement() || (isInventoryOperator() && isAssignedToBranch('HQ'))))
          || (item.branchId != 'HQ' && isInventoryOperator() && isAssignedToBranch(item.branchId)))
        && data.masterItemId is string
        && existsAfter(masterPath())
        && master.tenantId == data.tenantId
        && master.inventoryClass == 'OPERATIONAL'
        && data.masterItemId == item.get('masterItemId', data.itemId)
        && item.quantityInStock == data.balanceAfter
        && item.lastMovementId == movementId
        && (exists(itemPath())
          ? get(itemPath()).data.quantityInStock == data.balanceBefore
            && get(itemPath()).data.tenantId == data.tenantId
            && get(itemPath()).data.branchId == item.branchId
            && (data.movementType in ['TRANSFER_IN', 'TRANSFER_OUT'] ? validTransferMovement(get(itemPath()).data) : true)
            && (data.movementType == 'USAGE' ? validUsageMovement(get(itemPath()).data) : true)
          : data.movementType == 'ADJUSTMENT'
            && data.balanceBefore == 0
            && data.reason is string
            && data.reason.size() > 0);
      }
      allow create: if validMovementCreate();
      allow update, delete: if false;
    }

    match /operational_grn_lines/{grnLineId} {
      function grnPath() {
        return /databases/$(database)/documents/grn_records/$(request.resource.data.grnId);
      }
      function orderPath() {
        return /databases/$(database)/documents/stock_orders/$(request.resource.data.orderId);
      }
      function sourceLinePath() {
        return /databases/$(database)/documents/stock_order_lines/$(request.resource.data.orderLineId);
      }
      function itemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.itemId);
      }
      function masterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
      }
      function movementPath() {
        return /databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId);
      }
      allow get: if isProcurement() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && isProcurement();
      function validGrnLineRoute() {
        let line = request.resource.data;
        let grn = getAfter(grnPath()).data;
        let item = get(itemPath()).data;
        let sourceLine = get(sourceLinePath()).data;
        let order = get(orderPath()).data;
        return (grn.get('deliveryRoute', 'VIA_HQ') == 'VIA_HQ'
            && item.branchId == 'HQ'
            && existsAfter(movementPath())
            && getAfter(movementPath()).data.tenantId == line.tenantId
            && getAfter(movementPath()).data.itemId == line.itemId
            && getAfter(movementPath()).data.masterItemId == line.masterItemId
            && getAfter(movementPath()).data.sourceTransactionId == line.grnId)
          || (grn.get('deliveryRoute', '') == 'DIRECT_BRANCH'
            && line.deliveryRoute == 'DIRECT_BRANCH' && line.locationId == 'SUPPLIER_TRANSIT'
            && line.movementId == '' && item.branchId == order.requesting_branch_id
            && item.branchId != 'HQ' && grn.destination_branch_id == item.branchId
            && sourceLine.supplier_type == 'external' && sourceLine.line_status == 'approved'
            && sourceLine.supplier_id == line.supplierId
            && line.qtyReceived <= sourceLine.qty_ordered - sourceLine.get('qty_received', 0)
            && (sourceLine.get('qty_received', 0) == 0 || order.get('operational_delivery_route', '') == 'DIRECT_BRANCH')
            && line.qtyReceivedUnits == line.qtyReceived * get(masterPath()).data.unitPerPack
            && line.totalValueUGX == line.qtyReceived * line.unitCostUGX);
      }
      function validGrnLine() {
        let line = request.resource.data;
        let grn = getAfter(grnPath()).data;
        let order = get(orderPath()).data;
        let source = get(sourceLinePath()).data;
        let item = get(itemPath()).data;
        let master = get(masterPath()).data;
        return isProcurement()
        && isTenantMember(line.tenantId)
        && isOperationalInventoryEnabled(line.tenantId)
        && line.inventoryClass == 'OPERATIONAL'
        && line.qtyReceived is number
        && line.qtyReceived > 0
        && line.qtyReceivedUnits is number
        && line.qtyReceivedUnits > 0
        && line.unitCostUGX is number
        && line.unitCostUGX >= 0
        && line.totalValueUGX is number
        && line.totalValueUGX >= 0
        && line.receivedBy == request.auth.uid
        && grn.tenantId == line.tenantId
        && grn.inventoryClass == 'OPERATIONAL'
        && grn.order_id == line.orderId
        && grn.receivedBy == request.auth.uid
        && order.tenantId == line.tenantId
        && isOperationalOrderData(order)
        && source.tenantId == line.tenantId
        && source.order_id == line.orderId
        && source.inventoryClass == 'OPERATIONAL'
        && source.masterItemId == line.masterItemId
        && item.tenantId == line.tenantId
        && item.inventoryClass == 'OPERATIONAL'
        && item.masterItemId == line.masterItemId
        && master.tenantId == line.tenantId
        && master.inventoryClass == 'OPERATIONAL'
        && validGrnLineRoute();
      }
      allow create: if validGrnLine();
      allow update, delete: if false;
    }

    match /operational_transfers/{transferId} {
      function sourceOrderPath() {
        return /databases/$(database)/documents/stock_orders/$(request.resource.data.sourceOrderId);
      }
      function validOperationalTransfer(data) {
        return data.inventoryClass == 'OPERATIONAL'
          && data.fulfillmentSource in ['HQ_OPERATIONAL', 'EXTERNAL_SUPPLIER', 'HQ_DIRECT', 'BRANCH_RETURN']
          && ((data.get('transferType', '') == 'BRANCH_RETURN'
              && data.fulfillmentSource == 'BRANCH_RETURN'
              && data.sourceBranchId != 'HQ'
              && data.sourceLocationId == 'BRANCH_' + data.sourceBranchId
              && data.destinationBranchId == 'HQ')
            || (data.get('transferType', '') != 'BRANCH_RETURN'
              && ((data.get('deliveryRoute', 'VIA_HQ') == 'VIA_HQ'
                  && data.sourceLocationId == 'HQ_OPERATIONAL' && data.sourceBranchId == 'HQ')
                || (data.get('deliveryRoute', '') == 'DIRECT_BRANCH'
                  && data.fulfillmentSource == 'EXTERNAL_SUPPLIER'
                  && data.sourceLocationId == 'SUPPLIER_TRANSIT' && data.sourceBranchId == 'SUPPLIER'
                  && get(sourceOrderPath()).data.operational_delivery_route == 'DIRECT_BRANCH'
                  && get(sourceOrderPath()).data.status == 'fully_received'))
              && data.destinationBranchId is string
              && data.destinationBranchId.size() > 0
              && data.destinationBranchId != 'HQ'))
          && data.expectedLineCount is number
          && data.expectedLineCount > 0
          && data.expectedLineCount <= 12
          && data.remainingExternalPacks is number
          && data.remainingExternalPacks >= 0
          && ((data.fulfillmentSource in ['HQ_DIRECT', 'BRANCH_RETURN']
              && !('sourceOrderId' in data))
            || (data.fulfillmentSource in ['HQ_OPERATIONAL', 'EXTERNAL_SUPPLIER']
              && ('sourceOrderId' in data)
              && exists(/databases/$(database)/documents/stock_orders/$(data.sourceOrderId))
              && get(/databases/$(database)/documents/stock_orders/$(data.sourceOrderId)).data.tenantId == data.tenantId
              && isOperationalOrderData(get(/databases/$(database)/documents/stock_orders/$(data.sourceOrderId)).data)
              && get(/databases/$(database)/documents/stock_orders/$(data.sourceOrderId)).data.requesting_branch_id == data.destinationBranchId));
      }
      allow get: if isAuthenticated() && ((resource == null && (isProcurement() || isInventoryOperator())) || (isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.destinationBranchId) || (resource.data.get('transferType', '') == 'BRANCH_RETURN' && isAssignedToBranch(resource.data.sourceBranchId)))));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.destinationBranchId) || (resource.data.get('transferType', '') == 'BRANCH_RETURN' && isAssignedToBranch(resource.data.sourceBranchId)));
      allow create: if isAuthenticated()
        && (isProcurement() || (request.resource.data.get('transferType', '') == 'BRANCH_RETURN' && isInventoryOperator() && isAssignedToBranch(request.resource.data.sourceBranchId)))
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && validOperationalTransfer(request.resource.data)
        && ((request.resource.data.get('transferType', '') == 'BRANCH_RETURN' && request.resource.data.status == 'dispatched')
          || (request.resource.data.get('transferType', '') != 'BRANCH_RETURN' && request.resource.data.status == 'draft'))
        && request.resource.data.dispatchedBy == request.auth.uid;
      allow update: if isAuthenticated()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.inventoryClass == resource.data.inventoryClass
        && request.resource.data.get('deliveryRoute', 'VIA_HQ') == resource.data.get('deliveryRoute', 'VIA_HQ')
        && request.resource.data.sourceLocationId == resource.data.sourceLocationId
        && request.resource.data.sourceBranchId == resource.data.sourceBranchId
        && request.resource.data.destinationBranchId == resource.data.destinationBranchId
        && request.resource.data.get('sourceOrderId', '') == resource.data.get('sourceOrderId', '')
        && request.resource.data.get('requestPayloadKey', '') == resource.data.get('requestPayloadKey', '')
        && request.resource.data.get('transferType', '') == resource.data.get('transferType', '')
        && request.resource.data.get('receiptMovementId', '') == resource.data.get('receiptMovementId', '')
          && request.resource.data.fulfillmentSource == resource.data.fulfillmentSource
          && request.resource.data.remainingExternalPacks == resource.data.remainingExternalPacks
        && isOperationalInventoryEnabled(resource.data.tenantId)
        && ((isProcurement()
            && resource.data.status in ['draft', 'dispatching']
            && request.resource.data.status in ['dispatching', 'dispatched'])
          || (isProcurement()
            && resource.data.transferType == 'BRANCH_RETURN'
            && resource.data.status == 'dispatched'
            && request.resource.data.status == 'received'
            && request.resource.data.receivedBy == request.auth.uid
            && existsAfter(/databases/$(database)/documents/operational_inventory_movements/$(resource.data.receiptMovementId))
            && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(resource.data.receiptMovementId)).data.sourceTransactionId == transferId
            && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(resource.data.receiptMovementId)).data.movementType == 'TRANSFER_IN')
          || (isInventoryOperator()
            && isAssignedToBranch(resource.data.destinationBranchId)
            && resource.data.status in ['dispatched', 'partially_received']
            && request.resource.data.status in ['partially_received', 'received', 'queried']
            && (request.resource.data.status == 'partially_received' || request.resource.data.receivedBy == request.auth.uid)));

      allow delete: if false;
    }

    match /operational_transfer_lines/{transferLineId} {
      function transferPath() {
        return /databases/$(database)/documents/operational_transfers/$(request.resource.data.transferId);
      }
      function sourceItemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.sourceItemId);
      }
      function destinationItemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.destinationItemId);
      }
      function masterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
      }
      function sourceOrderLinePath() {
        return /databases/$(database)/documents/stock_order_lines/$(request.resource.data.sourceOrderLineId);
      }
      function validDirectSupplierLine() {
        let line = request.resource.data;
        let transfer = getAfter(transferPath()).data;
        let source = get(sourceOrderLinePath()).data;
        let master = get(masterPath()).data;
        let destination = get(destinationItemPath()).data;
        let grn = get(/databases/$(database)/documents/grn_records/$(source.grn_id)).data;
        return transfer.get('deliveryRoute', '') == 'DIRECT_BRANCH'
          && transfer.fulfillmentSource == 'EXTERNAL_SUPPLIER' && transfer.sourceLocationId == 'SUPPLIER_TRANSIT'
          && transfer.tenantId == line.tenantId && transfer.inventoryClass == 'OPERATIONAL'
          && line.inventoryClass == 'OPERATIONAL' && line.status in ['prepared', 'dispatched']
          && line.sourceItemId == 'SUPPLIER_TRANSIT' && line.dispatchMovementId == ''
          && line.destinationBranchId == transfer.destinationBranchId
          && destination.branchId == transfer.destinationBranchId && destination.branchId != 'HQ'
          && destination.tenantId == line.tenantId && destination.inventoryClass == 'OPERATIONAL'
          && destination.masterItemId == line.masterItemId
          && master.tenantId == line.tenantId && master.inventoryClass == 'OPERATIONAL'
          && source.tenantId == line.tenantId && source.order_id == transfer.sourceOrderId
          && source.inventoryClass == 'OPERATIONAL' && source.masterItemId == line.masterItemId
          && source.supplier_type == 'external' && source.line_status == 'received'
          && source.operational_delivery_route == 'DIRECT_BRANCH'
          && grn.deliveryRoute == 'DIRECT_BRANCH' && grn.tenantId == line.tenantId && grn.order_id == transfer.sourceOrderId
          && line.quantityDispatched is number && line.quantityDispatched > 0
          && line.quantityDispatched == source.qty_received * master.unitPerPack
          && source.operational_received_value_ugx is number && source.operational_received_value_ugx >= 0
          && line.unitCostUGX == float(source.operational_received_value_ugx) / float(source.qty_received * master.unitPerPack)
          && line.totalValueUGX == line.quantityDispatched * line.unitCostUGX
          && isOperationalInventoryEnabled(line.tenantId);
      }
      function validPreparedOperationalTransferLine() {
        let line = request.resource.data;
        // Bind validated records once to keep mixed-role dispatch below the
        // Firestore expression budget without relaxing any linkage checks.
        let transfer = getAfter(transferPath()).data;
        let source = get(sourceItemPath()).data;
        let destination = get(destinationItemPath()).data;
        let master = get(masterPath()).data;
        let orderLine = 'sourceOrderLineId' in request.resource.data ? get(sourceOrderLinePath()).data : {};
        return line.inventoryClass == 'OPERATIONAL'
          && line.status == 'prepared'
          && line.quantityDispatched is number
          && line.quantityDispatched > 0
          && line.unitCostUGX is number
          && line.unitCostUGX >= 0
          && transfer.tenantId == line.tenantId
          && transfer.inventoryClass == 'OPERATIONAL'
          && isOperationalInventoryEnabled(line.tenantId)
          && source.tenantId == line.tenantId
          && source.branchId == 'HQ'
          && source.inventoryClass == 'OPERATIONAL'
          && source.masterItemId == line.masterItemId
          && destination.tenantId == line.tenantId
          && destination.branchId == transfer.destinationBranchId
          && destination.inventoryClass == 'OPERATIONAL'
          && destination.masterItemId == line.masterItemId
          && master.tenantId == line.tenantId
          && master.inventoryClass == 'OPERATIONAL'
          && master.hqLocationItemId == line.sourceItemId
          && (
            (transfer.fulfillmentSource == 'HQ_DIRECT'
              && !('sourceOrderLineId' in line))
            || (transfer.fulfillmentSource == 'HQ_OPERATIONAL'
                  && orderLine.tenantId == line.tenantId
              && orderLine.order_id == transfer.sourceOrderId
              && orderLine.inventoryClass == 'OPERATIONAL'
              && orderLine.masterItemId == line.masterItemId
              && orderLine.line_status == 'sourcing'
              && !('supplier_type' in orderLine)
              && line.quantityDispatched <= orderLine.qty_ordered * master.unitPerPack)
            || (transfer.fulfillmentSource == 'EXTERNAL_SUPPLIER'
                  && orderLine.tenantId == line.tenantId
              && orderLine.order_id == transfer.sourceOrderId
              && orderLine.inventoryClass == 'OPERATIONAL'
              && orderLine.masterItemId == line.masterItemId
              && orderLine.supplier_type == 'external'
              && orderLine.line_status == 'received'
              && line.quantityDispatched == orderLine.qty_received * master.unitPerPack)
          );
      }
      function validBranchReturnLine() {
        let line = request.resource.data;
        let transfer = getAfter(transferPath()).data;
        let src = get(sourceItemPath()).data;
        let dest = get(destinationItemPath()).data;
        let master = get(masterPath()).data;
        return transfer.transferType == 'BRANCH_RETURN'
          && line.inventoryClass == 'OPERATIONAL'
          && line.status == 'dispatched'
          && line.quantityDispatched is number
          && line.quantityDispatched > 0
          && line.unitCostUGX is number
          && line.unitCostUGX >= 0
          && line.destinationBranchId == transfer.destinationBranchId
          && line.tenantId == transfer.tenantId
          && transfer.tenantId == src.tenantId && src.tenantId == dest.tenantId && dest.tenantId == master.tenantId
          && src.branchId == transfer.sourceBranchId
          && dest.branchId == 'HQ'
          && src.inventoryClass == 'OPERATIONAL' && dest.inventoryClass == 'OPERATIONAL'
          && src.masterItemId == line.masterItemId
          && dest.masterItemId == line.masterItemId
          && master.inventoryClass == 'OPERATIONAL'
          && master.hqLocationItemId == line.destinationItemId
          && existsAfter(transferPath()) && exists(sourceItemPath()) && exists(destinationItemPath()) && exists(masterPath())
          && existsAfter(dispatchMovementPath())
          && getAfter(dispatchMovementPath()).data.itemId == line.sourceItemId
          && getAfter(dispatchMovementPath()).data.sourceTransactionId == line.transferId
          && getAfter(dispatchMovementPath()).data.sourceLineId == line.id
          && getAfter(dispatchMovementPath()).data.movementType == 'TRANSFER_OUT'
          && getAfter(dispatchMovementPath()).data.quantityDelta == -line.quantityDispatched;
      }
      function dispatchMovementPath() {
        return /databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.dispatchMovementId);
      }
      function receiptMovementPath() {
        return /databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.receiptMovementId);
      }
      allow get: if isAuthenticated()
        && ((resource == null && isProcurement()) || (resource != null && isTenantMember(resource.data.tenantId)
          && (isProcurement() || isAssignedToBranch(resource.data.destinationBranchId)
            || (resource.data.get('transferType', '') == 'BRANCH_RETURN' && isAssignedToBranch(resource.data.sourceBranchId)))));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.destinationBranchId) || (resource.data.get('transferType', '') == 'BRANCH_RETURN' && isAssignedToBranch(resource.data.sourceBranchId)));
      allow create: if isAuthenticated()
        && (isProcurement() || (request.resource.data.status == 'dispatched' && isInventoryOperator() && isAssignedToBranch(getAfter(transferPath()).data.sourceBranchId)))
        && isTenantMember(request.resource.data.tenantId)
        && (request.resource.data.sourceItemId == 'SUPPLIER_TRANSIT'
          ? (request.resource.data.status == 'prepared' && validDirectSupplierLine())
          : (validPreparedOperationalTransferLine() || validBranchReturnLine()));
      function validAcceptedReceiptMovement() {
        let movement = getAfter(receiptMovementPath()).data;
        return existsAfter(receiptMovementPath())
          && movement.tenantId == resource.data.tenantId
          && movement.itemId == resource.data.destinationItemId
          && movement.sourceLineId == transferLineId
          && movement.movementType == 'TRANSFER_IN'
          && movement.quantityDelta == request.resource.data.quantityAccepted;
      }
      function validTransferLineUpdate() {
        let data = request.resource.data;
        let before = resource.data;
        return isAuthenticated()
        && isTenantMember(before.tenantId)
        && isTenantMember(data.tenantId)
        && data.tenantId == before.tenantId
        && data.inventoryClass == before.inventoryClass
        && data.transferId == before.transferId
        && data.masterItemId == before.masterItemId
        && data.sourceItemId == before.sourceItemId
        && data.destinationItemId == before.destinationItemId
        && data.quantityDispatched == before.quantityDispatched
        && data.unitCostUGX == before.unitCostUGX
        && data.totalValueUGX == before.totalValueUGX
        && data.get('sourceOrderLineId', '') == before.get('sourceOrderLineId', '')
        && data.dispatchMovementId == before.dispatchMovementId
        && data.receiptMovementId == before.receiptMovementId
        && isOperationalInventoryEnabled(before.tenantId)
        && ((isProcurement()
            && before.status == 'prepared'
            && data.status == 'dispatched'
            && (before.sourceItemId == 'SUPPLIER_TRANSIT' ? validDirectSupplierLine() : (exists(dispatchMovementPath())
            && get(dispatchMovementPath()).data.tenantId == before.tenantId
            && get(dispatchMovementPath()).data.itemId == before.sourceItemId
            && get(dispatchMovementPath()).data.sourceLineId == transferLineId
            && get(dispatchMovementPath()).data.movementType == 'TRANSFER_OUT')))
          || (isInventoryOperator()
            && isAssignedToBranch(before.destinationBranchId)
            && before.status == 'dispatched'
            && data.status in ['received', 'queried']
            && data.quantityAccepted is number
            && data.quantityQueried is number
            && data.quantityAccepted >= 0
            && data.quantityQueried >= 0
            && data.quantityAccepted + data.quantityQueried == before.quantityDispatched
            && ((data.quantityAccepted == 0 && data.quantityQueried == before.quantityDispatched)
              || validAcceptedReceiptMovement()))
          || (isProcurement()
            && get(transferPath()).data.transferType == 'BRANCH_RETURN'
            && before.status == 'dispatched'
            && data.status == 'received'
            && data.quantityAccepted == before.quantityDispatched
            && data.quantityQueried == 0
            && validAcceptedReceiptMovement()
            && getAfter(receiptMovementPath()).data.sourceTransactionId == before.transferId));
      }
      allow update: if validTransferLineUpdate();
      allow delete: if false;
    }

    match /operational_inventory_usage/{usageId} {
      // First-time idempotent usage transactions must be able to check a missing
      // deterministic usage ID. Existing documents stay tenant/branch scoped.
      allow get: if isAuthenticated() && (resource == null ||
        (isTenantMember(resource.data.tenantId)
          && (isProcurement() || isAssignedToBranch(resource.data.branchId))));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.branchId));
      allow create: if isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType == 'CONSUMABLE_OPERATIONAL'
        && isAssignedToBranch(request.resource.data.branchId)
        && request.resource.data.idempotencyKey is string
        && usageId == 'opusage_' + request.resource.data.idempotencyKey
        && request.resource.data.issuedAmount is number
        && request.resource.data.issuedAmount > 0
        && request.resource.data.cost is number
        && request.resource.data.cost >= 0
        && request.resource.data.department is string
        && request.resource.data.purpose is string
        && request.resource.data.reference is string
        && request.resource.data.inventoryId is string
        && exists(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId))
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.tenantId == request.resource.data.tenantId
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.branchId == request.resource.data.branchId
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.inventoryClass == 'OPERATIONAL'
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.operationalType == 'CONSUMABLE_OPERATIONAL'
        && existsAfter(/databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId))
        && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId)).data.sourceTransactionId == usageId
        && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId)).data.movementType == 'USAGE'
        && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId)).data.quantityDelta == -request.resource.data.issuedAmount;
      allow update, delete: if false;
    }

    match /operational_inventory_maintenance/{maintenanceId} {
      allow read: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.branchId));
      allow create: if isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && request.resource.data.inventoryId is string
        && exists(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId))
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.tenantId == request.resource.data.tenantId;
      allow update: if isInventoryOperator()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && isAssignedToBranch(resource.data.branchId)
        && isOperationalInventoryEnabled(resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId) && isOperationalInventoryEnabled(resource.data.tenantId);
    }

    match /products/{productId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'SELLABLE';
      allow update: if isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && (!('productId' in resource.data) || request.resource.data.productId == resource.data.productId)
        && (!('sku' in resource.data) || request.resource.data.sku == resource.data.sku)
        && (!('inventoryClass' in resource.data) || request.resource.data.inventoryClass == resource.data.inventoryClass)
        && (!('inventoryClass' in request.resource.data) || request.resource.data.inventoryClass == 'SELLABLE')
        && (
          (isPOSOperator()
            && (
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
                && request.resource.data.stock is number
                && request.resource.data.stock >= 0
              ) ||
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'quantityInStock', 'stockAggregateSource', 'updatedAt'])
                && request.resource.data.stock is number
                && request.resource.data.quantityInStock is number
                && request.resource.data.stock >= 0
                && request.resource.data.quantityInStock >= 0
                && request.resource.data.stock == request.resource.data.quantityInStock
                && request.resource.data.stockAggregateSource == 'product_batches'
              )
            )) ||
          isInventoryOperator()
        );
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /product_batches/{batchId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isInventoryOperator() && isTenantMember(request.resource.data.tenantId)
        && (
          !("sourceType" in request.resource.data) ||
          request.resource.data.sourceType != 'opening_stock' ||
          (
            ("openingStockSessionId" in request.resource.data) &&
            ("openingStockLineIndex" in request.resource.data) &&
            request.resource.data.openingStockLineIndex is int &&
            request.resource.data.openingStockLineIndex >= 0 &&
            getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.status in ['fully_accepted', 'closed_with_queries'] &&
            getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.tenantId == request.resource.data.tenantId &&
            getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.branchId == request.resource.data.branchId &&
            getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.receivedBy == request.auth.uid &&
            request.resource.data.openingStockLineIndex < getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines.size() &&
            request.resource.data.productId == getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines[request.resource.data.openingStockLineIndex].productId &&
            request.resource.data.batchNumber == getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines[request.resource.data.openingStockLineIndex].batchNumber &&
            request.resource.data.expiryDate == getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines[request.resource.data.openingStockLineIndex].expiryDate &&
            request.resource.data.quantity == getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.receiptResults[request.resource.data.openingStockLineIndex].acceptedQuantity &&
            request.resource.data.quantity <= getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines[request.resource.data.openingStockLineIndex].quantity
          )
        );
      allow update: if isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && (
          (isPOSOperator()
            && isAssignedToBranch(resource.data.branchId)
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']) ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'lastUpdated'])
            )
            && request.resource.data.quantity is number
            && request.resource.data.quantity >= 0) ||
          isInventoryOperator() ||
          (isQA()
            && (hasAnyRole(['QA Head', 'QA Manager', 'admin', 'Admin']) || isAdmin() || isAssignedToBranch(resource.data.branchId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['batch_status', 'lastUpdated'])
            && request.resource.data.batch_status == 'quarantined')
        );
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /opening_stock_sessions/{sessionId} {
      function isAssignedBranchManager(branchId) {
        return isAuthenticated()
          && (hasRole('Branch Manager') || hasRole('branch manager') || hasRole('admin'))
          && (
            (("assigned_branches" in getUserData()) && getUserData().assigned_branches.hasAny([branchId])) ||
            (("branch_id" in getUserData()) && getUserData().branch_id == branchId) ||
            (("default_branch_id" in getUserData()) && getUserData().default_branch_id == branchId)
          );
      }

      allow read: if isTenantMember(resource.data.tenantId);

      allow create: if isTenantMember(request.resource.data.tenantId)
        && sessionId == request.resource.data.tenantId + '_' + request.resource.data.branchId
        && (hasBranchManagerRole() || hasProcurementRole())
