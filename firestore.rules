      allow get: if isAuthenticated()
        && (resource == null || isTenantMember(resource.data.tenantId))
        && (isPOSOperator() || canViewFinance() || isIT());
      allow list: if isAuthenticated()
        && isTenantMember(resource.data.tenantId)
        && (canViewFinance() || isIT());
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && hasValidOutboxEnvelope(eventId)
        && outboxMatchesSale(eventId)
        && outboxMatchesPayment();
      allow update: if atomicOutboxSupersession(eventId);
      allow delete: if false;
    }

    match /pos_checkout_attempts/{attemptDocumentId} {
      function hasValidAttemptEnvelope() {
        let attempt = request.resource.data;
        return attempt.operatorUid == request.auth.uid
          && attempt.branchId is string
          && attempt.status == 'completed'
          && attempt.attemptId is string
          && attempt.fingerprint is string
          && attempt.saleId is string
          && attempt.paymentId is string
          && attempt.outboxEventId is string;
      }

      function attemptMatchesSale() {
        let attempt = request.resource.data;
        let sale = getAfter(/databases/$(database)/documents/sales/$(attempt.saleId)).data;
        return sale.engineVersion == 2
          && sale.tenantId == attempt.tenantId
          && sale.branchId == attempt.branchId
          && sale.operatorUid == request.auth.uid
          && sale.checkoutAttemptId == attempt.attemptId
          && sale.checkoutIntentFingerprint == attempt.fingerprint
          && sale.canonicalPaymentId == attempt.paymentId
          && sale.transactionOutboxEventId == attempt.outboxEventId;
      }

      function attemptMatchesPayment() {
        let attempt = request.resource.data;
        let payment = getAfter(/databases/$(database)/documents/pos_payments/$(attempt.paymentId)).data;
        return payment.saleId == attempt.saleId
          && payment.checkoutAttemptId == attempt.attemptId
          && payment.tenantId == attempt.tenantId
          && payment.branchId == attempt.branchId;
      }

      function attemptMatchesOutbox() {
        let attempt = request.resource.data;
        let outbox = getAfter(/databases/$(database)/documents/pos_transaction_outbox/$(attempt.outboxEventId)).data;
        return outbox.saleId == attempt.saleId
          && outbox.paymentId == attempt.paymentId
          && outbox.tenantId == attempt.tenantId
          && outbox.branchId == attempt.branchId
          && (outbox.status == 'PENDING' || (outbox.status == 'PROCESSED' && isFreshAtomicRevision(attempt.revisionRequestId)));
      }

      allow get: if isPOSOperator() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if false;
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && hasValidAttemptEnvelope()
        && attemptMatchesSale()
        && attemptMatchesPayment()
        && attemptMatchesOutbox();
      allow update, delete: if false;
    }

    match /pos_sale_revision_requests/{requestId} {
      function hasValidRevisionRequestEnvelope() {
        let revision = request.resource.data;
        return revision.keys().hasOnly([
            'requestType', 'engineVersion', 'payloadVersion', 'status',
            'requestId', 'revisionId', 'tenantId', 'branchId',
            'originalSaleId', 'originalReceiptNumber', 'originalSellerId', 'originalTimestamp',
            'requestedBy', 'requestedByName', 'requestedByRole', 'reason', 'sequence',
            'replacementAttemptId', 'replacementSaleId', 'pendingReplacementSaleId',
            'replacementPaymentId', 'replacementOutboxEventId', 'reversalEventId', 'auditId',
            'originalTotal', 'revisedTotal', 'monetaryDelta', 'adjustmentDirection',
            'changeTypes', 'itemChanges', 'before', 'after', 'revisedItems', 'envelope'
          ])
          && revision.requestId == requestId
          && revision.requestType == 'POS_SALE_REVISION_REQUESTED'
          && revision.engineVersion == 2
          && revision.payloadVersion == 1
          && revision.status == 'PENDING'
          && revision.revisionId is string
          && revision.revisionId.size() > 0
          && revision.tenantId is string
          && revision.tenantId.size() > 0
          && revision.branchId is string
          && revision.branchId.size() > 0
          && revision.originalSaleId is string
          && revision.originalSaleId.size() > 0
          && revision.originalReceiptNumber is string
          && revision.originalReceiptNumber.size() > 0
          && revision.requestedBy == request.auth.uid
          && revision.requestedByName is string
          && revision.requestedByName.size() > 0
          && revision.reason is string
          && revision.reason.size() >= 8
          && revision.reason.size() <= 500
          && revision.sequence is int
          && revision.sequence >= 1
          && revision.replacementAttemptId is string
          && revision.replacementSaleId is string
          && revision.pendingReplacementSaleId == revision.replacementSaleId
          && revision.replacementPaymentId is string
          && revision.replacementOutboxEventId is string
          && revision.reversalEventId is string
          && revision.auditId is string
          && revision.originalTotal is number
          && revision.revisedTotal is number
          && revision.monetaryDelta is number
          && revision.revisedTotal - revision.originalTotal == revision.monetaryDelta
          && revision.adjustmentDirection in ['INCREASE', 'DECREASE', 'NO_VALUE_CHANGE']
          && revision.changeTypes is list
          && revision.itemChanges is list
          && revision.revisedItems is list
          && revision.revisedItems.size() > 0
          && revision.before is map
          && revision.after is map
          && revision.envelope is map;
      }

      allow get: if isAuthenticated() && (
        resource == null ||
        (
          isTenantMember(resource.data.tenantId)
          && (
            canViewGlobalRevisionLedger() ||
            canViewBranchRevisionLedger(resource.data.branchId)
          )
        )
      );
      allow list: if isAuthenticated()
        && isTenantMember(resource.data.tenantId)
        && (
          canViewGlobalRevisionLedger() ||
          canViewBranchRevisionLedger(resource.data.branchId)
        );
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && (hasValidRevisionRequestEnvelope() || hasAtomicCorrectionChain(requestId));
      // Revision lifecycle transitions are owned exclusively by the Admin SDK workers.
      allow update, delete: if false;
    }

    match /pos_payment_reversals/{reversalId} {
      allow get: if isPOSOperator() && (resource == null || resource.data.tenantId == getUserData().tenantId);
      allow create: if request.resource.data.reversalId == reversalId && atomicPaymentReversal();
      allow update, delete: if false;
    }

    match /welfare/{recordId} {
      allow create: if atomicWelfareRecord(recordId, 'welfare');
    }
    match /cashTransfers/{recordId} {
      allow create: if atomicWelfareRecord(recordId, 'cashTransfers');
    }
    match /clients/{clientId} {
      allow update: if atomicWelfareBalance(clientId);
    }
    match /{collectionName}/{reversalId} {
      allow get: if collectionName in ['pos_welfare_reversals', 'pos_credit_reversals', 'pos_quotation_reversals']
        && isPOSOperator() && (resource == null || resource.data.tenantId == getUserData().tenantId);
      allow create: if collectionName in ['pos_welfare_reversals', 'pos_credit_reversals', 'pos_quotation_reversals']
        && atomicFinancialReversal(reversalId, collectionName);
    }

    match /audit_logs/{auditId} {
      allow read: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId;
      allow create: if isAuthenticated() && request.resource.data.tenantId == getUserData().tenantId
        && (!('revisionRequestId' in request.resource.data) ||
          (isFreshAtomicRevision(request.resource.data.revisionRequestId)
          && request.resource.data.userId == request.auth.uid));
      allow update: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId
        && !('revisionRequestId' in resource.data) && !('revisionRequestId' in request.resource.data);
      allow delete: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId && !('revisionRequestId' in resource.data);
    }
    match /sale_revisions/{revisionId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.tenantId == getUserData().tenantId);
      allow list: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId;
      allow create: if isAuthenticated() && request.resource.data.tenantId == getUserData().tenantId
        && (!('revisionRequestId' in request.resource.data) || isFreshAtomicRevision(request.resource.data.revisionRequestId));
      allow update: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId
        && !('revisionRequestId' in resource.data) && !('revisionRequestId' in request.resource.data);
      allow delete: if isAuthenticated() && resource.data.tenantId == getUserData().tenantId && !('revisionRequestId' in resource.data);
    }

    match /welfare_records/{recordId} {
      allow get: if (isHR() || isFinance()) && resource == null;
      allow read: if welfareScope(resource.data);
      allow create: if isHR() && welfareScope(request.resource.data)
        && request.resource.data.keys().hasOnly(['id','tenantId','staffId','branchId','amountUGX','reason','actorUid','kind','status','createdAt'])
        && recordId == request.resource.data.id && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.staffId != request.auth.uid && request.resource.data.kind == 'BENEFIT' && request.resource.data.status == 'Requested'
        && request.resource.data.amountUGX is int && request.resource.data.amountUGX > 0 && request.resource.data.amountUGX <= 9007199254740991
        && request.resource.data.createdAt == request.time && request.resource.data.reason is string && request.resource.data.reason.size() >= 5
        && get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.tenantId == request.resource.data.tenantId
        && get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.branch_id == request.resource.data.branchId;
      allow update, delete: if false;
      match /approval/{approvalId} {
        allow read: if resource == null ? (isHR() || isFinance()) : welfareScope(resource.data.snapshot);
        allow create: if approvalId == 'current' && isCEO() && getUserData().tenantId == request.resource.data.tenantId
          && request.resource.data.snapshot == get(/databases/$(database)/documents/welfare_records/$(recordId)).data
          && request.resource.data.snapshot.actorUid != request.auth.uid && request.resource.data.snapshot.staffId != request.auth.uid
          && request.resource.data.tenantId == request.resource.data.snapshot.tenantId && request.resource.data.branchId == request.resource.data.snapshot.branchId
          && request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt == request.time
          && request.resource.data.reason is string && request.resource.data.reason.size() >= 5
          && request.resource.data.decision in ['approved','rejected'];
        allow update, delete: if false;
      }
    }

    // Stock In physical receipt and its movement intent are committed together.
    // Branch operators can only create pending intents; analytics replay is
    // a restricted pending -> processed transition for the same tenant/branch.
    match /sellable_receipt_movement_outbox/{intentId} {
      allow get: if isStockOperator() &&
        (resource == null || (isTenantMember(resource.data.tenantId) && isAssignedToBranch(resource.data.branchId)));
      allow list: if isStockOperator() && isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(resource.data.branchId);
      allow create: if isStockOperator() && isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && request.resource.data.status == 'pending'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.quantityBaseUnits is int
        && request.resource.data.quantityBaseUnits > 0
        && request.resource.data.transferId is string
        && request.resource.data.lineId is string
        && intentId == 'sellable_stockin_' + request.resource.data.transferId + '_' + request.resource.data.lineId
        && existsAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId))
        && getAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId)).data.destination_branch_id == request.resource.data.branchId
        && getAfter(/databases/$(database)/documents/transfer_invoices/$(request.resource.data.transferId)).data.status in ['fully_accepted', 'queried'];
      allow update: if isStockOperator() && isInventoryOperator()
        && isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(resource.data.branchId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'processed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processedAt']);
      allow delete: if false;
    }

    match /inventoryMovementEvents/{eventId} {
      allow read: if canGetOptionalTenantRecord();
      allow create: if isTenantMember(request.resource.data.tenantId);
      allow update, delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /branchConsumptionDaily/{summaryId} {
      allow read: if canGetOptionalTenantRecord();
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /replenishmentEngineSettings/{settingsId} {
      allow read: if canGetOptionalTenantRecord();
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /branchReplenishmentSnapshots/{snapId} {
      allow read: if canGetOptionalTenantRecord();
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /inventoryTransferReservations/{resId} {
      allow read: if canGetOptionalTenantRecord();
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /autoGenerateOrderRuns/{runId} {
      allow read: if canGetOptionalTenantRecord();
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /autoGenerateOrderLines/{lineId} {
      allow read: if canGetOptionalTenantRecord();
      allow write: if isTenantMember(request.resource.data.tenantId);
    }

    match /pos_quotations/{quotationId} {
      allow get: if isAuthenticated() && (resource == null || (isTenantMember(resource.data.tenantId) && (isAssignedToBranch(resource.data.branchId) || isAdmin())));
      allow list: if isTenantMember(resource.data.tenantId) && (isAssignedToBranch(resource.data.branchId) || isAdmin());
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && get(/databases/$(database)/documents/branches/$(request.resource.data.branchId)).data.tenantId == request.resource.data.tenantId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'Draft';
      allow update: if isPOSOperator()
        && isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(resource.data.branchId)
        && get(/databases/$(database)/documents/branches/$(resource.data.branchId)).data.tenantId == resource.data.tenantId
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'convertedReceiptId', 'convertedAt', 'convertedValue', 'updatedAt'])
        && (request.resource.data.status in ['Converted', 'Expired']);
      allow delete: if false; // quotations are never hard-deleted
    }

    match /pos_quotation_counters/{counterId} {
      allow get: if isAuthenticated() && (resource == null || (isTenantMember(resource.data.tenantId) && (isAssignedToBranch(resource.data.branchId) || isAdmin())));
      allow create: if isPOSOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && get(/databases/$(database)/documents/branches/$(request.resource.data.branchId)).data.tenantId == request.resource.data.tenantId;
      allow update: if isPOSOperator()
        && isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(resource.data.branchId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.branchCode == resource.data.branchCode
        && request.resource.data.year == resource.data.year
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSequence', 'updatedAt'])
        && request.resource.data.lastSequence > resource.data.lastSequence
        && request.resource.data.lastSequence <= resource.data.lastSequence + 100;
      allow delete: if false;
    }



    // Write-once financial approval history. Only an authenticated procurement
    // operator can create it alongside the order's atomic approved transition.
    match /procurement_approval_audit/{approvalId} {
      allow get: if isProcurement() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && canViewProcurement();
      allow create: if isProcurement()
        && isTenantMember(request.resource.data.tenantId)
        && approvalId == 'approval_' + request.resource.data.orderId
        && request.resource.data.actorId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId))
        && getAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId)).data.approved_by == request.auth.uid
        && getAfter(/databases/$(database)/documents/stock_orders/$(request.resource.data.orderId)).data.approval_audit_id == approvalId;
      allow update, delete: if false;
    }

    // Generic tenant fallback. Dedicated collections retain their explicit rules.
    // Share exclusions and dispatch by method instead of compiling five copies.
    match /{collectionName}/{docId} {
      function dedicatedCollection() {
        return collectionName in ['payroll_approvals','identity_sequence_counters','branches','supplier_registry','opening_stock_sessions','transfer_invoices','transfer_invoice_lines','stock_orders','stock_order_lines','hiring_applications','practical_assessments','disciplinary_incidents','appraisals','pos_checkout_attempts','pos_payments','pos_transaction_outbox','pos_quotations','pos_quotation_counters','operational_inventory','operational_inventory_masters','operational_inventory_identity_claims','operational_inventory_identity_state','operational_inventory_usage','operational_inventory_maintenance','operational_inventory_movements','operational_transfers','operational_transfer_lines','grn_records','operational_grn_lines','operational_finance_events','operational_inventory_migration_audit','operational_inventory_identity_events','procurement_approval_audit','sellable_receipt_movement_outbox','payroll','payslips','advance_requests','attendance'];
      }
      function dedicatedWriteCollection() {
        return dedicatedCollection() || collectionName in ['hr_roles', 'product_batches', 'products', 'role_realms_of_operation', 'sales', 'payroll', 'payslips', 'advance_requests', 'attendance'];
      }
      function immutableFallbackIdentities() {
        return true
        && (collectionName != 'staff' || !('employee_id' in resource.data)
          || request.resource.data.employee_id == resource.data.employee_id)
        && (collectionName != 'staff' || !('staff_code' in resource.data)
          || request.resource.data.staff_code == resource.data.staff_code)
        && (collectionName != 'clients' || !('patient_code' in resource.data)
          || request.resource.data.patient_code == resource.data.patient_code)
        && (collectionName != 'prescribers' || !('prescriber_code' in resource.data)
          || request.resource.data.prescriber_code == resource.data.prescriber_code)
        && (collectionName != 'institutions' || !('institution_code' in resource.data)
          || request.resource.data.institution_code == resource.data.institution_code);
      }
      allow read: if !dedicatedCollection() && !isProtectedFinanceCollection(collectionName)
        && isAuthenticated()
        && ((request.method == 'get' && resource == null) || isTenantMember(resource.data.tenantId));
      allow write: if !dedicatedWriteCollection() && !isProtectedFinanceCollection(collectionName)
        && (request.method == 'delete'
          ? (isAdmin() && isTenantMember(resource.data.tenantId))
          : (isTenantMember(request.resource.data.tenantId)
            && (request.method == 'create'
              || (request.method == 'update' && isTenantMember(resource.data.tenantId) && immutableFallbackIdentities()))));
    }
  }
}

