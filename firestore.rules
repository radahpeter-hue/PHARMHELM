rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }
    function canGetOptionalTenantRecord() {
      return isAuthenticated() && (resource == null || isTenantMember(resource.data.tenantId));
    }

    // Check membership in primary or secondary roles
    function hasRole(roleName) {
      return hasAnyRole([roleName]);
    }

    function hasAnyRole(roleNames) {
      let user = getUserData();
      return user.role in roleNames || (("secondaryRoles" in user) && user.secondaryRoles.hasAny(roleNames));
    }

    // The staff document is authoritative for operational roles, secondary roles
    // and branch assignments. Token claims are used only during initial linking.
    function getUserData() {
      let staffPath = /databases/$(database)/documents/staff/$(request.auth.uid);
      return exists(staffPath) ? get(staffPath).data : {
        'role': request.auth.token.get('role', ''), 'tenantId': request.auth.token.get('tenantId', ''),
        'secondaryRoles': request.auth.token.get('roles', request.auth.token.get('secondaryRoles', [])), 'assigned_branches': []
      };
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        getUserData().get('tenantId', request.auth.token.get('tenantId', '')) == tenantId
        || request.auth.token.get('email', '') in ['peterssentongo61@gmail.com', 'peter.sentongo@pharmhelm', 'peter.sentongo@pharmhelm.com']
      );
    }

    // The tenant-scoped settings document is the authoritative operational
    // inventory feature gate. Missing or malformed settings fail closed.
    function isOperationalInventoryEnabled(tenantId) {
      let settingsPath = /databases/$(database)/documents/system_settings/$(tenantId);
      let configured = exists(settingsPath);
      let settings = configured ? get(settingsPath).data : {};
      return configured
        && settings.tenantId == tenantId
        && ('featureToggles' in settings)
        && settings.featureToggles is map
        && ('enableOperationalInventory' in settings.featureToggles)
        && settings.featureToggles.enableOperationalInventory == true;
    }

    function isOperationalInventoryClass(data) {
      return ('inventoryClass' in data) && data.inventoryClass == 'OPERATIONAL';
    }

    function isOperationalOrderData(data) {
      return data.category == 'non_sellable' || isOperationalInventoryClass(data);
    }

    function canOperateOperationalLocation(branchId) {
      return branchId == 'HQ'
        ? (isProcurement() || isAssignedToBranch('HQ'))
        : isAssignedToBranch(branchId);
    }

    function isAdmin() {
      let roles = ['owner', 'Owner', 'CEO', 'ceo', 'CEO / MD', 'ceo / md'];
      return isAuthenticated() && (
        request.auth.token.get('email', '') in ['peterssentongo61@gmail.com', 'peter.sentongo@pharmhelm', 'peter.sentongo@pharmhelm.com']
        || hasAnyRole(roles)
      );
    }

    function isCEO() {
      return isAuthenticated() && (isAdmin() || hasAnyRole(['CEO', 'CEO / MD', 'owner']));
    }

    function isHR() {
      return isAuthenticated() && (hasAnyRole(['HR Head', 'HR Support Personnel', 'HR Manager', 'admin', 'Admin']) || hasCustomModuleFunctional('hr') || isAdmin());
    }

    function isFinance() {
      return isAuthenticated() && (hasAnyRole(['Finance Head', 'Finance Officer', 'Accountant', 'admin', 'Admin']) || hasCustomModuleFunctional('finance') || isAdmin());
    }

    function isLogisticsHead() {
      return isAuthenticated() && (hasAnyRole(['Logistics Head', 'Transport & Logistics Personnel', 'Logistics Manager', 'admin', 'Admin']) || hasCustomModuleFunctional('logistics') || isAdmin());
    }

    function isBranchManager() {
      return isAuthenticated() && (hasAnyRole(['Branch Manager', 'branch manager', 'admin']) || isAdmin());
    }

    function hasBranchManagerRole() {
      return isAuthenticated() && (
        hasAnyRole(['Branch Manager', 'branch manager', 'admin'])
      );
    }


    function isDepartmentHead() {
      return isAuthenticated() && (
        hasAnyRole([
          'Finance Head', 'Procurement Head', 'Logistics Head', 'Transport & Logistics Head',
          'Marketing Head', 'QA Head', 'HR Head', 'IT Head'
        ])
      );
    }

    function isPeopleSupervisor() {
      return (isBranchManager() || isDepartmentHead() || isAdmin());
    }

    function isAssignedToBranch(branchId) {
      let user = isAuthenticated() ? getUserData() : {};
      return isAuthenticated() && (
        (("assigned_branches" in user) && user.assigned_branches.hasAny([branchId])) ||
        (("branch_id" in user) && user.branch_id == branchId) ||
        (("default_branch_id" in user) && user.default_branch_id == branchId) ||
        isAdmin()
      );
    }

    function isQA() {
      return isAuthenticated() && (hasAnyRole(['QA Head', 'QA Officer', 'QA Manager', 'admin', 'Admin']) || hasCustomModuleFunctional('qa') || isAdmin());
    }

    function isITPersonnel() {
      return isAuthenticated() && (
        hasAnyRole(['IT Head', 'IT Support Staff', 'IT Support Personnel', 'IT Staff'])
      );
    }

    function isIT() {
      return isAuthenticated() && (isITPersonnel() || isAdmin());
    }

    function hasCustomModuleAccess(moduleKey, accessLevels) {
      let user = getUserData();
      let configuredId = user.get('roleRealmId', '');
      let realmId = configuredId is string && configuredId.size() > 0 ? configuredId
        : user.tenantId + '_' + user.role.replace('\\s+', '_').lower();
      let realmPath = /databases/$(database)/documents/role_realms_of_operation/$(realmId);
      let realm = exists(realmPath) ? get(realmPath).data : {};
      return isAuthenticated() && realm.get('tenantId', '') == user.tenantId
        && realm.get('roleType', '') == 'custom' && realm.get('roleName', '') == user.role
        && moduleKey in realm.get('permissions', {})
        && realm.permissions[moduleKey].accessLevel in accessLevels;
    }

    function hasCustomModuleFunctional(moduleKey) {
      return hasCustomModuleAccess(moduleKey, ['view_functional', 'all']);
    }

    function isSettingsAdmin() {
      return isAuthenticated() && (isAdmin() || isIT() || hasCustomModuleFunctional('settings'));
    }

    function isProcurement() {
      return isAuthenticated() && (
        hasAnyRole(['Procurement Head', 'Procurement Officer', 'Procurement Manager', 'Procurement Personnel']) ||
        hasCustomModuleFunctional('procurement') ||
        isAdmin()
      );
    }

    function hasProcurementRole() {
      return isAuthenticated() && (
        hasAnyRole(['Procurement Head', 'Procurement Officer', 'Procurement Manager', 'Procurement Personnel'])
      );
    }

    function isInventoryOperator() {
      return isAuthenticated() && (
        hasAnyRole([
          'Branch Manager', 'branch manager', 'Pharmacist', 'pharmacist',
          'Procurement Head', 'Procurement Officer', 'Procurement Manager', 'Procurement Personnel', 'admin', 'Admin'
        ]) ||
        hasCustomModuleFunctional('inventory') ||
        isAdmin()
      );
    }

    function isStockOperator() {
      return isAuthenticated() && (
        hasAnyRole([
          'Branch Manager', 'branch manager', 'Pharmacist', 'pharmacist',
          'Dispenser', 'dispenser', 'Procurement Head', 'Procurement Officer', 'Procurement Manager'
        ]) ||
        hasCustomModuleFunctional('stock') ||
        isAdmin()
      );
    }

    function hasActiveStaffProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && (
          (
            'active' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
          ) ||
          (
            'status' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status in ['active', 'Active', 'ACTIVE']
          )
        );
    }

    function isPOSOperator() {
      return isAuthenticated()
        && hasActiveStaffProfile()
        && getUserData().role != 'cashier'
        && getUserData().role != 'Cashier'
        && (
        hasAnyRole(['Pharmacist', 'pharmacist', 'Dispenser', 'dispenser', 'Branch Manager', 'branch manager']) ||
        hasCustomModuleFunctional('sales') ||
        isAdmin()
      );
    }

    // Fresh, append-only correction evidence authorizes only this atomic commit.
    function isFreshAtomicRevision(requestId) {
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(requestId)).data;
      let staff = getUserData();
      let operationalRoles = ['Pharmacist', 'pharmacist', 'Dispenser', 'dispenser', 'Branch Manager', 'branch manager'];
      let globalRoles = ['owner', 'Owner', 'CEO', 'ceo', 'CEO / MD', 'ceo / md'];
      let roles = staff.get('secondaryRoles', []);
      return isAuthenticated()
        && (staff.get('active', false) || staff.get('status', '') in ['active', 'Active', 'ACTIVE'])
        && !(staff.role in ['cashier', 'Cashier'])
        && (staff.role in operationalRoles || roles.hasAny(operationalRoles) || staff.role in globalRoles || roles.hasAny(globalRoles) || hasCustomModuleFunctional('sales'))
        && !exists(/databases/$(database)/documents/pos_sale_revision_requests/$(requestId))
        && correction.executionMode == 'SPARK_ATOMIC' && correction.status == 'COMPLETED'
        && correction.createdAt == request.time && correction.requestedBy == request.auth.uid
        && correction.tenantId == staff.tenantId
        && (staff.get('assigned_branches', []).hasAny([correction.branchId]) || staff.get('branch_id', '') == correction.branchId || staff.role in globalRoles || roles.hasAny(globalRoles));
    }

    function isAtomicOriginalUpdate(saleId) {
      let next = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(next.revisionRequestId)).data;
      return isFreshAtomicRevision(next.revisionRequestId)
        && resource.data.engineVersion == 2 && resource.data.status == 'completed'
        && resource.data.get('revisionId', '') == '' && !resource.data.get('revisionLocked', false)
        && resource.data.get('supersededBySaleId', '') == ''
        && resource.data.createdAt is timestamp
        && request.time >= resource.data.createdAt
        && request.time - resource.data.createdAt <= duration.value(72, 'h')
        && correction.originalSaleId == saleId
        && correction.tenantId == resource.data.tenantId && correction.branchId == resource.data.branchId
        && correction.originalTotal == resource.data.totalAmount
        && correction.originalPaymentId == resource.data.canonicalPaymentId
        && correction.originalOutboxEventId == resource.data.transactionOutboxEventId
        && next.revisionId == correction.revisionId
        && next.revisionLifecycle == 'COMPLETED' && next.revisionLocked == true
        && next.supersededBySaleId == correction.replacementSaleId
        && next.supersededByReceiptNumber == correction.replacementReceiptNumber
        && next.revisionRequestedBy == request.auth.uid
        && next.revisionReason == correction.reason
        && next.revisionCompletedAt == request.time
        && (!correction.originalCreditPosted || atomicCreditCommit(correction))
        && (!(correction.originalWelfarePosted || correction.welfareAmount > 0) || atomicWelfareCommit(correction, resource.data))
        && next.diff(resource.data).affectedKeys().hasOnly([
          'revisionId', 'revisionRequestId', 'revisionLocked', 'revisionLifecycle',
          'pendingReplacementSaleId', 'supersededBySaleId', 'supersededByReceiptNumber',
          'revisionReason', 'revisionRequestedBy', 'revisionRequestedByName',
          'revisionRequestedAt', 'revisionCompletedAt', 'updatedAt',
          'quotationConversionStatus', 'quotationConversionReversalId', 'quotationConversionReversedAt'
        ]);
    }

    function hasAtomicCorrectionChain(requestId) {
      let correction = request.resource.data;
      let original = getAfter(/databases/$(database)/documents/sales/$(correction.originalSaleId)).data;
      let replacement = getAfter(/databases/$(database)/documents/sales/$(correction.replacementSaleId)).data;
      let reversal = getAfter(/databases/$(database)/documents/pos_payment_reversals/$(correction.paymentReversalId)).data;
      let audit = getAfter(/databases/$(database)/documents/audit_logs/$(correction.auditId)).data;
      let outbox = getAfter(/databases/$(database)/documents/pos_transaction_outbox/$(correction.originalOutboxEventId)).data;
      return correction.requestId == requestId && isFreshAtomicRevision(requestId)
        && correction.requestType == 'POS_SALE_REVISION_REQUESTED'
        && correction.engineVersion == 2 && correction.payloadVersion == 1
        && correction.reason is string && correction.reason.size() >= 8 && correction.reason.size() <= 500
        && correction.intentFingerprint is string && correction.intentFingerprint.size() > 0
        && correction.completedAt == request.time
        && original.revisionRequestId == requestId && original.supersededBySaleId == correction.replacementSaleId
        && original.tenantId == correction.tenantId && original.branchId == correction.branchId
        && original.receiptNumber == correction.originalReceiptNumber
        && correction.originalWelfarePosted == (original.get('welfarePostingStatus', '') == 'posted')
        && correction.originalCreditPosted == exists(/databases/$(database)/documents/credit_receivables/$(correction.originalSaleId))
        && replacement.revisionOfSaleId == correction.originalSaleId && replacement.revisionRequestId == requestId
        && replacement.revisionId == correction.revisionId
        && replacement.tenantId == correction.tenantId && replacement.branchId == correction.branchId
        && replacement.canonicalPaymentId == correction.replacementPaymentId
        && replacement.transactionOutboxEventId == correction.replacementOutboxEventId
        && replacement.operatorUid == request.auth.uid
        && replacement.totalAmount == correction.revisedTotal
        && replacement.total == correction.revisedTotal
        && replacement.receiptNumber == correction.replacementReceiptNumber
        && correction.revisedTotal - correction.originalTotal == correction.monetaryDelta
        && reversal.originalSaleId == correction.originalSaleId && reversal.revisionId == correction.revisionId
        && reversal.status == 'COMPLETED' && reversal.amountDelta == -correction.originalTotal
        && audit.userId == request.auth.uid && audit.objectId == correction.originalSaleId
        && audit.revisionRequestId == requestId && audit.reason == correction.reason && audit.createdAt == request.time
        && outbox.status == 'SUPERSEDED' && outbox.revisionRequestId == requestId;
    }

    function atomicPaymentReversal() {
      let row = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId)).data;
      let payment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      return isFreshAtomicRevision(row.atomicRevisionRequestId)
        && row.reversalId == correction.paymentReversalId
        && row.originalPaymentId == correction.originalPaymentId
        && row.originalSaleId == correction.originalSaleId && row.revisionId == correction.revisionId
        && row.tenantId == correction.tenantId && row.branchId == correction.branchId
        && row.requestedBy == request.auth.uid && row.reason == correction.reason
        && row.source == 'POS_REVISION' && row.engineVersion == 2
        && row.status == 'COMPLETED' && row.completedAt == request.time
        && row.amountDelta == -payment.amount && row.settledDelta == -payment.settledAmount
        && row.outstandingDelta == -payment.outstandingAmount;
    }

    function atomicOutboxSupersession(eventId) {
      let next = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(next.revisionRequestId)).data;
      return isFreshAtomicRevision(next.revisionRequestId)
        && eventId == correction.originalOutboxEventId
        && resource.data.saleId == correction.originalSaleId
        && resource.data.paymentId == correction.originalPaymentId
        && resource.data.tenantId == correction.tenantId && resource.data.branchId == correction.branchId
        && resource.data.status != 'SUPERSEDED'
        && next.status == 'SUPERSEDED' && next.supersededByEventId == correction.replacementOutboxEventId
        && next.leaseOwner == null && next.leaseExpiresAt == null
        && next.diff(resource.data).affectedKeys().hasOnly(['status', 'supersededByEventId', 'revisionRequestId', 'leaseOwner', 'leaseExpiresAt', 'updatedAt']);
    }

    function canReadPosFinancial() {
      let row = resource.data;
      let saleId = row.get('saleId', row.get('receipt_id', ''));
      let sale = get(/databases/$(database)/documents/sales/$(saleId)).data;
      return isPOSOperator() && sale.engineVersion == 2
        && sale.tenantId == getUserData().tenantId && row.tenantId == sale.tenantId
        && isAssignedToBranch(sale.branchId);
    }

    function atomicCreditCreate(receivableId) {
      let row = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId)).data;
      let payment = getAfter(/databases/$(database)/documents/pos_payments/$(correction.replacementPaymentId)).data;
      return isFreshAtomicRevision(row.atomicRevisionRequestId)
        && receivableId == correction.replacementSaleId && row.receipt_id == receivableId
        && row.tenantId == correction.tenantId && row.branch_id == correction.branchId
        && row.paymentId == correction.replacementPaymentId && row.source == 'POS' && row.engineVersion == 2
        && payment.paymentMethod == 'institutional_credit' && row.amount_ugx == payment.amount
        && row.outstanding_ugx == row.amount_ugx && row.status == 'outstanding';
    }

    function atomicCreditUpdate(receivableId) {
      let row = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId)).data;
      let payment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      return isFreshAtomicRevision(row.atomicRevisionRequestId)
        && receivableId == correction.originalSaleId && resource.data.receipt_id == receivableId
        && resource.data.tenantId == correction.tenantId && resource.data.branch_id == correction.branchId
        && payment.paymentMethod == 'institutional_credit'
        && resource.data.amount_ugx == payment.amount && resource.data.outstanding_ugx == payment.amount
        && row.outstanding_ugx == 0 && row.status == 'reversed'
        && row.revisionId == correction.revisionId
        && row.reversalId == correction.creditReversal.reversalId
        && getAfter(/databases/$(database)/documents/pos_credit_reversals/$(row.reversalId)).data.amountDelta == -payment.amount
        && row.diff(resource.data).affectedKeys().hasOnly(['status', 'outstanding_ugx', 'reversalId', 'revisionId', 'reversedAmount', 'reversedAt', 'reversedBy', 'reversedByName', 'reversalReason', 'updatedAt', 'atomicRevisionRequestId']);
    }

    function atomicWelfareRecord(recordId, collectionName) {
      let row = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId)).data;
      let replacement = row.saleId == correction.replacementSaleId;
      let expectedId = replacement
        ? (collectionName == 'welfare' ? correction.replacementWelfareId : collectionName == 'branch_expenses' ? correction.replacementWelfareExpenseId : correction.replacementWelfareTransferId)
        : (collectionName == 'welfare' ? correction.welfareReversal.welfareId : collectionName == 'branch_expenses' ? correction.welfareReversal.expenseId : correction.welfareReversal.transferId);
      let expectedAmount = replacement ? correction.welfareAmount : correction.welfareReversal.amountDelta;
      return isFreshAtomicRevision(row.atomicRevisionRequestId)
        && recordId == expectedId && row.tenantId == correction.tenantId
        && row.saleId in [correction.originalSaleId, correction.replacementSaleId]
        && row.get('amountDelta', row.amount) == expectedAmount
        && expectedAmount != 0
        && (collectionName == 'cashTransfers' || row.branchId == correction.branchId)
        && (replacement || (row.revisionId == correction.revisionId && row.status == 'reversed'));
    }

    function atomicWelfareBalance(beneficiaryId) {
      let next = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(next.atomicRevisionRequestId)).data;
      let original = getAfter(/databases/$(database)/documents/sales/$(correction.originalSaleId)).data;
      let oldPayment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      let oldAmount = correction.originalWelfarePosted ? -oldPayment.components[0].amount : 0;
      let nextSpent = resource.data.get('welfare_spent', 0) + oldAmount + correction.welfareAmount;
      return isFreshAtomicRevision(next.atomicRevisionRequestId)
        && resource.data.tenantId == correction.tenantId
        && beneficiaryId == original.patientId
        && (correction.welfareAmount == 0 || beneficiaryId == correction.welfareBeneficiaryId)
        && next.welfare_spent == nextSpent && next.welfare_spent >= 0
        && next.welfare_used_ytd == resource.data.get('welfare_used_ytd', 0) + oldAmount + correction.welfareAmount
        && next.welfare_used_ytd >= 0
        && next.diff(resource.data).affectedKeys().hasOnly(['welfare_spent', 'welfare_used_ytd', 'updatedAt', 'atomicRevisionRequestId']);
    }

    function atomicFinancialPostingChain() {
      let payment = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(payment.revisionRequestId)).data;
      return isFreshAtomicRevision(payment.revisionRequestId)
        && (payment.paymentMethod != 'institutional_credit' ||
          (getAfter(/databases/$(database)/documents/credit_receivables/$(payment.saleId)).data.amount_ugx == payment.amount
          && getAfter(/databases/$(database)/documents/credit_receivables/$(payment.saleId)).data.outstanding_ugx == payment.amount))
        && (payment.paymentMethod != 'staff_welfare' ||
          (correction.welfareAmount == payment.components[0].amount
          && payment.components[0].method == 'staff_welfare'
          && getAfter(/databases/$(database)/documents/welfare/$(correction.replacementWelfareId)).data.amount == correction.welfareAmount
          && getAfter(/databases/$(database)/documents/branch_expenses/$(correction.replacementWelfareExpenseId)).data.amount == correction.welfareAmount
          && getAfter(/databases/$(database)/documents/cashTransfers/$(correction.replacementWelfareTransferId)).data.amount == correction.welfareAmount));
    }

    function atomicFinancialReversal(reversalId, collectionName) {
      let row = request.resource.data;
      let correction = getAfter(/databases/$(database)/documents/pos_sale_revision_requests/$(row.atomicRevisionRequestId)).data;
      let payment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      let expectedId = collectionName == 'pos_credit_reversals' ? correction.creditReversal.reversalId
        : collectionName == 'pos_welfare_reversals' ? correction.welfareReversal.reversalId : correction.quotationReversal.reversalId;
      return isFreshAtomicRevision(row.atomicRevisionRequestId)
        && reversalId == expectedId && row.revisionId == correction.revisionId
        && row.tenantId == correction.tenantId && row.branchId == correction.branchId
        && row.requestedBy == request.auth.uid && row.reason == correction.reason
        && row.status == 'COMPLETED' && row.completedAt == request.time
        && (collectionName == 'pos_quotation_reversals' || row.originalSaleId == correction.originalSaleId)
        && (collectionName != 'pos_credit_reversals' || row.amountDelta == -payment.amount)
        && (collectionName != 'pos_welfare_reversals' || row.amountDelta == -payment.components[0].amount);
    }

    function atomicCreditCommit(correction) {
      let before = get(/databases/$(database)/documents/credit_receivables/$(correction.originalSaleId)).data;
      let after = getAfter(/databases/$(database)/documents/credit_receivables/$(correction.originalSaleId)).data;
      let reversal = getAfter(/databases/$(database)/documents/pos_credit_reversals/$(correction.creditReversal.reversalId)).data;
      return before.tenantId == correction.tenantId && after.tenantId == correction.tenantId
        && before.outstanding_ugx == before.amount_ugx
        && after.outstanding_ugx == 0 && after.status == 'reversed'
        && reversal.originalSaleId == correction.originalSaleId
        && reversal.amountDelta == -before.amount_ugx;
    }

    function atomicWelfareCommit(correction, original) {
      let beneficiaryCollection = original.get('welfareBeneficiaryIsStaff', false) ? 'staff' : 'clients';
      let beneficiaryId = original.patientId;
      let before = get(/databases/$(database)/documents/$(beneficiaryCollection)/$(beneficiaryId)).data;
      let after = getAfter(/databases/$(database)/documents/$(beneficiaryCollection)/$(beneficiaryId)).data;
      let payment = get(/databases/$(database)/documents/pos_payments/$(correction.originalPaymentId)).data;
      let oldAmount = correction.originalWelfarePosted ? payment.components[0].amount : 0;
      return before.tenantId == correction.tenantId && after.tenantId == correction.tenantId
        && after.welfare_spent == before.get('welfare_spent', 0) - oldAmount + correction.welfareAmount
        && after.welfare_used_ytd == before.get('welfare_used_ytd', 0) - oldAmount + correction.welfareAmount
        && after.welfare_spent >= 0 && after.welfare_used_ytd >= 0
        && (correction.welfareAmount == 0 || correction.welfareBeneficiaryId == beneficiaryId)
        && (!correction.originalWelfarePosted ||
          (correction.welfareReversal.amountDelta == -oldAmount
          && getAfter(/databases/$(database)/documents/welfare/$(correction.welfareReversal.welfareId)).data.amount == -oldAmount
          && getAfter(/databases/$(database)/documents/branch_expenses/$(correction.welfareReversal.expenseId)).data.amount == -oldAmount
          && getAfter(/databases/$(database)/documents/cashTransfers/$(correction.welfareReversal.transferId)).data.amountDelta == -oldAmount
          && getAfter(/databases/$(database)/documents/pos_welfare_reversals/$(correction.welfareReversal.reversalId)).data.amountDelta == -oldAmount));
    }

    function isMarketing() {
      return isAuthenticated() && (
        hasAnyRole(['Marketing Head', 'Marketing Personnel', 'Marketing Manager', 'admin', 'Admin']) ||
        hasCustomModuleFunctional('marketing') || isAdmin()
      );
    }

    function hasCustomModuleView(moduleKey) {
      return hasCustomModuleAccess(moduleKey, ['view_only', 'view_functional', 'all']);
    }

    function canViewFinance() {
      return isFinance() || isITPersonnel() || hasCustomModuleView('finance');
    }

    function hasBranchFinanceRole() {
      return isAuthenticated() && (
        hasAnyRole(['Branch Manager', 'branch manager', 'Cashier', 'cashier'])
      );
    }

    function canViewBranchFinance() {
      return isAuthenticated() && (
        hasBranchFinanceRole() ||
        hasAnyRole(['Finance Head', 'Accountant', 'admin', 'Admin']) ||
        isITPersonnel() || hasCustomModuleView('finance') || isAdmin()
      );
    }

    function canOperateBranchFinance() {
      return isAuthenticated() && (
        hasBranchFinanceRole() ||
        hasAnyRole(['Finance Head', 'Accountant', 'admin', 'Admin']) ||
        hasCustomModuleFunctional('finance') || isAdmin()
      );
    }

    function isProtectedFinanceCollection(collectionName) {
      return collectionName in [
        'finance_v2_transfers','finance_v2_events','finance_v2_account_movements','finance_ledger', 'eod_reconciliations', 'branch_expenses', 'cash_requisitions',
        'credit_receivables', 'supplier_payables', 'banking_records', 'welfare_records', 'staff', 'leave_requests',
        'client_credit_ledger', 'institution_credit_ledger', 'supplier_credit_ledger',
        'petty_cash_ledger', 'finance_payment_accounts', 'cash_grn_payments', 'cashTransfers', 'invoices', 'procurement_invoices', 'creditPayments', 'financial_posting_audit', 'financial_metrics', 'management_expenses',
        'audit_logs', 'sale_revisions', 'pos_sale_revision_requests', 'pos_payment_reversals', 'pos_welfare_reversals', 'pos_credit_reversals', 'pos_quotation_reversals'
      ];
    }

    function canPostManagementCash() {
      return isAuthenticated() && (
        hasAnyRole(['Finance Head','Finance Officer','Accountant','HR Head','HR Support Personnel','HR Manager','Logistics Head','Transport & Logistics Personnel','Logistics Manager','Procurement Head','Procurement Officer','Procurement Manager','Procurement Personnel','admin','Admin'])
        || hasCustomModuleFunctional('finance') || hasCustomModuleFunctional('hr')
        || hasCustomModuleFunctional('logistics') || hasCustomModuleFunctional('procurement') || isAdmin());
    }
    function managementAccountPath(tenantId, kind) {
      return /databases/$(database)/documents/finance_payment_accounts/$(tenantId + (kind == 'bank' ? '_management_bank' : '_management_petty_cash'));
    }
    function managementMovementPath(kind, id) {
      return kind == 'bank'
        ? /databases/$(database)/documents/banking_records/$(id)
        : /databases/$(database)/documents/petty_cash_ledger/$(id);
    }
    function validManagementMovement(id, data, kind) {
      let accountPath = managementAccountPath(data.tenantId, kind);
      let before = get(accountPath).data;
      let after = getAfter(accountPath).data;
      return isTenantMember(data.tenantId)
        && (kind == 'bank' ? isFinance() : canPostManagementCash())
        && data.postedBy == request.auth.uid
        && data.amount is int && data.amount > 0
        && data.type in ['incoming','deposit','topup','outgoing','withdrawal']
        && data.accountDeltaUGX == (data.type in ['incoming','deposit','topup'] ? data.amount : -data.amount)
        && (data.accountDeltaUGX <= 0 || isFinance() || isHR())
        && data.accountDocumentId == data.tenantId + (kind == 'bank' ? '_management_bank' : '_management_petty_cash')
        && before.tenantId == data.tenantId && before.kind == kind && before.initialized == true
        && after.lastPostingId == id
        && after.balanceUGX == before.balanceUGX + data.accountDeltaUGX
        && after.balanceUGX >= 0;
    }
    function validManagementAccountUpdate(accountId, before, after) {
      let movementPath = managementMovementPath(before.kind, after.lastPostingId);
      let movement = getAfter(movementPath).data;
      return isTenantMember(before.tenantId)
        && (before.kind == 'bank' ? isFinance() : canPostManagementCash())
        && after.diff(before).affectedKeys().hasOnly(['balanceUGX','lastPostingId','updatedAt'])
        && before.initialized == true && before.currency == 'UGX' && before.controlVersion == 1
        && after.balanceUGX is int && after.balanceUGX >= 0 && after.balanceUGX <= 9007199254740991
        && after.lastPostingId is string && !exists(movementPath)
        && movement.tenantId == before.tenantId && movement.accountDocumentId == accountId
        && movement.postedBy == request.auth.uid
        && after.balanceUGX == before.balanceUGX + movement.accountDeltaUGX;
    }
    function supplierPaymentPath(id) {
      return /databases/$(database)/documents/cash_grn_payments/$(id);
    }
    function linkedSupplierPayment(data) {
      let paymentPath = supplierPaymentPath(data.lastPaymentId);
      let payment = getAfter(paymentPath).data;
      return isFinance() && isTenantMember(data.tenantId)
        && !exists(paymentPath) && payment.tenantId == data.tenantId
        && payment.processedBy == request.auth.uid;
    }
    function validSupplierInvoiceUpdate(id, before, after, legacy) {
      let payment = getAfter(supplierPaymentPath(after.lastPaymentId)).data;
      return linkedSupplierPayment(after)
        && (legacy ? payment.procurementInvoiceId == id : payment.invoiceId == id)
        && after.diff(before).affectedKeys().hasOnly(legacy
          ? ['paid_amount_ugx','paidAmountUGX','creditBalance','status','paymentStatus','updatedAt','lastPaymentReference','lastPaymentId']
          : ['paidAmountUGX','paymentStatus','creditBalance','updatedAt','lastPaymentReference','lastPaymentId'])
        && (legacy ? after.paid_amount_ugx : after.paidAmountUGX) == payment.previouslyPaidUGX + payment.amountUGX
        && after.paymentStatus == (payment.remainingUGX == 0 ? 'Paid' : 'Partially Paid')
        && after.creditBalance == payment.remainingUGX
        && (!legacy || after.paidAmountUGX == after.paid_amount_ugx);
    }
    function validSupplierGrnPayment(id, before, after) {
      let payment = getAfter(supplierPaymentPath(after.lastPaymentId)).data;
      return linkedSupplierPayment(after) && payment.grnId == id
        && before.payment_type == 'cash'
        && after.diff(before).affectedKeys().hasOnly(['payment_status','lastPaymentId','updatedAt'])
        && after.payment_status == (payment.remainingUGX == 0 ? 'paid' : 'partial');
    }
    // Spark-native V2 disbursements share the existing register and immutable V2 journal.
    // Transfers remain denied until their separate certification; this is liability settlement.
    function v2AccountChange(accountId, before, after) {
      let eventPath = /databases/$(database)/documents/finance_v2_events/$(after.lastPostingId);
      let event = getAfter(eventPath).data;
      return isFinance() && getUserData().tenantId == before.tenantId && isAssignedToBranch(before.branchId)
        && before.controlVersion == 2 && before.active == true && before.initialized == true && before.currency == 'UGX'
        && after.diff(before).affectedKeys().hasOnly(['balanceUGX','lastPostingId','updatedAt'])
        && !exists(eventPath) && event.accountId == before.accountId && event.tenantId == before.tenantId
        && accountId == before.tenantId + '_' + before.accountId && event.actorUid == request.auth.uid
        && event.beforeUGX == before.balanceUGX && event.afterUGX == after.balanceUGX
        && before.balanceUGX is int && before.balanceUGX <= 9007199254740991
        && after.balanceUGX is int && after.balanceUGX >= 0 && after.balanceUGX <= 9007199254740991 && after.updatedAt == request.time;
    }
    function v2AccountRegistration(accountId, d) {
      return isFinance() && getUserData().tenantId == d.tenantId && isAssignedToBranch(d.branchId)
        && get(/databases/$(database)/documents/system_settings/$(d.tenantId)).data.phase5SalarySettlementEnabled == true
        && accountId == d.tenantId + '_' + d.accountId && d.accountId.matches('^[A-Za-z0-9_-]{1,150}$')
        && !(d.accountId in ['management_bank','management_petty_cash'])
        && d.kind in ['BANK','BRANCH_CASH_SALES','PETTY_CASH','MTN_MOBILE_MONEY','AIRTEL_MONEY']
        && d.controlVersion == 2 && d.currency == 'UGX' && d.initialized == true && d.active == true
        && d.balanceUGX is int && d.openingBalanceUGX is int && d.balanceUGX == 0 && d.openingBalanceUGX == 0 && d.lastPostingId == null
        && d.salaryEligible is bool && d.salaryBranchIds is list && d.salaryBranchIds.size() <= 30
        && d.registeredBy == request.auth.uid && d.name is string && d.name.size() > 0 && d.name.size() <= 150
        && d.reconciliationReference is string && d.reconciliationReference.size() >= 5
        && d.createdAt == request.time && d.updatedAt == request.time;
    }
    match /finance_payment_accounts/{accountId}/opening/{stage} {
      allow read: if isFinance() && (resource == null || (getUserData().tenantId == resource.data.tenantId && isAssignedToBranch(resource.data.branchId)));
      allow create: if stage == 'request' ? openingRequest(accountId,request.resource.data) : (stage == 'approval' && openingApproval(accountId,request.resource.data));
      allow update, delete: if false;
    }
    function openingRequest(id,d) {
      let a = get(/databases/$(database)/documents/finance_payment_accounts/$(id)).data;
      return isFinance() && getUserData().tenantId == d.tenantId && isAssignedToBranch(d.branchId)
        && d.actorUid == request.auth.uid && d.createdAt == request.time && a.tenantId == d.tenantId && a.accountId == d.accountId && a.branchId == d.branchId
        && a.controlVersion == 2 && a.balanceUGX == 0 && a.lastPostingId == null && a.active == true
        && d.amountUGX is int && d.amountUGX > 0 && d.amountUGX <= 9007199254740991
        && d.externalReference.matches('^[A-Z0-9_.-]{3,100}$') && d.evidence is string && d.evidence.size() >= 10 && d.evidence.size() <= 1000;
    }
    function openingApproval(id,d) {
      return isCEO() && getUserData().tenantId == d.tenantId && isAssignedToBranch(d.branchId)
        && d.request == get(/databases/$(database)/documents/finance_payment_accounts/$(id)/opening/request).data
        && d.request.actorUid != request.auth.uid && d.approvedBy == request.auth.uid && d.approvedAt == request.time
        && d.request.tenantId == d.tenantId && d.request.accountId == d.accountId && d.request.branchId == d.branchId
        && d.reason is string && d.reason.size() >= 5 && d.reason.size() <= 1000;
    }
    function accountOpening(id,d) {
      let path = /databases/$(database)/documents/finance_payment_accounts/$(d.tenantId + '_' + d.accountId);
      let a = get(path).data;
      let approval = get(/databases/$(database)/documents/finance_payment_accounts/$(d.tenantId + '_' + d.accountId)/opening/approval).data;
      return isFinance() && getUserData().tenantId == d.tenantId && isAssignedToBranch(d.branchId)
        && get(/databases/$(database)/documents/system_settings/$(d.tenantId)).data.phase5SalarySettlementEnabled == true
        && d.sourceType == 'ACCOUNT_OPENING' && d.eventId == id && id == 'opening_' + d.tenantId + '_' + d.externalReference
        && d.actorUid == request.auth.uid && d.actorUid != approval.approvedBy && d.createdAt == request.time
        && approval.request.tenantId == d.tenantId && approval.request.accountId == d.accountId && approval.request.amountUGX == d.amountUGX
        && approval.request.externalReference == d.externalReference && approval.branchId == d.branchId
        && a.controlVersion == 2 && a.active == true && a.initialized == true && a.currency == 'UGX' && a.branchId == d.branchId
        && a.balanceUGX == 0 && a.lastPostingId == null && d.beforeUGX == 0 && d.afterUGX == d.amountUGX
        && d.chargeUGX == 0 && d.expenseUGX == 0 && d.revenueUGX == 0 && d.currency == 'UGX'
        && getAfter(path).data.balanceUGX == d.afterUGX && getAfter(path).data.lastPostingId == id
        && getAfter(/databases/$(database)/documents/finance_v2_account_movements/$(id + '_principal')).data.eventId == id;
    }
    function salaryStateChange(id, before, after) {
      let event = getAfter(/databases/$(database)/documents/finance_v2_events/$(after.lastAction)).data;
      return isFinance() && payrollScope(before) && before.voided == false
        && after.diff(before).affectedKeys().hasOnly(['outstandingUGX','paidUGX','lastAction','updatedAt'])
        && event.sourceType == 'SALARY_SETTLEMENT' && event.payrollId == id && event.actorUid == request.auth.uid
        && !exists(/databases/$(database)/documents/finance_v2_events/$(after.lastAction))
        && getAfter(/databases/$(database)/documents/payroll/$(id)/settlements/$(event.requestId)).data == event
        && event.amountUGX > 0 && event.amountUGX <= before.outstandingUGX
        && after.outstandingUGX == before.outstandingUGX - event.amountUGX
        && after.paidUGX == before.paidUGX + event.amountUGX && after.updatedAt == request.time;
    }
    function validFinancialDate(value) {
      let parts=value.split('-');
      let year=int(parts[0]);
      let month=int(parts[1]);
      let day=int(parts[2]);
      let leap=year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      return value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && day <= (month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31));
    }
    function disbursementFunding(id, d) {
      let account = get(/databases/$(database)/documents/finance_payment_accounts/$(d.tenantId + '_' + d.accountId)).data;
      let accountAfter = getAfter(/databases/$(database)/documents/finance_payment_accounts/$(d.tenantId + '_' + d.accountId)).data;
      return isFinance() && getUserData().tenantId == d.tenantId && isAssignedToBranch(d.branchId) && isAssignedToBranch(account.branchId)
        && get(/databases/$(database)/documents/system_settings/$(d.tenantId)).data.phase5SalarySettlementEnabled == true
        && d.eventId == id && d.actorUid == request.auth.uid && d.createdAt == request.time
        && d.currency == 'UGX' && d.amountUGX is int && d.amountUGX > 0 && d.chargeUGX is int && d.chargeUGX >= 0
        && d.amountUGX + d.chargeUGX <= 9007199254740991 && d.expenseUGX == d.chargeUGX
        && d.externalReference.matches('^[A-Z0-9_.-]{3,100}$')
        && d.recipientReference is string && d.recipientReference.size() >= 3 && d.recipientReference.size() <= 150
        && validFinancialDate(d.paymentDate)
        && account.controlVersion == 2 && account.tenantId == d.tenantId && account.initialized == true && account.active == true
        && account.salaryEligible == true && account.currency == 'UGX'
        && (account.branchId == d.branchId || (account.branchId == 'HQ' && account.salaryBranchIds.hasAny([d.branchId])))
        && account.kind in ['BANK','BRANCH_CASH_SALES','PETTY_CASH','MTN_MOBILE_MONEY','AIRTEL_MONEY']
        && d.beforeUGX == account.balanceUGX && d.afterUGX == d.beforeUGX - d.amountUGX - d.chargeUGX && d.afterUGX >= 0
        && accountAfter.balanceUGX == d.afterUGX && accountAfter.lastPostingId == id
        && getAfter(/databases/$(database)/documents/finance_v2_account_movements/$(id + '_principal')).data.eventId == id
        && (d.chargeUGX == 0 || getAfter(/databases/$(database)/documents/finance_v2_account_movements/$(id + '_charge')).data.eventId == id);
    }
    function salaryDisbursement(id, d) {
      let p = get(/databases/$(database)/documents/payroll/$(d.payrollId)).data;
      let before = get(/databases/$(database)/documents/payroll/$(d.payrollId)/state/current).data;
      let after = getAfter(/databases/$(database)/documents/payroll/$(d.payrollId)/state/current).data;
      return d.sourceType == 'SALARY_SETTLEMENT' && d.sourceId == d.payrollId && id == 'salary_' + d.payrollId + '_' + d.requestId
        && p.tenantId == d.tenantId && p.branch_id == d.branchId && p.status == 'approved_unpaid'
        && p.hrApprovedBy != request.auth.uid && p.staffId != request.auth.uid
        && before.voided == false && d.amountUGX <= before.outstandingUGX && after.lastAction == id
        && after.outstandingUGX == before.outstandingUGX - d.amountUGX && after.paidUGX == before.paidUGX + d.amountUGX;
    }
    function welfareScope(d) {
      return getUserData().tenantId == d.tenantId && ((isFinance() || isHR()) && isAssignedToBranch(d.branchId) || d.staffId == request.auth.uid);
    }
    function welfareRecognition(id,d) {
      let r = get(/databases/$(database)/documents/welfare_records/$(d.sourceId)).data;
      let approval = get(/databases/$(database)/documents/welfare_records/$(d.sourceId)/approval/current).data;
      let state = getAfter(/databases/$(database)/documents/welfare_records/$(d.sourceId)/state/current).data;
      return isFinance() && welfareScope(r) && r.kind == 'BENEFIT' && r.actorUid != request.auth.uid && r.staffId != request.auth.uid
        && approval.snapshot == r && approval.decision == 'approved' && approval.approvedBy != request.auth.uid
        && !exists(/databases/$(database)/documents/welfare_records/$(d.sourceId)/state/current)
        && d.sourceType == 'WELFARE_RECOGNITION' && id == 'welfare_accrual_' + d.sourceId && d.eventId == id
        && d.tenantId == r.tenantId && d.branchId == r.branchId && d.actorUid == request.auth.uid && d.createdAt == request.time
        && d.amountUGX == r.amountUGX && d.expenseUGX == r.amountUGX && d.payableUGX == r.amountUGX
        && state.principalUGX == r.amountUGX && state.outstandingUGX == r.amountUGX && state.settledUGX == 0 && state.lastAction == id;
    }
    function welfareDisbursement(id,d) {
      return d.sourceId == d.obligationId && (d.kind == 'ADVANCE'
        ? advanceDisbursement(id,d) : d.kind == 'BENEFIT' && benefitDisbursement(id,d));
    }
    function advanceDisbursement(id,d) {
      let r = get(/databases/$(database)/documents/advance_requests/$(d.obligationId)).data;
      let employee = get(/databases/$(database)/documents/staff/$(r.staffId)).data;
      let state = getAfter(/databases/$(database)/documents/advance_requests/$(d.obligationId)/state/current).data;
      return d.sourceType == 'ADVANCE_DISBURSEMENT' && id == 'advance_' + d.obligationId + '_' + d.requestId
        && r.tenantId == d.tenantId && employee.tenantId == d.tenantId && employee.branch_id == d.branchId && r.staffId == r.staff_id
        && r.status == 'Approved' && r.hr_approval_status == 'Approved' && r.ceo_approval_status == 'Approved'
        && r.hr_reviewed_by != r.ceo_reviewed_by && r.hr_reviewed_by != request.auth.uid && r.ceo_reviewed_by != request.auth.uid && r.staffId != request.auth.uid
        && r.amount_requested == d.amountUGX && r.amount == d.amountUGX && r.amountRequested == d.amountUGX
        && d.receivableUGX == d.amountUGX
        && !exists(/databases/$(database)/documents/advance_requests/$(d.obligationId)/state/current)
        && state.staffId == r.staffId && state.principalUGX == d.amountUGX && state.outstandingUGX == d.amountUGX && state.recoveredUGX == 0
        && state.disbursementEventId == id && state.lastAction == id
        && getAfter(/databases/$(database)/documents/advance_requests/$(d.obligationId)/settlements/$(d.requestId)).data == d;
    }
    function benefitDisbursement(id,d) {
      let r = get(/databases/$(database)/documents/welfare_records/$(d.obligationId)).data;
      let before = get(/databases/$(database)/documents/welfare_records/$(d.obligationId)/state/current).data;
      let after = getAfter(/databases/$(database)/documents/welfare_records/$(d.obligationId)/state/current).data;
      return d.sourceType == 'WELFARE_SETTLEMENT' && id == 'welfare_' + d.obligationId + '_' + d.requestId
        && r.tenantId == d.tenantId && r.branchId == d.branchId && r.staffId != request.auth.uid && r.actorUid != request.auth.uid
        && get(/databases/$(database)/documents/welfare_records/$(d.obligationId)/approval/current).data.approvedBy != request.auth.uid && d.receivableUGX == 0
        && d.amountUGX <= before.outstandingUGX && after.outstandingUGX == before.outstandingUGX - d.amountUGX
        && after.settledUGX == before.settledUGX + d.amountUGX && after.lastAction == id
        && getAfter(/databases/$(database)/documents/welfare_records/$(d.obligationId)/settlements/$(d.requestId)).data == d;
    }
    function welfareSettlementCreate(welfareCollection,sourceId,requestId) {
      return isFinance()
        && request.resource.data.kind == (welfareCollection == 'advance_requests' ? 'ADVANCE' : 'BENEFIT')
        && request.resource.data.obligationId == sourceId && request.resource.data.requestId == requestId
        && !exists(/databases/$(database)/documents/finance_v2_events/$(request.resource.data.eventId))
        && getAfter(/databases/$(database)/documents/finance_v2_events/$(request.resource.data.eventId)).data == request.resource.data
        && getAfter(/databases/$(database)/documents/finance_payment_accounts/$(request.resource.data.tenantId + '_' + request.resource.data.accountId)/payment_references/$(request.resource.data.externalReference)).data.eventId == request.resource.data.eventId;
    }
    function welfareHistoryScope(welfareCollection,sourceId) {
      let r=get(/databases/$(database)/documents/$(welfareCollection)/$(sourceId)).data;
      return welfareScope({'tenantId':r.tenantId,'staffId':r.staffId,'branchId':welfareCollection == 'advance_requests'
        ? get(/databases/$(database)/documents/staff/$(r.staffId)).data.branch_id : r.branchId});
    }
    function welfareStateCreate(welfareCollection,sourceId,stateId,d) {
      let event = getAfter(/databases/$(database)/documents/finance_v2_events/$(d.lastAction)).data;
      return stateId == 'current' && isFinance()
        && getUserData().tenantId == d.tenantId && isAssignedToBranch(d.branchId)
        && d.updatedAt == request.time && d.tenantId == event.tenantId && d.branchId == event.branchId
        && (welfareCollection == 'advance_requests'
          ? event.sourceType == 'ADVANCE_DISBURSEMENT' && event.obligationId == sourceId
          : event.sourceType == 'WELFARE_RECOGNITION' && event.sourceId == sourceId
            && d.staffId == get(/databases/$(database)/documents/welfare_records/$(sourceId)).data.staffId)
        && !exists(/databases/$(database)/documents/finance_v2_events/$(d.lastAction));
    }
    match /advance_requests/{sourceId}/settlements/{requestId} {
      allow read: if welfareHistoryScope('advance_requests',sourceId);
      allow create: if welfareSettlementCreate('advance_requests',sourceId,requestId);
      allow update, delete: if false;
    }
    match /welfare_records/{sourceId}/settlements/{requestId} {
      allow read: if welfareHistoryScope('welfare_records',sourceId);
      allow create: if welfareSettlementCreate('welfare_records',sourceId,requestId);
      allow update, delete: if false;
    }
    match /advance_requests/{sourceId}/state/{stateId} {
      allow read: if resource == null ? (isHR() || isFinance()) : welfareScope(resource.data);
      allow create: if welfareStateCreate('advance_requests',sourceId,stateId,request.resource.data);
      allow update: if stateId == 'current' && isFinance() && welfareScope(resource.data) && advanceRecoveryState(sourceId,resource.data,request.resource.data);
      allow delete: if false;
    }
    match /welfare_records/{sourceId}/state/{stateId} {
      allow read: if resource == null ? (isHR() || isFinance()) : welfareScope(resource.data);
      allow create: if welfareStateCreate('welfare_records',sourceId,stateId,request.resource.data);
      allow update: if stateId == 'current' && isFinance() && welfareScope(resource.data) && benefitState(sourceId,resource.data,request.resource.data);
      allow delete: if false;
    }
    function benefitState(id,before,after) {
      let e = getAfter(/databases/$(database)/documents/finance_v2_events/$(after.lastAction)).data;
      return after.diff(before).affectedKeys().hasOnly(['outstandingUGX','settledUGX','lastAction','updatedAt'])
        && !exists(/databases/$(database)/documents/finance_v2_events/$(after.lastAction))
        && e.sourceType == 'WELFARE_SETTLEMENT' && e.obligationId == id && e.amountUGX > 0 && e.amountUGX <= before.outstandingUGX
        && after.outstandingUGX == before.outstandingUGX - e.amountUGX && after.settledUGX == before.settledUGX + e.amountUGX && after.updatedAt == request.time;
    }
    match /finance_v2_events/{id} {
      allow get: if isFinance() && (resource == null || (getUserData().tenantId == resource.data.tenantId && isAssignedToBranch(resource.data.branchId)));
      allow list: if isFinance() && getUserData().tenantId == resource.data.tenantId && isAssignedToBranch(resource.data.branchId);
      allow create: if request.resource.data.sourceType == 'ACCOUNT_OPENING' ? accountOpening(id,request.resource.data)
        : request.resource.data.sourceType == 'WELFARE_RECOGNITION' ? welfareRecognition(id,request.resource.data)
        : disbursementFunding(id,request.resource.data) && (request.resource.data.sourceType == 'SALARY_SETTLEMENT'
          ? salaryDisbursement(id,request.resource.data) : welfareDisbursement(id,request.resource.data));
      allow update, delete: if false;
    }
    match /finance_v2_account_movements/{id} {
      function validDisbursementMovement(d) {
        let event = getAfter(/databases/$(database)/documents/finance_v2_events/$(d.eventId)).data;
        return isFinance() && getUserData().tenantId == d.tenantId && isAssignedToBranch(event.branchId)
          && !exists(/databases/$(database)/documents/finance_v2_events/$(d.eventId))
          && d.tenantId == event.tenantId && d.accountId == event.accountId && d.actorUid == request.auth.uid
          && d.createdAt == request.time && d.afterUGX == d.beforeUGX + d.deltaUGX
          && ((id == d.eventId + '_principal' && d.purpose == 'PRINCIPAL' && d.deltaUGX == (event.sourceType == 'ACCOUNT_OPENING' ? event.amountUGX : -event.amountUGX)
            && d.beforeUGX == event.beforeUGX && d.afterUGX == event.beforeUGX + d.deltaUGX)
            || (id == d.eventId + '_charge' && event.chargeUGX > 0 && d.purpose == 'CHARGE' && d.deltaUGX == -event.chargeUGX
              && d.beforeUGX == event.beforeUGX - event.amountUGX && d.afterUGX == event.afterUGX));
      }
      allow read: if isFinance() && getUserData().tenantId == resource.data.tenantId
        && isAssignedToBranch(get(/databases/$(database)/documents/finance_v2_events/$(resource.data.eventId)).data.branchId);
      allow create: if validDisbursementMovement(request.resource.data);
      allow update, delete: if false;
    }
    match /payroll/{id}/settlements/{requestId} {
      allow read: if isFinance() && (resource == null || (getUserData().tenantId == resource.data.tenantId && isAssignedToBranch(resource.data.branchId)));
      allow create: if isFinance() && requestId == request.resource.data.requestId && request.resource.data.payrollId == id
        && !exists(/databases/$(database)/documents/finance_v2_events/$(request.resource.data.eventId))
        && getAfter(/databases/$(database)/documents/finance_v2_events/$(request.resource.data.eventId)).data == request.resource.data
        && getAfter(/databases/$(database)/documents/finance_payment_accounts/$(request.resource.data.tenantId + '_' + request.resource.data.accountId)/payment_references/$(request.resource.data.externalReference)).data.eventId == request.resource.data.eventId;
      allow update, delete: if false;
    }
    match /finance_payment_accounts/{accountDocumentId}/payment_references/{reference} {
      allow get: if isFinance() && (resource == null || (getUserData().tenantId == resource.data.tenantId && isAssignedToBranch(get(/databases/$(database)/documents/finance_payment_accounts/$(accountDocumentId)).data.branchId)));
      allow create: if isFinance() && getUserData().tenantId == request.resource.data.tenantId
        && !exists(/databases/$(database)/documents/finance_v2_events/$(request.resource.data.eventId))
        && getAfter(/databases/$(database)/documents/finance_v2_events/$(request.resource.data.eventId)).data.externalReference == reference
        && getAfter(/databases/$(database)/documents/finance_v2_events/$(request.resource.data.eventId)).data.accountId == request.resource.data.accountId
        && accountDocumentId == request.resource.data.tenantId + '_' + request.resource.data.accountId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /finance_payment_accounts/{accountId} {
      allow get: if (canViewFinance() || canPostManagementCash()) && (resource == null || (isTenantMember(resource.data.tenantId) && (resource.data.get('controlVersion',0) != 2 || (isFinance() && getUserData().tenantId == resource.data.tenantId && isAssignedToBranch(resource.data.branchId)))));
      allow list: if canViewFinance() && isTenantMember(resource.data.tenantId) && (resource.data.get('controlVersion',0) != 2 || (isFinance() && getUserData().tenantId == resource.data.tenantId && isAssignedToBranch(resource.data.branchId)));
      allow create: if request.resource.data.get('controlVersion',0) == 2 ? v2AccountRegistration(accountId, request.resource.data) : (isFinance() && isTenantMember(request.resource.data.tenantId)
        && get(/databases/$(database)/documents/system_settings/$(request.resource.data.tenantId)).data.managementCashAccountControlV1 == true
        && accountId == request.resource.data.tenantId + '_' + request.resource.data.accountId
        && request.resource.data.accountId in ['management_petty_cash','management_bank']
        && request.resource.data.kind == (request.resource.data.accountId == 'management_bank' ? 'bank' : 'petty_cash')
        && request.resource.data.currency == 'UGX' && request.resource.data.controlVersion == 1
        && request.resource.data.initialized == true && request.resource.data.lastPostingId == null
        && request.resource.data.balanceUGX is int && request.resource.data.balanceUGX >= 0 && request.resource.data.balanceUGX <= 9007199254740991
        && request.resource.data.balanceUGX == request.resource.data.openingBalanceUGX
        && request.resource.data.registeredBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.reconciliationReference is string && request.resource.data.reconciliationReference.size() >= 5);
      allow update: if resource.data.get('controlVersion',0) == 2 ? v2AccountChange(accountId, resource.data, request.resource.data) : validManagementAccountUpdate(accountId, resource.data, request.resource.data);
      allow delete: if false;
    }
    match /cash_grn_payments/{paymentId} {
      function validSettlement(data) {
        let invoicePath = /databases/$(database)/documents/invoices/$(data.invoiceId);
        let before = get(invoicePath).data;
        let invoice = getAfter(invoicePath).data;
        let grn = getAfter(/databases/$(database)/documents/grn_records/$(data.grnId)).data;
        let draft = getAfter(/databases/$(database)/documents/management_expenses/$(data.draftId)).data;
        let legacy = getAfter(/databases/$(database)/documents/procurement_invoices/$(data.procurementInvoiceId)).data;
        let movement = getAfter(managementMovementPath(data.paymentAccountKind, paymentId)).data;
        return isFinance() && isTenantMember(data.tenantId)
          && get(/databases/$(database)/documents/system_settings/$(data.tenantId)).data.managementCashSettlementV1 == true
          && data.processedBy == request.auth.uid
          && paymentId == 'procurement_cash_settlement_' + data.tenantId + '_' + data.draftId + '_' + data.requestId
          && data.amountUGX is int && data.amountUGX > 0
          && data.externalReference is string && data.externalReference.size() >= 3 && data.externalReference.size() <= 150
          && data.previouslyPaidUGX == before.get('paidAmountUGX', 0)
          && data.totalInvoiceUGX == before.invoiceValue
          && data.remainingUGX == data.totalInvoiceUGX - data.previouslyPaidUGX - data.amountUGX && data.remainingUGX >= 0
          && before.tenantId == data.tenantId && before.grnId == data.grnId && before.paymentType == 'cash'
          && invoice.lastPaymentId == paymentId && invoice.paidAmountUGX == data.previouslyPaidUGX + data.amountUGX
          && grn.tenantId == data.tenantId && grn.invoice_id == data.invoiceId && grn.procurement_invoice_id == data.procurementInvoiceId && grn.lastPaymentId == paymentId
          && draft.tenantId == data.tenantId && draft.source == 'procurement_cash_grn'
          && draft.invoiceId == data.invoiceId && draft.grnId == data.grnId && draft.lastPaymentId == paymentId
          && legacy.tenantId == data.tenantId && legacy.lastPaymentId == paymentId
          && movement.externalReference == data.externalReference
          && movement.paymentId == paymentId && movement.invoiceId == data.invoiceId && movement.grnId == data.grnId
          && movement.amount == data.amountUGX && movement.type == 'outgoing'
          && movement.accountDocumentId == data.tenantId + '_' + data.paymentAccountId
          && data.excludeFromOpexRollup == true;
      }
      allow get: if canViewFinance() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if canViewFinance() && isTenantMember(resource.data.tenantId);
      allow create: if validSettlement(request.resource.data);
      allow update, delete: if false;
    }
    match /cashTransfers/{transferId} {
      function canonicalNonCashWelfareTransfer(data) {
        let sale = getAfter(/databases/$(database)/documents/sales/$(data.saleId)).data;
        return isPOSOperator() && isTenantMember(data.tenantId)
          && sale.tenantId == data.tenantId
          && transferId == 'pos_welfare_transfer_' + data.tenantId + '_' + data.saleId
          && data.fromPortfolio == 'welfare' && data.toPortfolio == 'banked'
          && data.amount == (sale.paymentMethod == 'staff_welfare' ? sale.get('welfareAmount', sale.get('totalAmount', sale.get('total', 0))) : 0)
          && data.status == (data.amount > 0 ? 'posted' : 'reversed');
      }
      // Existing POS welfare allocations are non-cash accounting records. They
      // never credit a registered bank account or bypass its funding guard.
      allow get: if canGetOptionalTenantRecord();
      allow list: if isTenantMember(resource.data.tenantId);
      allow create, update: if canonicalNonCashWelfareTransfer(request.resource.data);
      allow create: if isFinance() && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && (request.resource.data.fromPortfolio == 'banked' || request.resource.data.toPortfolio == 'banked')
        && request.resource.data.bankMovementId == 'transfer_' + transferId
        && getAfter(/databases/$(database)/documents/banking_records/$('transfer_' + transferId)).data.transferId == transferId
        && getAfter(/databases/$(database)/documents/banking_records/$('transfer_' + transferId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/banking_records/$('transfer_' + transferId)).data.accountDeltaUGX == (request.resource.data.toPortfolio == 'banked' ? request.resource.data.amount : -request.resource.data.amount)
        && (!(request.resource.data.fromPortfolio == 'petty_cash' || request.resource.data.toPortfolio == 'petty_cash')
          || (getAfter(/databases/$(database)/documents/petty_cash_ledger/$(request.resource.data.cashMovementId)).data.transferId == transferId
            && getAfter(/databases/$(database)/documents/petty_cash_ledger/$(request.resource.data.cashMovementId)).data.tenantId == request.resource.data.tenantId
            && getAfter(/databases/$(database)/documents/petty_cash_ledger/$(request.resource.data.cashMovementId)).data.accountDeltaUGX == (request.resource.data.toPortfolio == 'petty_cash' ? request.resource.data.amount : -request.resource.data.amount)));
      allow update, delete: if false;
    }

    function canViewProcurement() {
      return isProcurement()
        || isFinance()
        || hasAnyRole(['QA Head', 'QA Officer', 'Logistics Head', 'Pharmacist', 'pharmacist'])
        || isITPersonnel()
        || hasCustomModuleView('procurement');
    }

    function canViewMarketing() {
      return isMarketing()
        || hasAnyRole(['QA Head', 'Finance Head'])
        || isITPersonnel()
        || hasCustomModuleView('marketing');
    }

    function canViewGlobalRevisionLedger() {
      return isAuthenticated() && (
        isAdmin() ||
        isFinance() ||
        isIT() ||
        hasAnyRole(['QA Head', 'QA Manager'])
      );
    }

    function canViewBranchRevisionLedger(branchId) {
      return isAuthenticated()
        && isAssignedToBranch(branchId)
        && (
          isPOSOperator() ||
          isBranchManager() ||
          hasAnyRole(['QA Officer', 'QA Head', 'QA Manager']) ||
          hasCustomModuleView('sales')
        );
    }


    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (("legacyStaffId" in getUserData()) && getUserData().legacyStaffId == userId)
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /vehicles/{vehicleId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /trips/{tripId} {
      allow read: if (isLogisticsHead() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /trip_legs/{legId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /fuel_logs/{logId} {
      allow read: if (isLogisticsHead() || isFinance() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if isTenantMember(request.resource.data.tenantId) && (isLogisticsHead() || isOwner(request.resource.data.personnelId));
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /maintenance_logs/{logId} {
      allow read: if (isLogisticsHead() || isFinance() || isTenantMember(resource.data.tenantId));
      allow create: if isLogisticsHead() && isTenantMember(request.resource.data.tenantId);
      allow update: if isLogisticsHead() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isLogisticsHead() && isTenantMember(resource.data.tenantId);
    }

    match /traffic_fine_logs/{logId} {
      allow read: if (isLogisticsHead() || isHR() || isFinance() || isOwner(resource.data.personnelId) || isTenantMember(resource.data.tenantId));
      allow create: if (isLogisticsHead() || isHR()) && isTenantMember(request.resource.data.tenantId);
      allow update: if (isLogisticsHead() || isHR()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if (isLogisticsHead() || isHR()) && isTenantMember(resource.data.tenantId);
    }

    match /hiring_applications/{applicationId} {
      function isSupervisorPracticalAssessmentUpdate() {
        return isPeopleSupervisor()
          && isTenantMember(resource.data.tenantId)
          && isTenantMember(request.resource.data.tenantId)
          && request.resource.data.tenantId == resource.data.tenantId
          && resource.data.status == 'practical_scheduled'
          && request.resource.data.status == 'practical_completed'
          && request.resource.data.practical_score is number
          && request.resource.data.practical_score >= 0
          && request.resource.data.practical_score <= 100
          && request.resource.data.practical_assessed_by_user_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'practical_score', 'status',
            'practical_assessed_by_user_id', 'practical_assessed_by_name', 'practical_assessed_by_role',
            'practical_assessed_at', 'practical_assessed_branch_id', 'updatedAt'
          ]);
      }

      function isSupervisorTraineeAssessmentUpdate() {
        return isPeopleSupervisor()
          && isTenantMember(resource.data.tenantId)
          && isTenantMember(request.resource.data.tenantId)
          && request.resource.data.tenantId == resource.data.tenantId
          && resource.data.status == 'training_accepted'
          && request.resource.data.status == 'training_accepted'
          && request.resource.data.training_assessment_last_by_user_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'week4_appraisal_score', 'week4_theory_score', 'week4_assessment_date',
            'week4_assessed_by_user_id', 'week4_assessed_by_name', 'week4_assessed_by_role', 'week4_assessed_at',
            'week8_appraisal_score', 'week8_theory_score', 'week8_assessment_date',
            'week8_assessed_by_user_id', 'week8_assessed_by_name', 'week8_assessed_by_role', 'week8_assessed_at',
            'week12_appraisal_score', 'week12_theory_score', 'week12_assessment_date',
            'week12_assessed_by_user_id', 'week12_assessed_by_name', 'week12_assessed_by_role', 'week12_assessed_at',
            'training_assessment_last_by_user_id', 'training_assessment_last_by_name',
            'training_assessment_last_by_role', 'training_assessment_last_at', 'updatedAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'week4_appraisal_score', 'week4_theory_score',
            'week8_appraisal_score', 'week8_theory_score',
            'week12_appraisal_score', 'week12_theory_score'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week4_appraisal_score']) || (request.resource.data.week4_appraisal_score is number && request.resource.data.week4_appraisal_score >= 0 && request.resource.data.week4_appraisal_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week4_theory_score']) || (request.resource.data.week4_theory_score is number && request.resource.data.week4_theory_score >= 0 && request.resource.data.week4_theory_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week8_appraisal_score']) || (request.resource.data.week8_appraisal_score is number && request.resource.data.week8_appraisal_score >= 0 && request.resource.data.week8_appraisal_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week8_theory_score']) || (request.resource.data.week8_theory_score is number && request.resource.data.week8_theory_score >= 0 && request.resource.data.week8_theory_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week12_appraisal_score']) || (request.resource.data.week12_appraisal_score is number && request.resource.data.week12_appraisal_score >= 0 && request.resource.data.week12_appraisal_score <= 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['week12_theory_score']) || (request.resource.data.week12_theory_score is number && request.resource.data.week12_theory_score >= 0 && request.resource.data.week12_theory_score <= 100));
      }

      allow read: if isTenantMember(resource.data.tenantId) && (
        isHR() ||
        (isPeopleSupervisor() && resource.data.status in ['practical_scheduled', 'practical_completed', 'training_accepted'])
      );
      allow create, delete: if isHR();
      allow update: if isHR() || isSupervisorPracticalAssessmentUpdate() || isSupervisorTraineeAssessmentUpdate();
    }

    match /theory_tests/{testId} {
      allow read, write: if isHR();
    }

    match /oral_interviews/{interviewId} {
      allow read, write: if isHR();
    }

    match /practical_assessments/{assessmentId} {
      allow read: if isHR() || (isPeopleSupervisor() && isTenantMember(resource.data.tenantId));
      allow create: if isHR() || (isPeopleSupervisor() && isTenantMember(request.resource.data.tenantId) && request.resource.data.supervisorId == request.auth.uid);
      allow update: if isHR() || (isPeopleSupervisor() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && resource.data.supervisorId == request.auth.uid && request.resource.data.supervisorId == request.auth.uid);
      allow delete: if isHR();
    }

    match /attendance_records/{recordId} {
      allow read: if (isHR() || isBranchManager() || isOwner(resource.data.staffId) || isTenantMember(resource.data.tenantId));
      allow write: if isHR() || isBranchManager();
    }

    match /disciplinary_incidents/{incidentId} {
      allow read: if isTenantMember(resource.data.tenantId) && (
        isHR() || isOwner(resource.data.staffId) || resource.data.reportedByUserId == request.auth.uid
      );
      allow create: if isTenantMember(request.resource.data.tenantId) && (
        isHR() ||
        ((isPeopleSupervisor() || isQA())
          && request.resource.data.reportedByUserId == request.auth.uid
          && request.resource.data.status == 'open')
      );
      allow update: if isHR();
      allow delete: if isAdmin();
    }

    // Sequenced, human-readable identity counters. Never reuse or decrease a code.
    // Platform tenant numbering and tenant-scoped branch numbering remain separate.
    match /identity_sequence_counters/{counterId} {
      function validIncrement() {
        return request.resource.data.lastSequence is int
          && request.resource.data.lastSequence > 0
          && request.resource.data.updatedAt is string;
      }
      function platformCounter() {
        return counterId == 'platform_tenants'
          && request.resource.data.scope == 'platform'
          && request.resource.data.kind == 'tenants'
          && isAdmin();
      }
      function branchCounter() {
        return request.resource.data.kind == 'branches'
          && request.resource.data.tenantId is string
          && counterId == request.resource.data.tenantId + '_branches'
          && isCEO()
          && isTenantMember(request.resource.data.tenantId);
      }
      function scopedCounter() {
        return request.resource.data.kind in ['patients', 'prescribers', 'institutions', 'products', 'staff', 'operational_assets', 'operational_consumables']
          && request.resource.data.tenantId is string
          && counterId == request.resource.data.tenantId + '_' + request.resource.data.kind
          && isTenantMember(request.resource.data.tenantId)
          && (request.resource.data.kind == 'staff'
            ? (isHR() || isIT())
            : request.resource.data.kind in ['products', 'operational_assets', 'operational_consumables']
              ? isInventoryOperator()
              : isAuthenticated());
      }
      allow get: if isAuthenticated() && (resource == null
        || (resource.data.get('scope', '') == 'platform' && isAdmin())
        || (resource.data.get('tenantId', '') is string
          && isTenantMember(resource.data.tenantId)));
      allow list: if false;
      allow create: if validIncrement() && request.resource.data.lastSequence == 1
        && (platformCounter() || branchCounter() || scopedCounter());
      allow update: if validIncrement()
        && request.resource.data.lastSequence == resource.data.lastSequence + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSequence', 'updatedAt'])
        && (platformCounter() || branchCounter() || scopedCounter());
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if true; // Allow public read for tenant detection
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (!('tenant_code' in resource.data)
          || request.resource.data.tenant_code == resource.data.tenant_code);
      allow delete: if isAdmin();

      match /usernameRegistry/{handle} {
        allow read, write: if isAuthenticated() && (isAdmin() || isIT()) && isTenantMember(tenantId);
      }
    }

    match /branches/{branchId} {
      function hasValidBranchShape() {
        return request.resource.data.keys().hasAll([
          'tenantId', 'name', 'branch_code', 'type', 'address', 'phone',
          'status', 'created_at', 'created_by'
        ])
        && request.resource.data.tenantId is string
        && request.resource.data.name is string
        && request.resource.data.branch_code is string
        && request.resource.data.status in ['Active', 'Inactive', 'Closed'];
      }

      // Checkout and quotation validation point-read missing branch IDs before
      // reporting an invalid branch. Never expose existing cross-tenant records.
      allow get: if canGetOptionalTenantRecord();
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if isCEO() && isTenantMember(request.resource.data.tenantId) && hasValidBranchShape();
      allow update: if isSettingsAdmin() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branch_code == resource.data.branch_code;
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == staffId ||
        resource.data.email == request.auth.token.email ||
        resource.data.authEmail == request.auth.token.email ||
        isTenantMember(resource.data.tenantId)
      );
      allow create: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(request.resource.data.tenantId);
      // HR assigns organisational roles and branch placement. IT may perform account
      // activation/support updates but cannot silently change the HR-assigned role realm.
      allow update: if atomicWelfareBalance(staffId);
      allow update: if isAuthenticated()
        && isTenantMember(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId
        && (!('employee_id' in resource.data) || request.resource.data.employee_id == resource.data.employee_id)
        && (!('staff_code' in resource.data) || request.resource.data.staff_code == resource.data.staff_code)
        && (
        isHR() ||
        (isITPersonnel() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'tenantId', 'role', 'secondaryRoles', 'roleRealmId',
            'assigned_branches', 'branch_id', 'default_branch_id'
          ])) ||
        (request.auth.uid == staffId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'tenantId', 'role', 'secondaryRoles', 'assigned_branches',
            'branch_id', 'default_branch_id', 'status', 'active',
            'authEmail', 'loginHandle', 'username', 'uid', 'password_set',
            'legacyStaffId', 'roleRealmId'
          ]))
      );
      allow delete: if (isAdmin() || isIT()) && isTenantMember(resource.data.tenantId);
    }

    match /leave_requests/{requestId} {
      allow get: if isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || ((isHR() || isFinance()) && isAssignedToBranch(get(/databases/$(database)/documents/staff/$(resource.data.staffId)).data.branch_id)));
      allow list: if isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || ((isHR() || isFinance()) && isAssignedToBranch(resource.data.branchId)));
      allow create: if isAuthenticated() && isOwner(request.resource.data.staffId) && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.staffId == request.resource.data.staff_id && request.resource.data.branchId == get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.branch_id
        && request.resource.data.status == 'Pending' && request.resource.data.hr_approval_status == 'Pending' && request.resource.data.ceo_approval_status == 'Pending'
        && validFinancialDate(request.resource.data.start_date) && validFinancialDate(request.resource.data.end_date) && request.resource.data.start_date <= request.resource.data.end_date
        && request.resource.data.startDate == request.resource.data.start_date && request.resource.data.endDate == request.resource.data.end_date
        && request.resource.data.leave_type in ['Annual','Sick','Study','Maternity','Paternity','Compassionate','Unpaid'];
      allow update: if validHrRequestReview();
      allow delete: if false;
    }
    function validHrRequestReview() {
      return isTenantMember(resource.data.tenantId)
        && isAssignedToBranch(get(/databases/$(database)/documents/staff/$(resource.data.staffId)).data.branch_id)
        && request.auth.uid != resource.data.staffId
        && request.resource.data.tenantId == resource.data.tenantId && resource.data.status == 'Pending'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hr_approval_status','hr_notes','hr_reviewed_by','hr_reviewed_at','ceo_approval_status','ceo_notes','ceo_reviewed_by','ceo_reviewed_at','status','updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hr_approval_status','hr_notes','hr_reviewed_by','hr_reviewed_at'])
          || (isHR() && request.resource.data.hr_reviewed_by == request.auth.uid && request.resource.data.hr_approval_status in ['Approved','Rejected']
            && resource.data.hr_approval_status == 'Pending' && request.resource.data.hr_reviewed_at == request.time
            && resource.data.get('ceo_reviewed_by','') != request.auth.uid))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ceo_approval_status','ceo_notes','ceo_reviewed_by','ceo_reviewed_at'])
          || (isCEO() && request.resource.data.ceo_reviewed_by == request.auth.uid && request.resource.data.ceo_approval_status in ['Approved','Rejected']
            && resource.data.ceo_approval_status == 'Pending' && request.resource.data.ceo_reviewed_at == request.time
            && resource.data.get('hr_reviewed_by','') != request.auth.uid))
        && request.resource.data.get('hr_reviewed_by','') != request.resource.data.get('ceo_reviewed_by','')
        && request.resource.data.hr_approval_status in ['Pending','Approved','Rejected'] && request.resource.data.ceo_approval_status in ['Pending','Approved','Rejected']
        && request.resource.data.status == (request.resource.data.hr_approval_status == 'Rejected' || request.resource.data.ceo_approval_status == 'Rejected' ? 'Rejected'
          : (request.resource.data.hr_approval_status == 'Approved' && request.resource.data.ceo_approval_status == 'Approved' ? 'Approved' : 'Pending'));
    }

    // Salary accrual uses an exact HR-approved snapshot, never a browser review flag.
    function payrollScope(data) {
      return isAuthenticated() && getUserData().tenantId == data.tenantId
        && isAssignedToBranch(data.snapshot.branchId);
    }
    function verifiedAdvance(tenantId,d) {
      let state = get(/databases/$(database)/documents/advance_requests/$(d.advanceId)/state/current).data;
      let event = get(/databases/$(database)/documents/finance_v2_events/$(state.disbursementEventId)).data;
      return d.advanceId is string && state.tenantId == tenantId && state.staffId == d.staffId && state.branchId == d.branchId
        && state.outstandingUGX >= d.advanceDeduction && event.sourceType == 'ADVANCE_DISBURSEMENT'
        && event.obligationId == d.advanceId && event.tenantId == tenantId && event.amountUGX == state.principalUGX;
    }
    function payrollAdvanceRecovery(id,data) {
      let d = data.snapshot;
      let before = get(/databases/$(database)/documents/advance_requests/$(d.advanceId)/state/current).data;
      let after = getAfter(/databases/$(database)/documents/advance_requests/$(d.advanceId)/state/current).data;
      let recovery = getAfter(/databases/$(database)/documents/advance_requests/$(d.advanceId)/recoveries/$(id)).data;
      return verifiedAdvance(data.tenantId,d) && data.advanceId == d.advanceId && data.advanceRecoveryUGX == d.advanceDeduction
        && after.outstandingUGX == before.outstandingUGX - d.advanceDeduction && after.recoveredUGX == before.recoveredUGX + d.advanceDeduction
        && after.lastAction == id && recovery.payrollId == id && recovery.deltaUGX == d.advanceDeduction;
    }
    function advanceRecoveryState(id,before,after) {
      let recovery = getAfter(/databases/$(database)/documents/advance_requests/$(id)/recoveries/$(after.lastAction)).data;
      return after.diff(before).affectedKeys().hasOnly(['outstandingUGX','recoveredUGX','lastAction','updatedAt'])
        && !exists(/databases/$(database)/documents/advance_requests/$(id)/recoveries/$(after.lastAction))
        && after.updatedAt == request.time && recovery.actorUid == request.auth.uid
        && after.outstandingUGX == before.outstandingUGX - recovery.deltaUGX && after.recoveredUGX == before.recoveredUGX + recovery.deltaUGX
        && after.outstandingUGX >= 0 && after.recoveredUGX >= 0 && after.outstandingUGX + after.recoveredUGX == before.principalUGX;
    }
    match /advance_requests/{advanceId}/recoveries/{recoveryId} {
      function validRecovery(d) {
        let p = getAfter(/databases/$(database)/documents/payroll/$(d.payrollId)).data;
        let state = getAfter(/databases/$(database)/documents/advance_requests/$(advanceId)/state/current).data;
        return isFinance() && welfareScope(state) && p.tenantId == d.tenantId && p.staffId == d.staffId && p.branch_id == d.branchId
          && p.snapshot.advanceId == advanceId && d.actorUid == request.auth.uid && d.createdAt == request.time && state.lastAction == recoveryId
          && (d.deltaUGX > 0 ? (recoveryId == d.payrollId && d.deltaUGX == p.advanceDeduction && !exists(/databases/$(database)/documents/payroll/$(d.payrollId)))
            : d.deltaUGX == -p.advanceDeduction && recoveryId == 'void_' + d.payrollId
              && !exists(/databases/$(database)/documents/payroll/$(d.payrollId)/corrections/void)
              && getAfter(/databases/$(database)/documents/payroll/$(d.payrollId)/corrections/void).data.postedBy == request.auth.uid);
      }
      allow read: if welfareScope(resource.data);
      allow create: if validRecovery(request.resource.data);
      allow update, delete: if false;
    }
    function validPayrollSnapshot(data) {
      let d = data.snapshot;
      let employee = get(/databases/$(database)/documents/staff/$(d.staffId)).data;
      return d.keys().hasOnly(['staffId','staffName','branchId','period','baseSalary','bonuses','deductions','netSalary','paye','nssfEmployee','nssfEmployer','advanceDeduction','advanceId','fineDeduction','unpaidLeaveDeduction','otherDeductions','dueDate'])
        && (!('dueDate' in d) || validFinancialDate(d.dueDate))
        && d.period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && employee.tenantId == data.tenantId && employee.branch_id == d.branchId
        && d.staffName is string && d.staffName.size() > 0
        && d.baseSalary is int && d.baseSalary >= 0 && d.baseSalary <= 9007199254740991
        && d.bonuses is int && d.bonuses >= 0
        && d.deductions is int && d.deductions >= 0
        && d.netSalary is int && d.netSalary >= 0
        && d.paye is int && d.paye >= 0 && d.nssfEmployee is int && d.nssfEmployee >= 0
        && d.nssfEmployer is int && d.nssfEmployer >= 0
        && d.fineDeduction is int && d.fineDeduction >= 0
        && d.unpaidLeaveDeduction is int && d.unpaidLeaveDeduction >= 0
        && d.otherDeductions is int && d.otherDeductions >= 0
        && d.advanceDeduction is int && d.advanceDeduction >= 0 && (d.advanceDeduction == 0 || verifiedAdvance(data.tenantId,d))
        && d.baseSalary + d.bonuses <= 9007199254740991
        && d.baseSalary + d.bonuses + d.nssfEmployer <= 9007199254740991
        && d.paye + d.nssfEmployee + d.advanceDeduction + d.fineDeduction + d.unpaidLeaveDeduction + d.otherDeductions == d.deductions
        && d.baseSalary + d.bonuses == d.netSalary + d.deductions;
    }
    match /payroll_approvals/{id} {
      allow get: if isAuthenticated() && (resource == null || (payrollScope(resource.data) && (isHR() || isFinance())));
      allow list: if payrollScope(resource.data) && (isHR() || isFinance());
      allow create, update: if isHR() && payrollScope(request.resource.data)
        && validPayrollSnapshot(request.resource.data)
        && id == request.resource.data.tenantId + '_' + request.resource.data.snapshot.staffId + '_' + request.resource.data.snapshot.period
        && !existsAfter(/databases/$(database)/documents/payroll/$(id))
        && request.resource.data.keys().hasOnly(['tenantId','snapshot','revision','status','approvedBy','approvedAt','reason'])
        && request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 3
        && request.resource.data.status in ['approved','rejected','superseded']
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && (resource == null || request.resource.data.tenantId == resource.data.tenantId)
        && !exists(/databases/$(database)/documents/payroll_approvals/$(id)/revisions/$(string(request.resource.data.revision)))
        && getAfter(/databases/$(database)/documents/payroll_approvals/$(id)/revisions/$(string(request.resource.data.revision))).data == request.resource.data;
      allow delete: if false;
      match /revisions/{revision} {
        allow read: if payrollScope(resource.data) && (isHR() || isFinance());
        allow create: if isHR() && payrollScope(request.resource.data)
          && revision == string(request.resource.data.revision)
          && getAfter(/databases/$(database)/documents/payroll_approvals/$(id)).data == request.resource.data;
        allow update, delete: if false;
      }
    }
    function approvedPayroll(id, data) {
      let approval = get(/databases/$(database)/documents/payroll_approvals/$(id)).data;
      let d = data.snapshot;
      return payrollScope(data) && approval.status == 'approved'
        && approval.tenantId == data.tenantId && approval.snapshot == d
        && approval.approvedBy != request.auth.uid && data.hrApprovedBy == approval.approvedBy
        && data.approvalRevision == approval.revision
        && getAfter(/databases/$(database)/documents/payroll_approvals/$(id)).data == approval
        && data.finalizedAt == request.time
        && data.staffId == d.staffId && data.staff_name == d.staffName && data.branch_id == d.branchId
        && data.period == d.period && data.month == d.period
        && data.get('dueDate',null) == d.get('dueDate',null)
        && data.baseSalary == d.baseSalary && data.base_salary == d.baseSalary
        && data.bonuses == d.bonuses && data.deductions == d.deductions && data.netSalary == d.netSalary && data.net_salary == d.netSalary
        && data.paye == d.paye && data.nssfEmployee == d.nssfEmployee && data.nssfEmployer == d.nssfEmployer
        && data.nssf_employee == d.nssfEmployee && data.nssf_employer == d.nssfEmployer
        && data.advanceDeduction == d.advanceDeduction && data.advance_deduction == d.advanceDeduction
        && (d.advanceDeduction == 0 || payrollAdvanceRecovery(id,data))
        && data.fineDeduction == d.fineDeduction && data.fine_deduction == d.fineDeduction
        && data.unpaidLeaveDeduction == d.unpaidLeaveDeduction
        && data.salaryExpenseUGX == d.baseSalary + d.bonuses - d.unpaidLeaveDeduction
        && data.employerNssfExpenseUGX == d.nssfEmployer && data.payePayableUGX == d.paye
        && data.nssfPayableUGX == d.nssfEmployee + d.nssfEmployer
        && data.otherDeductionsPayableUGX == d.fineDeduction + d.otherDeductions
        && data.netSalaryPayableUGX == d.netSalary && data.accountingReference == id;
    }

    // Submitted attendance is distinct from a manager-approved payroll timesheet.
    match /payroll/{payrollId} {
      allow get: if (isHR() || isFinance()) && resource == null;
      allow read: if isTenantMember(resource.data.tenantId)
        && (isOwner(resource.data.staffId) || ((isHR() || isFinance() || isCEO()) && isAssignedToBranch(resource.data.branch_id)));
      allow create: if isFinance() && getUserData().tenantId == request.resource.data.tenantId
        && payrollId == request.resource.data.tenantId + '_' + request.resource.data.staffId + '_' + request.resource.data.period
        && request.resource.data.payrollId == payrollId
        && approvedPayroll(payrollId, request.resource.data)
        && request.resource.data.status == 'approved_unpaid'
        && request.resource.data.finalizedBy == request.auth.uid
        && request.resource.data.baseSalary is int && request.resource.data.bonuses is int
        && request.resource.data.deductions is int && request.resource.data.netSalary is int
        && request.resource.data.netSalary >= 0 && request.resource.data.baseSalary >= 0
        && request.resource.data.bonuses >= 0 && request.resource.data.deductions >= 0
        && request.resource.data.baseSalary + request.resource.data.bonuses == request.resource.data.netSalary + request.resource.data.deductions
        && getAfter(/databases/$(database)/documents/payslips/$(payrollId)).data.payrollId == payrollId
        && getAfter(/databases/$(database)/documents/payroll/$(payrollId)/state/current).data.outstandingUGX == request.resource.data.netSalary;
      allow update, delete: if false;
    }

    match /payroll/{id}/state/{stateId} {
      function originalPayroll() { return getAfter(/databases/$(database)/documents/payroll/$(id)).data; }
      allow read: if isAuthenticated() && (resource == null || (payrollScope(resource.data) && (isHR() || isFinance())));
      allow create: if isFinance() && stateId == 'current' && payrollScope(request.resource.data)
        && !exists(/databases/$(database)/documents/payroll/$(id))
        && request.resource.data.keys().hasOnly(['tenantId','snapshot','outstandingUGX','paidUGX','voided','lastAction','updatedAt'])
        && request.resource.data.tenantId == originalPayroll().tenantId && request.resource.data.snapshot == originalPayroll().snapshot
        && request.resource.data.outstandingUGX == originalPayroll().netSalaryPayableUGX
        && request.resource.data.paidUGX == 0 && request.resource.data.voided == false
        && request.resource.data.lastAction == 'recognition' && request.resource.data.updatedAt == request.time;
      allow update: if request.resource.data.lastAction != 'void' ? (stateId == 'current' && salaryStateChange(id,resource.data,request.resource.data)) : (isFinance() && payrollScope(resource.data) && stateId == 'current'
        && resource.data.paidUGX == 0 && resource.data.voided == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstandingUGX','voided','lastAction','updatedAt'])
        && request.resource.data.outstandingUGX == 0 && request.resource.data.voided == true
        && request.resource.data.lastAction == 'void' && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/payroll/$(id)/corrections/void)
        && getAfter(/databases/$(database)/documents/payroll/$(id)/corrections/void).data.postedBy == request.auth.uid);
      allow delete: if false;
    }
    match /payroll/{id}/corrections/{action} {
      function validVoid(data) {
        let payroll = get(/databases/$(database)/documents/payroll/$(id)).data;
        let before = get(/databases/$(database)/documents/payroll/$(id)/state/current).data;
        let after = getAfter(/databases/$(database)/documents/payroll/$(id)/state/current).data;
        let approval = get(/databases/$(database)/documents/payroll/$(id)/corrections/void_request).data;
        return isFinance() && approval.approvedBy != request.auth.uid
          && data.postedBy == request.auth.uid && data.postedAt == request.time
          && data.reason == approval.reason && data.snapshot == payroll.snapshot && data.tenantId == payroll.tenantId
          && data.reversesPayrollId == id && before.paidUGX == 0 && before.voided == false && after.voided == true
          && data.salaryExpenseUGX == -payroll.salaryExpenseUGX && data.employerNssfExpenseUGX == -payroll.employerNssfExpenseUGX
          && data.payePayableUGX == -payroll.payePayableUGX && data.nssfPayableUGX == -payroll.nssfPayableUGX
          && data.otherDeductionsPayableUGX == -payroll.otherDeductionsPayableUGX && data.netSalaryPayableUGX == -payroll.netSalaryPayableUGX
          && (payroll.advanceDeduction == 0 || (getAfter(/databases/$(database)/documents/advance_requests/$(payroll.advanceId)/recoveries/$('void_' + id)).data.deltaUGX == -payroll.advanceDeduction
            && getAfter(/databases/$(database)/documents/advance_requests/$(payroll.advanceId)/state/current).data.lastAction == 'void_' + id));
      }
      allow get: if isAuthenticated() && (resource == null || (payrollScope(resource.data) && (isHR() || isFinance())));
      allow list: if payrollScope(resource.data) && (isHR() || isFinance());
      allow create: if payrollScope(request.resource.data) && (
        (action == 'void_request' && isHR() && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.approvedAt == request.time && request.resource.data.reason.size() >= 5
          && request.resource.data.tenantId == get(/databases/$(database)/documents/payroll/$(id)).data.tenantId
          && request.resource.data.snapshot == get(/databases/$(database)/documents/payroll/$(id)).data.snapshot
          && get(/databases/$(database)/documents/payroll/$(id)/state/current).data.paidUGX == 0
          && get(/databases/$(database)/documents/payroll/$(id)/state/current).data.voided == false)
        || (action == 'void' && validVoid(request.resource.data)));
      allow update, delete: if false;
    }

    // Append-once daily attendance: only separate authorized reviewer may change status.
    match /attendance/{attendanceId} {
      allow read: if isTenantMember(resource.data.tenantId)
        && (isHR() || isAssignedToBranch(resource.data.branch_id));
      allow create: if isTenantMember(request.resource.data.tenantId)
        && attendanceId == request.resource.data.tenantId + '_' + request.resource.data.staffId + '_' + request.resource.data.date
        && (isHR() || isAssignedBranchManager(request.resource.data.branch_id))
        && request.resource.data.loggedByUid == request.auth.uid
        && request.resource.data.approval_status == 'Submitted'
        && request.resource.data.status in ['present','absent','on-leave']
        && request.resource.data.hours_worked is number
        && request.resource.data.hours_worked >= 0 && request.resource.data.hours_worked <= 24;
      allow update: if isTenantMember(resource.data.tenantId)
        && resource.data.approval_status == 'Submitted'
        && (isHR() || isAssignedBranchManager(resource.data.branch_id))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approval_status','approvedByUid','updatedAt'])
        && request.resource.data.approval_status in ['Approved','Rejected']
        && request.resource.data.approvedByUid == request.auth.uid
        && request.auth.uid != resource.data.loggedByUid;
      allow delete: if false;
    }

    match /advance_requests/{requestId} {
      allow get: if isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || ((isHR() || isFinance())
        && isAssignedToBranch(get(/databases/$(database)/documents/staff/$(resource.data.staffId)).data.branch_id)));
      allow list: if isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || ((isHR() || isFinance()) && isAssignedToBranch(resource.data.branchId)));
      allow create: if isAuthenticated()
        && isOwner(request.resource.data.staffId)
        && request.resource.data.staff_id == request.resource.data.staffId
        && request.resource.data.branchId == get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.branch_id
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.status == 'Pending'
        && request.resource.data.hr_approval_status == 'Pending'
        && request.resource.data.ceo_approval_status == 'Pending'
        && request.resource.data.amount_requested is int
        && request.resource.data.amount_requested > 0
        && request.resource.data.amount == request.resource.data.amount_requested
        && request.resource.data.amountRequested == request.resource.data.amount_requested
        && request.resource.data.repayment_period_months is int
        && request.resource.data.repayment_period_months >= 1
        && request.resource.data.repayment_period_months <= 120;
      // Approvals modify only decision fields, never funds or request identity.
      // The final status must follow the two independently recorded decisions.
      allow update: if validHrRequestReview();

      allow delete: if false;
    }

    match /payslips/{payslipId} {
      function pairedPayslip(data) {
        let payroll = getAfter(/databases/$(database)/documents/payroll/$(payslipId)).data;
        return data.diff(payroll).affectedKeys().hasOnly(['base_salary','net_salary','nssf_employee','nssf_employer','advance_deduction','fine_deduction','year','netPayable','basePay','allowances'])
          && data.netPayable == payroll.netSalary && data.basePay == payroll.baseSalary
          && data.allowances == payroll.bonuses && data.year == int(payroll.period.split('-')[0]);
      }
      allow get: if (isHR() || isFinance()) && resource == null;
      allow read: if isTenantMember(resource.data.tenantId) && (isOwner(resource.data.staffId) || (isFinance() && isAssignedToBranch(resource.data.branch_id)));
      allow create: if isFinance() && getUserData().tenantId == request.resource.data.tenantId
        && payslipId == request.resource.data.payrollId && pairedPayslip(request.resource.data);
      allow update, delete: if false;
    }

    match /cme_records/{recordId} {
      allow read: if (isOwner(resource.data.staffId) || isHR() || isTenantMember(resource.data.tenantId));
      allow write: if isHR();
    }

    match /appraisal_scores/{scoreId} {
      allow read: if (isOwner(resource.data.staffId) || isHR() || isTenantMember(resource.data.tenantId));
      allow write: if isHR();
    }

    match /system_settings/{settingsId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isSettingsAdmin() && isTenantMember(request.resource.data.tenantId);
    }

    match /master_registries/{registryId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isSettingsAdmin() && isTenantMember(request.resource.data.tenantId);
    }

    match /role_realms_of_operation/{realmId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isITPersonnel() && isTenantMember(request.resource.data.tenantId);
      allow update: if isITPersonnel() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isITPersonnel() && isTenantMember(resource.data.tenantId);
    }

    match /hr_roles/{roleId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isITPersonnel() && isTenantMember(request.resource.data.tenantId);
      allow update: if isITPersonnel() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isITPersonnel() && isTenantMember(resource.data.tenantId);
    }

    match /global_audit_logs/{logId} {
      allow read: if (isAdmin() || isIT() || hasRole('QA Head')) && isTenantMember(resource.data.tenantId);
      allow create: if isTenantMember(request.resource.data.tenantId);
      allow update, delete: if false; // Immutable
    }
    match /platform_users/{userId} {
      allow read, write: if isAdmin();
    }

    match /platform_revenue/{revenueId} {
      allow read, write: if isAdmin();
    }

    match /platform_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /predictive_settings/{settingId} {
      allow read, write: if isAdmin();
    }
    match /pending_activations/{activationId} {
      allow read: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated() && (isAdmin() || isIT() || isHR()) && isTenantMember(request.resource.data.tenantId);
      allow update, delete: if isAuthenticated() && (isAdmin() || isIT()) && isTenantMember(resource.data.tenantId);
    }

    match /finance_ledger/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance() && isTenantMember(request.resource.data.tenantId);
    }

    // Immutable handoff from finalized Operational GRNs to the future Finance V2 consumer.
    match /operational_finance_events/{eventId} {
      function sourceGrnPath() {
        return /databases/$(database)/documents/grn_records/$(request.resource.data.sourceId);
      }
      allow get: if isAuthenticated() && (isProcurement() || canViewFinance()) && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow create: if isAuthenticated()
        && isProcurement()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.eventKind in ['OPERATIONAL_CONSUMABLE_OPEX', 'FIXED_ASSET_ACQUISITION']
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && request.resource.data.eventKind == (request.resource.data.operationalType == 'FIXED_ASSET' ? 'FIXED_ASSET_ACQUISITION' : 'OPERATIONAL_CONSUMABLE_OPEX')
        && request.resource.data.status == 'READY_FOR_FINANCE'
        && request.resource.data.amountUGX is number
        && request.resource.data.amountUGX >= 0
        && request.resource.data.sourceType == 'OPERATIONAL_GRN'
        && request.resource.data.destinationStoreId == getAfter(sourceGrnPath()).data.destination_store_id
        && existsAfter(sourceGrnPath())
        && getAfter(sourceGrnPath()).data.tenantId == request.resource.data.tenantId
        && getAfter(sourceGrnPath()).data.inventoryClass == 'OPERATIONAL'
        && getAfter(sourceGrnPath()).data.financial_posting_status == 'event_created'
        && getAfter(sourceGrnPath()).data.total_value_ugx >= request.resource.data.amountUGX;
      allow update, delete: if false;
    }

    match /operational_inventory_migration_audit/{auditId} {
      allow read: if isTenantMember(resource.data.tenantId)
        && (isInventoryOperator() || isProcurement() || isITPersonnel() || isAdmin());
      allow create, update, delete: if false;
    }

    match /operational_inventory_identity_events/{eventId} {
      function linkedItemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.itemId);
      }
      function linkedMasterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
      }
      allow get: if canGetOptionalTenantRecord();
      allow list: if isTenantMember(resource.data.tenantId)
        && (isInventoryOperator() || isProcurement() || isITPersonnel() || isAdmin());
      allow create: if isAuthenticated()
        && isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.eventType in ['MASTER_CREATED', 'LOCATION_LINKED', 'LEGACY_ITEM_LINKED']
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.itemId is string
        && request.resource.data.masterItemId is string
        && eventId == 'opidentity_' + request.resource.data.itemId
        && existsAfter(linkedItemPath())
        && getAfter(linkedItemPath()).data.tenantId == request.resource.data.tenantId
        && getAfter(linkedItemPath()).data.branchId == request.resource.data.branchId
        && getAfter(linkedItemPath()).data.inventoryClass == 'OPERATIONAL'
        && getAfter(linkedItemPath()).data.masterItemId == request.resource.data.masterItemId
        && existsAfter(linkedMasterPath())
        && getAfter(linkedMasterPath()).data.tenantId == request.resource.data.tenantId
        && getAfter(linkedMasterPath()).data.inventoryClass == 'OPERATIONAL';
      allow update, delete: if false;
    }

    function operationalIdentityFingerprint(data) {
      return data.name.trim().lower().replace('\\s+', ' ') + '|'
        + data.get('category', '').trim().lower().replace('\\s+', ' ') + '|'
        + data.type + '|' + string(data.unitPerPack) + '|'
        + data.unitOfIssue.trim().lower().replace('\\s+', ' ');
    }
    function operationalIdentityClaimId(data) {
      return 'opidentity_' + (data.tenantId + '|' + operationalIdentityFingerprint(data)).toUtf8().toBase64()
        .replace('/', '_').replace('[+]', '-').replace('=', '');
    }
    function operationalIdentityReady(tenantId) {
      let state = /databases/$(database)/documents/operational_inventory_identity_state/$(tenantId);
      return exists(state) && get(state).data.tenantId == tenantId && get(state).data.status == 'READY';
    }
    match /operational_inventory_identity_state/{tenantId} {
      allow get: if isTenantMember(tenantId);
      allow list, write: if false;
    }

    // Tenant-wide identity claims serialize first registration and legacy
    // linking transactions that use different location document IDs.
    match /operational_inventory_identity_claims/{claimId} {
      function claimedMasterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
      }
      allow get: if isAuthenticated()
        && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isInventoryOperator() || isProcurement() || isITPersonnel() || isAdmin());
      allow create: if isAuthenticated()
        && isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && operationalIdentityReady(request.resource.data.tenantId)
        && request.resource.data.identityFingerprint is string
        && request.resource.data.masterItemId is string
        && request.resource.data.actorId == request.auth.uid
        && existsAfter(claimedMasterPath())
        && getAfter(claimedMasterPath()).data.tenantId == request.resource.data.tenantId
        && getAfter(claimedMasterPath()).data.inventoryClass == 'OPERATIONAL'
        && claimId == operationalIdentityClaimId(getAfter(claimedMasterPath()).data)
        && request.resource.data.identityFingerprint == operationalIdentityFingerprint(getAfter(claimedMasterPath()).data);
      allow update, delete: if false;
    }

    // Deterministic procurement posting IDs require an existence check before
    // creation. A missing document exposes no tenant data; existing documents
    // remain tenant-scoped by the second clause and by the collection rules.
    match /grn_records/{recordId} {
      function hasOperationalSourceOrder(data) {
        return ('order_id' in data)
          && exists(/databases/$(database)/documents/stock_orders/$(data.order_id))
          && get(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.tenantId == data.tenantId
          && isOperationalOrderData(get(/databases/$(database)/documents/stock_orders/$(data.order_id)).data);
      }
      function validGrnInventoryClass(data) {
        return (('inventoryClass' in data)
            && data.inventoryClass == 'OPERATIONAL'
            && hasOperationalSourceOrder(data)
            && (!('deliveryRoute' in data) || getAfter(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.operational_delivery_route == data.deliveryRoute)
            && ((data.get('deliveryRoute', 'VIA_HQ') == 'VIA_HQ' && data.destination_store_id == 'HQ_OPERATIONAL')
              || (data.get('deliveryRoute', '') == 'DIRECT_BRANCH'
                && data.destination_store_id == 'SUPPLIER_TRANSIT'
                && data.destination_branch_id != 'HQ'
                && data.destination_branch_id == get(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.requesting_branch_id
                && getAfter(/databases/$(database)/documents/stock_orders/$(data.order_id)).data.operational_delivery_route == 'DIRECT_BRANCH'))
            && data.grn_status == 'completed'
            && data.status == 'completed'
            && !('items' in data)
            && data.itemCount is number
            && data.itemCount > 0
            && data.itemCount <= 150
            && data.receivedBy == request.auth.uid
            && isOperationalInventoryEnabled(data.tenantId))
          || (('inventoryClass' in data)
            && data.inventoryClass == 'SELLABLE'
            && !hasOperationalSourceOrder(data))
          || (!('inventoryClass' in data)
            && !('operationalType' in data)
            && !hasOperationalSourceOrder(data));
      }
      allow get: if canGetOptionalTenantRecord();
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated()
        && isTenantMember(request.resource.data.tenantId)
        && (!('inventoryClass' in request.resource.data)
          || request.resource.data.inventoryClass != 'OPERATIONAL'
          || isProcurement())
        && validGrnInventoryClass(request.resource.data);
      allow update: if isAuthenticated()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && !hasOperationalSourceOrder(resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['payment_status','lastPaymentId']) || resource.data.get('payment_type','') != 'cash')
        && (!('inventoryClass' in resource.data) || request.resource.data.inventoryClass == resource.data.inventoryClass)
        && (!('inventoryClass' in resource.data) || resource.data.inventoryClass != 'OPERATIONAL')
        && validGrnInventoryClass(request.resource.data);
      allow update: if validSupplierGrnPayment(recordId, resource.data, request.resource.data);
      allow delete: if resource.data.inventoryClass != 'OPERATIONAL'
        && !hasOperationalSourceOrder(resource.data)
        && isAdmin() && isTenantMember(resource.data.tenantId);
    }
    match /invoices/{invoiceId} {
      allow get: if canGetOptionalTenantRecord();
      allow list: if isTenantMember(resource.data.tenantId) && (canViewFinance() || isProcurement());
      allow create: if isTenantMember(request.resource.data.tenantId) && (isFinance() || isProcurement());
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId)
        && ((resource.data.get('paymentType','') == 'cash' && resource.data.get('grnId','') != '')
          ? validSupplierInvoiceUpdate(invoiceId, resource.data, request.resource.data, false)
          : (isFinance() || isProcurement()));
      allow delete: if false;
    }
    match /procurement_invoices/{invoiceId} {
      allow get: if canGetOptionalTenantRecord();
      allow list: if isTenantMember(resource.data.tenantId) && (canViewFinance() || isProcurement());
      allow create: if isTenantMember(request.resource.data.tenantId) && (isFinance() || isProcurement());
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId)
        && ((resource.data.get('paymentType','') == 'cash' && resource.data.get('grnId','') != '')
          ? validSupplierInvoiceUpdate(invoiceId, resource.data, request.resource.data, true)
          : (isFinance() || isProcurement()));
      allow delete: if false;
    }
    match /creditLedger/{entryId} {
      allow get: if canGetOptionalTenantRecord();
    }
    match /petty_cash_ledger/{entryId} {
      allow get: if canGetOptionalTenantRecord();
      allow list: if (canViewFinance() || canPostManagementCash()) && isTenantMember(resource.data.tenantId);
      allow create: if validManagementMovement(entryId, request.resource.data, 'petty_cash');
      allow update, delete: if false;
    }

    match /eod_reconciliations/{reconciliationId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewBranchFinance();
      allow create: if isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance();
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance();
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /branch_expenses/{expenseId} {
      allow get: if isAuthenticated() && ((resource == null && isPOSOperator()) || canReadPosFinancial());
      allow read: if isTenantMember(resource.data.tenantId) && canViewBranchFinance();
      allow create: if atomicWelfareRecord(expenseId, 'branch_expenses');
      allow create: if isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance();
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance();
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /cash_requisitions/{requisitionId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewBranchFinance();
      allow create: if isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance();
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && canOperateBranchFinance();
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /credit_receivables/{receivableId} {
      allow get: if isAuthenticated() && ((resource == null && isPOSOperator()) || canReadPosFinancial());
      allow create: if atomicCreditCreate(receivableId);
      allow update: if atomicCreditUpdate(receivableId);
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow create: if isFinance() && isTenantMember(request.resource.data.tenantId);
      allow update: if isFinance() && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isFinance() && isTenantMember(resource.data.tenantId);
    }

    match /supplier_payables/{payableId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance();
    }

    match /banking_records/{recordId} {
      allow get: if canViewFinance() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if canViewFinance() && isTenantMember(resource.data.tenantId);
      allow create: if validManagementMovement(recordId, request.resource.data, 'bank');
      allow update, delete: if false;
    }

    match /client_credit_ledger/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance();
    }

    match /institution_credit_ledger/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance();
    }

    match /supplier_credit_ledger/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow write: if isFinance();
    }

    match /creditPayments/{paymentId} {
      allow get: if isAuthenticated() && isFinance() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && canViewFinance();
      allow create: if isAuthenticated() && isFinance() && isTenantMember(request.resource.data.tenantId);
      allow update, delete: if false;
    }

    match /financial_posting_audit/{auditId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isFinance() || isProcurement() || isAdmin());
      allow create: if isTenantMember(request.resource.data.tenantId) && (isFinance() || isProcurement() || isAdmin());
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && (isFinance());
      allow delete: if false;
    }

    match /financial_metrics/{metricId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isFinance());
      allow write: if isFinance();
    }

    match /management_expenses/{expenseId} {
      // Procurement can only read deterministic GRN cash drafts for atomic
      // collision checks. Ordinary management expenses remain Finance/HR only.
      allow get: if isProcurement()
        && expenseId.matches('management_payment_draft_(grn_|op_grn_).*')
        && (resource == null || isTenantMember(resource.data.tenantId));
      allow read: if isTenantMember(resource.data.tenantId) && (canViewFinance() || isHR());
      // A cash GRN creates a payment DRAFT, never a disbursement.
      // The linked completed GRN and invoice must exist after the same commit.
      allow create: if isProcurement()
        && isTenantMember(request.resource.data.tenantId)
        && expenseId == 'management_payment_draft_' + request.resource.data.grnId
        && request.resource.data.source == 'procurement_cash_grn'
        && request.resource.data.status == 'draft'
        && request.resource.data.paymentStatus == 'pending_payment'
        && request.resource.data.excludeFromOpexRollup == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount == request.resource.data.amount_ugx
        && request.resource.data.amount > 0
        && existsAfter(/databases/$(database)/documents/grn_records/$(request.resource.data.grnId))
        && getAfter(/databases/$(database)/documents/grn_records/$(request.resource.data.grnId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/grn_records/$(request.resource.data.grnId)).data.payment_type == 'cash'
        && getAfter(/databases/$(database)/documents/grn_records/$(request.resource.data.grnId)).data.payment_status == 'pending_payment'
        && getAfter(/databases/$(database)/documents/grn_records/$(request.resource.data.grnId)).data.invoice_id == request.resource.data.invoiceId
        && existsAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId))
        && getAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.invoiceValue == request.resource.data.amount
        && getAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.paymentStatus == 'Pending Payment';
      allow create: if isTenantMember(request.resource.data.tenantId) && (isFinance() || isHR());
      allow update: if isFinance() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId)
        && (resource.data.get('source','') != 'procurement_cash_grn' || (
          linkedSupplierPayment(request.resource.data)
          && getAfter(supplierPaymentPath(request.resource.data.lastPaymentId)).data.draftId == expenseId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paymentStatus','paidAmountUGX','balanceUGX','excludeFromOpexRollup','updatedAt','issuedAt','issuedBy','lastPaymentId'])
          && request.resource.data.paidAmountUGX == getAfter(supplierPaymentPath(request.resource.data.lastPaymentId)).data.previouslyPaidUGX + getAfter(supplierPaymentPath(request.resource.data.lastPaymentId)).data.amountUGX
          && request.resource.data.balanceUGX == getAfter(supplierPaymentPath(request.resource.data.lastPaymentId)).data.remainingUGX
          && request.resource.data.excludeFromOpexRollup == true));
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /campaigns/{campaignId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /health_messages/{messageId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /marketing_expenses/{expenseId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if (isMarketing() || isFinance()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /outreach_events/{eventId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /prescriber_disbursements/{disbursementId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if (isMarketing() || isFinance()) && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /pharmpoints_settings/{settingsId} {
      allow read: if isTenantMember(resource.data.tenantId) && canViewMarketing();
      allow create: if isMarketing() && isTenantMember(request.resource.data.tenantId);
      allow update: if isMarketing() && isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /controlled_drug_register/{entryId} {
      allow read: if isTenantMember(resource.data.tenantId) && (isQA() || isBranchManager());
      allow create: if (isQA() || isBranchManager() || isAdmin());
      allow update, delete: if isAdmin(); // Highly sensitive
    }

    match /expiry_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /quarantine_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /room_temp_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager() || isAuthenticated(); // Staff can log
    }

    match /fridge_temp_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager() || isAuthenticated(); // Staff can log
    }

    match /cleaning_tasks/{taskId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isBranchManager();
    }

    match /cleaning_logs/{logId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated(); // Staff can log completion
    }

    match /recalls/{recallId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isAdmin();
    }

    match /premises_licenses/{licenseId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isAdmin();
    }

    match /cme_sessions/{sessionId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isHR();
    }

    match /cme_attendance/{attendanceId} {
      allow read: if (isOwner(resource.data.staffId) || isQA() || isHR() || isTenantMember(resource.data.tenantId));
      allow write: if isQA() || isHR();
    }

    match /appraisal_cycles/{cycleId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isQA() || isHR();
    }

    match /appraisals/{appraisalId} {
      allow read: if isTenantMember(resource.data.tenantId) && (
        isOwner(resource.data.staffId) || isQA() || isHR() ||
        (isPeopleSupervisor() && isAssignedToBranch(resource.data.branchId))
      );
      allow create: if isTenantMember(request.resource.data.tenantId) && (
        isQA() || isHR() ||
        (isPeopleSupervisor()
          && isAssignedToBranch(request.resource.data.branchId)
          && request.resource.data.staffId != request.auth.uid
          && request.resource.data.appraisedByUserId == request.auth.uid)
      );
      allow update: if isTenantMember(resource.data.tenantId) && isTenantMember(request.resource.data.tenantId) && (
        isQA() || isHR() ||
        (isPeopleSupervisor()
          && resource.data.appraisedByUserId == request.auth.uid
          && request.resource.data.appraisedByUserId == resource.data.appraisedByUserId
          && request.resource.data.appraisedByName == resource.data.appraisedByName
          && request.resource.data.appraisedByRole == resource.data.appraisedByRole
          && request.resource.data.appraisedAt == resource.data.appraisedAt
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.staffId != request.auth.uid
          && request.resource.data.lastUpdatedByUserId == request.auth.uid)
      );
      allow delete: if isQA() || isHR();
    }

    match /operational_inventory_masters/{masterItemId} {
      function hasIdentityClaim() {
        let claimId = operationalIdentityClaimId(request.resource.data);
        let claim = /databases/$(database)/documents/operational_inventory_identity_claims/$(claimId);
        return operationalIdentityReady(request.resource.data.tenantId)
          && request.resource.data.unitPerPack is int && request.resource.data.unitPerPack > 0
          && request.resource.data.identityClaimId == claimId
          && existsAfter(claim) && getAfter(claim).data.tenantId == request.resource.data.tenantId
          && getAfter(claim).data.masterItemId == masterItemId;
      }
      // Client transactions read their deterministic target documents before
      // creating them. Permit authenticated point-gets of missing documents;
      // existing documents and all collection queries remain tenant-scoped.
      allow get: if isAuthenticated()
        && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated()
        && isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && hasIdentityClaim()
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && request.resource.data.type in ['fixed', 'non-fixed']
        && ((request.resource.data.type == 'fixed' && request.resource.data.operationalType == 'FIXED_ASSET')
          || (request.resource.data.type == 'non-fixed' && request.resource.data.operationalType == 'CONSUMABLE_OPERATIONAL'));
      allow update: if isAuthenticated()
        && isInventoryOperator()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && isOperationalInventoryEnabled(resource.data.tenantId)
        && request.resource.data.inventoryClass == resource.data.inventoryClass
        && request.resource.data.operationalType == resource.data.operationalType
        && request.resource.data.type == resource.data.type
        && operationalIdentityFingerprint(request.resource.data) == operationalIdentityFingerprint(resource.data)
        && request.resource.data.get('identityClaimId', '') == resource.data.get('identityClaimId', '')
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && request.resource.data.type in ['fixed', 'non-fixed'];
      allow delete: if false;
    }

    match /operational_inventory/{itemId} {
      function hasOperationalMaster() {
        let masterPath = /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
        return request.resource.data.masterItemId is string
          && operationalIdentityReady(request.resource.data.tenantId)
          && existsAfter(masterPath)
          && getAfter(masterPath).data.tenantId == request.resource.data.tenantId
          && getAfter(masterPath).data.inventoryClass == 'OPERATIONAL'
          && getAfter(masterPath).data.operationalType == request.resource.data.operationalType
          && operationalIdentityFingerprint(getAfter(masterPath).data) == operationalIdentityFingerprint(request.resource.data);
      }
      function hasMatchingOperationalMovement() {
        let movementId = request.resource.data.lastMovementId;
        let movementPath = /databases/$(database)/documents/operational_inventory_movements/$(movementId);
        let movement = getAfter(movementPath).data;
        return movementId is string
          && existsAfter(movementPath)
          && movement.tenantId == resource.data.tenantId
          && movement.inventoryClass == 'OPERATIONAL'
          && movement.itemId == itemId
          && movement.locationId == (resource.data.branchId == 'HQ' ? 'HQ_OPERATIONAL' : 'BRANCH_' + resource.data.branchId)
          && movement.balanceBefore == resource.data.quantityInStock
          && movement.balanceAfter == request.resource.data.quantityInStock
          && movement.quantityDelta == request.resource.data.quantityInStock - resource.data.quantityInStock;
      }
      function hasOpeningOperationalMovement() {
        let movementId = request.resource.data.lastMovementId;
        let movementPath = /databases/$(database)/documents/operational_inventory_movements/$(movementId);
        return request.resource.data.quantityInStock == 0
          || (movementId is string
            && existsAfter(movementPath)
            && getAfter(movementPath).data.tenantId == request.resource.data.tenantId
            && getAfter(movementPath).data.inventoryClass == 'OPERATIONAL'
            && getAfter(movementPath).data.itemId == itemId
            && getAfter(movementPath).data.movementType == 'ADJUSTMENT'
            && getAfter(movementPath).data.balanceBefore == 0
            && getAfter(movementPath).data.balanceAfter == request.resource.data.quantityInStock
            && getAfter(movementPath).data.quantityDelta == request.resource.data.quantityInStock
            && getAfter(movementPath).data.actorId == request.auth.uid);
      }
      allow get: if isAuthenticated()
        && (resource == null || (isTenantMember(resource.data.tenantId)
          && (isProcurement() || canOperateOperationalLocation(resource.data.branchId))));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || canOperateOperationalLocation(resource.data.branchId));
      allow create: if isAuthenticated()
        && isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && canOperateOperationalLocation(request.resource.data.branchId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && hasOperationalMaster()
        && hasOpeningOperationalMovement()
        && request.resource.data.type in ['fixed', 'non-fixed'];
      allow update: if isAuthenticated()
        && resource.data.get('inventoryClass', 'OPERATIONAL') == 'OPERATIONAL'
        && ((isInventoryOperator() && canOperateOperationalLocation(resource.data.branchId)) || (isProcurement()
          && resource.data.branchId == 'HQ'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantityInStock', 'lastMovementId', 'costPerPack', 'updatedAt'])))
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branchId == resource.data.branchId
        && isOperationalInventoryEnabled(resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType in ['CONSUMABLE_OPERATIONAL', 'FIXED_ASSET']
        && (!('masterItemId' in resource.data) || request.resource.data.masterItemId == resource.data.masterItemId)
        && (!('masterItemId' in request.resource.data) || hasOperationalMaster())
        && request.resource.data.type == resource.data.type
        && (!('operationalType' in resource.data) || request.resource.data.operationalType == resource.data.operationalType)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['quantityInStock'])
          || hasMatchingOperationalMovement());
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId) && isOperationalInventoryEnabled(resource.data.tenantId);
    }

    match /operational_inventory_movements/{movementId} {
      function itemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.itemId);
      }
      function masterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.get('masterItemId', ''));
      }
      function transferPath() {
        return /databases/$(database)/documents/operational_transfers/$(request.resource.data.get('sourceTransactionId', ''));
      }
      function transferLinePath() {
        return /databases/$(database)/documents/operational_transfer_lines/$(request.resource.data.get('sourceLineId', ''));
      }
      function usagePath() {
        return /databases/$(database)/documents/operational_inventory_usage/$(request.resource.data.get('sourceTransactionId', ''));
      }
      function validUsageMovement(item) {
        let usage = getAfter(usagePath()).data;
        return request.resource.data.movementType == 'USAGE'
          && request.resource.data.quantityDelta < 0
          && request.resource.data.sourceTransactionId is string
          && request.resource.data.sourceLineId == request.resource.data.sourceTransactionId
          && existsAfter(usagePath())
          && usage.tenantId == request.resource.data.tenantId
          && usage.inventoryClass == 'OPERATIONAL'
          && usage.operationalType == 'CONSUMABLE_OPERATIONAL'
          && usage.inventoryId == request.resource.data.itemId
          && usage.branchId == item.branchId
          && usage.movementId == 'opm_' + request.resource.data.idempotencyKey
          && usage.issuedAmount == -request.resource.data.quantityDelta
          && usage.staffId == request.resource.data.actorId
          && usage.reference == request.resource.data.reference;
      }
      function validTransferMovement(item) {
        let transferPathValue = transferPath();
        let transferLinePathValue = transferLinePath();
        let transfer = getAfter(transferPathValue).data;
        let transferLine = getAfter(transferLinePathValue).data;
        let data = request.resource.data;
        return data.sourceTransactionId is string
          && data.sourceLineId is string
          && existsAfter(transferPathValue)
          && transfer.tenantId == data.tenantId
          && transfer.inventoryClass == 'OPERATIONAL'
          && existsAfter(transferLinePathValue)
          && transferLine.tenantId == data.tenantId
          && transferLine.transferId == data.sourceTransactionId
          && transferLine.masterItemId == data.masterItemId
          && ((data.movementType == 'TRANSFER_OUT'
              && item.branchId == 'HQ'
              && transfer.sourceLocationId == 'HQ_OPERATIONAL'
              && transferLine.sourceItemId == data.itemId)
            || (data.movementType == 'TRANSFER_OUT'
              && transfer.transferType == 'BRANCH_RETURN'
              && item.branchId == transfer.sourceBranchId
              && transfer.sourceLocationId == 'BRANCH_' + item.branchId
              && transferLine.sourceItemId == data.itemId)
            || (data.movementType == 'TRANSFER_IN'
              && transfer.transferType == 'BRANCH_RETURN'
              && item.branchId == 'HQ'
              && transfer.destinationBranchId == 'HQ'
              && transferLine.destinationItemId == data.itemId)
            || (data.movementType == 'TRANSFER_IN'
              && item.branchId != 'HQ'
              && transfer.destinationBranchId == item.branchId
              && transferLine.destinationItemId == data.itemId));
      }
      allow get: if isAuthenticated()
        && (resource == null || (isTenantMember(resource.data.tenantId)
          && canOperateOperationalLocation(resource.data.branchId)));
      allow list: if isTenantMember(resource.data.tenantId)
        && canOperateOperationalLocation(resource.data.branchId);
      function validMovementCreate() {
        let data = request.resource.data;
        let item = getAfter(itemPath()).data;
        let master = getAfter(masterPath()).data;
        return isAuthenticated()
        && isTenantMember(data.tenantId)
        && isOperationalInventoryEnabled(data.tenantId)
        && data.inventoryClass == 'OPERATIONAL'
        && (isInventoryOperator() || isProcurement())
        && data.movementType in ['RECEIPT', 'DISPATCH', 'RETURN', 'TRANSFER_IN', 'TRANSFER_OUT', 'USAGE', 'ADJUSTMENT', 'WRITE_OFF']
        && data.quantityDelta is number
        && data.quantityDelta != 0
        && data.balanceBefore is number
        && data.balanceAfter is number
        && data.balanceBefore >= 0
        && data.balanceAfter >= 0
        && data.balanceAfter == data.balanceBefore + data.quantityDelta
        && data.reference is string
        && data.reference.size() > 0
        && data.idempotencyKey is string
        && data.idempotencyKey.matches('^[A-Za-z0-9_-]{1,190}$')
        && movementId == 'opm_' + data.idempotencyKey
        && data.actorId == request.auth.uid
        && existsAfter(itemPath())
        && item.tenantId == data.tenantId
        && item.inventoryClass == 'OPERATIONAL'
        && data.branchId == item.branchId
        && data.locationId == (item.branchId == 'HQ' ? 'HQ_OPERATIONAL' : 'BRANCH_' + item.branchId)
        && ((item.branchId == 'HQ' && (isProcurement() || (isInventoryOperator() && isAssignedToBranch('HQ'))))
          || (item.branchId != 'HQ' && isInventoryOperator() && isAssignedToBranch(item.branchId)))
        && data.masterItemId is string
        && existsAfter(masterPath())
        && master.tenantId == data.tenantId
        && master.inventoryClass == 'OPERATIONAL'
        && data.masterItemId == item.get('masterItemId', data.itemId)
        && item.quantityInStock == data.balanceAfter
        && item.lastMovementId == movementId
        && (exists(itemPath())
          ? get(itemPath()).data.quantityInStock == data.balanceBefore
            && get(itemPath()).data.tenantId == data.tenantId
            && get(itemPath()).data.branchId == item.branchId
            && (data.movementType in ['TRANSFER_IN', 'TRANSFER_OUT'] ? validTransferMovement(get(itemPath()).data) : true)
            && (data.movementType == 'USAGE' ? validUsageMovement(get(itemPath()).data) : true)
          : data.movementType == 'ADJUSTMENT'
            && data.balanceBefore == 0
            && data.reason is string
            && data.reason.size() > 0);
      }
      allow create: if validMovementCreate();
      allow update, delete: if false;
    }

    match /operational_grn_lines/{grnLineId} {
      function grnPath() {
        return /databases/$(database)/documents/grn_records/$(request.resource.data.grnId);
      }
      function orderPath() {
        return /databases/$(database)/documents/stock_orders/$(request.resource.data.orderId);
      }
      function sourceLinePath() {
        return /databases/$(database)/documents/stock_order_lines/$(request.resource.data.orderLineId);
      }
      function itemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.itemId);
      }
      function masterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
      }
      function movementPath() {
        return /databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId);
      }
      allow get: if isAuthenticated() && isProcurement() && (resource == null || isTenantMember(resource.data.tenantId));
      allow list: if isTenantMember(resource.data.tenantId) && isProcurement();
      function validGrnLineRoute() {
        let line = request.resource.data;
        let grn = getAfter(grnPath()).data;
        let item = get(itemPath()).data;
        let sourceLine = get(sourceLinePath()).data;
        let order = get(orderPath()).data;
        return (grn.get('deliveryRoute', 'VIA_HQ') == 'VIA_HQ'
            && item.branchId == 'HQ'
            && existsAfter(movementPath())
            && getAfter(movementPath()).data.tenantId == line.tenantId
            && getAfter(movementPath()).data.itemId == line.itemId
            && getAfter(movementPath()).data.masterItemId == line.masterItemId
            && getAfter(movementPath()).data.sourceTransactionId == line.grnId)
          || (grn.get('deliveryRoute', '') == 'DIRECT_BRANCH'
            && line.deliveryRoute == 'DIRECT_BRANCH' && line.locationId == 'SUPPLIER_TRANSIT'
            && line.movementId == '' && item.branchId == order.requesting_branch_id
            && item.branchId != 'HQ' && grn.destination_branch_id == item.branchId
            && sourceLine.supplier_type == 'external' && sourceLine.line_status == 'approved'
            && sourceLine.supplier_id == line.supplierId
            && line.qtyReceived <= sourceLine.qty_ordered - sourceLine.get('qty_received', 0)
            && (sourceLine.get('qty_received', 0) == 0 || order.get('operational_delivery_route', '') == 'DIRECT_BRANCH')
            && line.qtyReceivedUnits == line.qtyReceived * get(masterPath()).data.unitPerPack
            && line.totalValueUGX == line.qtyReceived * line.unitCostUGX);
      }
      function validGrnLine() {
        let line = request.resource.data;
        let grn = getAfter(grnPath()).data;
        let order = get(orderPath()).data;
        let source = get(sourceLinePath()).data;
        let item = get(itemPath()).data;
        let master = get(masterPath()).data;
        return isAuthenticated()
        && isProcurement()
        && isTenantMember(line.tenantId)
        && isOperationalInventoryEnabled(line.tenantId)
        && line.inventoryClass == 'OPERATIONAL'
        && line.qtyReceived is number
        && line.qtyReceived > 0
        && line.qtyReceivedUnits is number
        && line.qtyReceivedUnits > 0
        && line.unitCostUGX is number
        && line.unitCostUGX >= 0
        && line.totalValueUGX is number
        && line.totalValueUGX >= 0
        && line.receivedBy == request.auth.uid
        && grn.tenantId == line.tenantId
        && grn.inventoryClass == 'OPERATIONAL'
        && grn.order_id == line.orderId
        && grn.receivedBy == request.auth.uid
        && order.tenantId == line.tenantId
        && isOperationalOrderData(order)
        && source.tenantId == line.tenantId
        && source.order_id == line.orderId
        && source.inventoryClass == 'OPERATIONAL'
        && source.masterItemId == line.masterItemId
        && item.tenantId == line.tenantId
        && item.inventoryClass == 'OPERATIONAL'
        && item.masterItemId == line.masterItemId
        && master.tenantId == line.tenantId
        && master.inventoryClass == 'OPERATIONAL'
        && validGrnLineRoute();
      }
      allow create: if validGrnLine();
      allow update, delete: if false;
    }

    match /operational_transfers/{transferId} {
      function sourceOrderPath() {
        return /databases/$(database)/documents/stock_orders/$(request.resource.data.sourceOrderId);
      }
      function validOperationalTransfer(data) {
        return data.inventoryClass == 'OPERATIONAL'
          && data.fulfillmentSource in ['HQ_OPERATIONAL', 'EXTERNAL_SUPPLIER', 'HQ_DIRECT', 'BRANCH_RETURN']
          && ((data.get('transferType', '') == 'BRANCH_RETURN'
              && data.fulfillmentSource == 'BRANCH_RETURN'
              && data.sourceBranchId != 'HQ'
              && data.sourceLocationId == 'BRANCH_' + data.sourceBranchId
              && data.destinationBranchId == 'HQ')
            || (data.get('transferType', '') != 'BRANCH_RETURN'
              && ((data.get('deliveryRoute', 'VIA_HQ') == 'VIA_HQ'
                  && data.sourceLocationId == 'HQ_OPERATIONAL' && data.sourceBranchId == 'HQ')
                || (data.get('deliveryRoute', '') == 'DIRECT_BRANCH'
                  && data.fulfillmentSource == 'EXTERNAL_SUPPLIER'
                  && data.sourceLocationId == 'SUPPLIER_TRANSIT' && data.sourceBranchId == 'SUPPLIER'
                  && get(sourceOrderPath()).data.operational_delivery_route == 'DIRECT_BRANCH'
                  && get(sourceOrderPath()).data.status == 'fully_received'))
              && data.destinationBranchId is string
              && data.destinationBranchId.size() > 0
              && data.destinationBranchId != 'HQ'))
          && data.expectedLineCount is number
          && data.expectedLineCount > 0
          && data.expectedLineCount <= 12
          && data.remainingExternalPacks is number
          && data.remainingExternalPacks >= 0
          && ((data.fulfillmentSource in ['HQ_DIRECT', 'BRANCH_RETURN']
              && !('sourceOrderId' in data))
            || (data.fulfillmentSource in ['HQ_OPERATIONAL', 'EXTERNAL_SUPPLIER']
              && ('sourceOrderId' in data)
              && exists(/databases/$(database)/documents/stock_orders/$(data.sourceOrderId))
              && get(/databases/$(database)/documents/stock_orders/$(data.sourceOrderId)).data.tenantId == data.tenantId
              && isOperationalOrderData(get(/databases/$(database)/documents/stock_orders/$(data.sourceOrderId)).data)
              && get(/databases/$(database)/documents/stock_orders/$(data.sourceOrderId)).data.requesting_branch_id == data.destinationBranchId));
      }
      allow get: if isAuthenticated() && ((resource == null && (isProcurement() || isInventoryOperator())) || (isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.destinationBranchId) || (resource.data.get('transferType', '') == 'BRANCH_RETURN' && isAssignedToBranch(resource.data.sourceBranchId)))));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.destinationBranchId) || (resource.data.get('transferType', '') == 'BRANCH_RETURN' && isAssignedToBranch(resource.data.sourceBranchId)));
      allow create: if isAuthenticated()
        && (isProcurement() || (request.resource.data.get('transferType', '') == 'BRANCH_RETURN' && isInventoryOperator() && isAssignedToBranch(request.resource.data.sourceBranchId)))
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && validOperationalTransfer(request.resource.data)
        && ((request.resource.data.get('transferType', '') == 'BRANCH_RETURN' && request.resource.data.status == 'dispatched')
          || (request.resource.data.get('transferType', '') != 'BRANCH_RETURN' && request.resource.data.status == 'draft'))
        && request.resource.data.dispatchedBy == request.auth.uid;
      allow update: if isAuthenticated()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.inventoryClass == resource.data.inventoryClass
        && request.resource.data.get('deliveryRoute', 'VIA_HQ') == resource.data.get('deliveryRoute', 'VIA_HQ')
        && request.resource.data.sourceLocationId == resource.data.sourceLocationId
        && request.resource.data.sourceBranchId == resource.data.sourceBranchId
        && request.resource.data.destinationBranchId == resource.data.destinationBranchId
        && request.resource.data.get('sourceOrderId', '') == resource.data.get('sourceOrderId', '')
        && request.resource.data.get('requestPayloadKey', '') == resource.data.get('requestPayloadKey', '')
        && request.resource.data.get('transferType', '') == resource.data.get('transferType', '')
        && request.resource.data.get('receiptMovementId', '') == resource.data.get('receiptMovementId', '')
          && request.resource.data.fulfillmentSource == resource.data.fulfillmentSource
          && request.resource.data.remainingExternalPacks == resource.data.remainingExternalPacks
        && isOperationalInventoryEnabled(resource.data.tenantId)
        && ((isProcurement()
            && resource.data.status in ['draft', 'dispatching']
            && request.resource.data.status in ['dispatching', 'dispatched'])
          || (isProcurement()
            && resource.data.transferType == 'BRANCH_RETURN'
            && resource.data.status == 'dispatched'
            && request.resource.data.status == 'received'
            && request.resource.data.receivedBy == request.auth.uid
            && existsAfter(/databases/$(database)/documents/operational_inventory_movements/$(resource.data.receiptMovementId))
            && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(resource.data.receiptMovementId)).data.sourceTransactionId == transferId
            && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(resource.data.receiptMovementId)).data.movementType == 'TRANSFER_IN')
          || (isInventoryOperator()
            && isAssignedToBranch(resource.data.destinationBranchId)
            && resource.data.status in ['dispatched', 'partially_received']
            && request.resource.data.status in ['partially_received', 'received', 'queried']
            && (request.resource.data.status == 'partially_received' || request.resource.data.receivedBy == request.auth.uid)));

      allow delete: if false;
    }

    match /operational_transfer_lines/{transferLineId} {
      function transferPath() {
        return /databases/$(database)/documents/operational_transfers/$(request.resource.data.transferId);
      }
      function sourceItemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.sourceItemId);
      }
      function destinationItemPath() {
        return /databases/$(database)/documents/operational_inventory/$(request.resource.data.destinationItemId);
      }
      function masterPath() {
        return /databases/$(database)/documents/operational_inventory_masters/$(request.resource.data.masterItemId);
      }
      function sourceOrderLinePath() {
        return /databases/$(database)/documents/stock_order_lines/$(request.resource.data.sourceOrderLineId);
      }
      function validDirectSupplierLine() {
        let line = request.resource.data;
        let transfer = getAfter(transferPath()).data;
        let source = get(sourceOrderLinePath()).data;
        let master = get(masterPath()).data;
        let destination = get(destinationItemPath()).data;
        let grn = get(/databases/$(database)/documents/grn_records/$(source.grn_id)).data;
        return transfer.get('deliveryRoute', '') == 'DIRECT_BRANCH'
          && transfer.fulfillmentSource == 'EXTERNAL_SUPPLIER' && transfer.sourceLocationId == 'SUPPLIER_TRANSIT'
          && transfer.tenantId == line.tenantId && transfer.inventoryClass == 'OPERATIONAL'
          && line.inventoryClass == 'OPERATIONAL' && line.status in ['prepared', 'dispatched']
          && line.sourceItemId == 'SUPPLIER_TRANSIT' && line.dispatchMovementId == ''
          && line.destinationBranchId == transfer.destinationBranchId
          && destination.branchId == transfer.destinationBranchId && destination.branchId != 'HQ'
          && destination.tenantId == line.tenantId && destination.inventoryClass == 'OPERATIONAL'
          && destination.masterItemId == line.masterItemId
          && master.tenantId == line.tenantId && master.inventoryClass == 'OPERATIONAL'
          && source.tenantId == line.tenantId && source.order_id == transfer.sourceOrderId
          && source.inventoryClass == 'OPERATIONAL' && source.masterItemId == line.masterItemId
          && source.supplier_type == 'external' && source.line_status == 'received'
          && source.operational_delivery_route == 'DIRECT_BRANCH'
          && grn.deliveryRoute == 'DIRECT_BRANCH' && grn.tenantId == line.tenantId && grn.order_id == transfer.sourceOrderId
          && line.quantityDispatched is number && line.quantityDispatched > 0
          && line.quantityDispatched == source.qty_received * master.unitPerPack
          && source.operational_received_value_ugx is number && source.operational_received_value_ugx >= 0
          && line.unitCostUGX == float(source.operational_received_value_ugx) / float(source.qty_received * master.unitPerPack)
          && line.totalValueUGX == line.quantityDispatched * line.unitCostUGX
          && isOperationalInventoryEnabled(line.tenantId);
      }
      function validPreparedOperationalTransferLine() {
        let line = request.resource.data;
        // Bind validated records once to keep mixed-role dispatch below the
        // Firestore expression budget without relaxing any linkage checks.
        let transfer = getAfter(transferPath()).data;
        let source = get(sourceItemPath()).data;
        let destination = get(destinationItemPath()).data;
        let master = get(masterPath()).data;
        let orderLine = 'sourceOrderLineId' in request.resource.data ? get(sourceOrderLinePath()).data : {};
        return line.inventoryClass == 'OPERATIONAL'
          && line.status == 'prepared'
          && line.quantityDispatched is number
          && line.quantityDispatched > 0
          && line.unitCostUGX is number
          && line.unitCostUGX >= 0
          && transfer.tenantId == line.tenantId
          && transfer.inventoryClass == 'OPERATIONAL'
          && isOperationalInventoryEnabled(line.tenantId)
          && source.tenantId == line.tenantId
          && source.branchId == 'HQ'
          && source.inventoryClass == 'OPERATIONAL'
          && source.masterItemId == line.masterItemId
          && destination.tenantId == line.tenantId
          && destination.branchId == transfer.destinationBranchId
          && destination.inventoryClass == 'OPERATIONAL'
          && destination.masterItemId == line.masterItemId
          && master.tenantId == line.tenantId
          && master.inventoryClass == 'OPERATIONAL'
          && master.hqLocationItemId == line.sourceItemId
          && (
            (transfer.fulfillmentSource == 'HQ_DIRECT'
              && !('sourceOrderLineId' in line))
            || (transfer.fulfillmentSource == 'HQ_OPERATIONAL'
                  && orderLine.tenantId == line.tenantId
              && orderLine.order_id == transfer.sourceOrderId
              && orderLine.inventoryClass == 'OPERATIONAL'
              && orderLine.masterItemId == line.masterItemId
              && orderLine.line_status == 'sourcing'
              && !('supplier_type' in orderLine)
              && line.quantityDispatched <= orderLine.qty_ordered * master.unitPerPack)
            || (transfer.fulfillmentSource == 'EXTERNAL_SUPPLIER'
                  && orderLine.tenantId == line.tenantId
              && orderLine.order_id == transfer.sourceOrderId
              && orderLine.inventoryClass == 'OPERATIONAL'
              && orderLine.masterItemId == line.masterItemId
              && orderLine.supplier_type == 'external'
              && orderLine.line_status == 'received'
              && line.quantityDispatched == orderLine.qty_received * master.unitPerPack)
          );
      }
      function validBranchReturnLine() {
        let line = request.resource.data;
        let transfer = getAfter(transferPath()).data;
        let src = get(sourceItemPath()).data;
        let dest = get(destinationItemPath()).data;
        let master = get(masterPath()).data;
        return transfer.transferType == 'BRANCH_RETURN'
          && line.inventoryClass == 'OPERATIONAL'
          && line.status == 'dispatched'
          && line.quantityDispatched is number
          && line.quantityDispatched > 0
          && line.unitCostUGX is number
          && line.unitCostUGX >= 0
          && line.destinationBranchId == transfer.destinationBranchId
          && line.tenantId == transfer.tenantId
          && transfer.tenantId == src.tenantId && src.tenantId == dest.tenantId && dest.tenantId == master.tenantId
          && src.branchId == transfer.sourceBranchId
          && dest.branchId == 'HQ'
          && src.inventoryClass == 'OPERATIONAL' && dest.inventoryClass == 'OPERATIONAL'
          && src.masterItemId == line.masterItemId
          && dest.masterItemId == line.masterItemId
          && master.inventoryClass == 'OPERATIONAL'
          && master.hqLocationItemId == line.destinationItemId
          && existsAfter(transferPath()) && exists(sourceItemPath()) && exists(destinationItemPath()) && exists(masterPath())
          && existsAfter(dispatchMovementPath())
          && getAfter(dispatchMovementPath()).data.itemId == line.sourceItemId
          && getAfter(dispatchMovementPath()).data.sourceTransactionId == line.transferId
          && getAfter(dispatchMovementPath()).data.sourceLineId == line.id
          && getAfter(dispatchMovementPath()).data.movementType == 'TRANSFER_OUT'
          && getAfter(dispatchMovementPath()).data.quantityDelta == -line.quantityDispatched;
      }
      function dispatchMovementPath() {
        return /databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.dispatchMovementId);
      }
      function receiptMovementPath() {
        return /databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.receiptMovementId);
      }
      allow get: if isAuthenticated()
        && ((resource == null && isProcurement()) || (resource != null && isTenantMember(resource.data.tenantId)
          && (isProcurement() || isAssignedToBranch(resource.data.destinationBranchId)
            || (resource.data.get('transferType', '') == 'BRANCH_RETURN' && isAssignedToBranch(resource.data.sourceBranchId)))));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.destinationBranchId) || (resource.data.get('transferType', '') == 'BRANCH_RETURN' && isAssignedToBranch(resource.data.sourceBranchId)));
      allow create: if isAuthenticated()
        && (isProcurement() || (request.resource.data.status == 'dispatched' && isInventoryOperator() && isAssignedToBranch(getAfter(transferPath()).data.sourceBranchId)))
        && isTenantMember(request.resource.data.tenantId)
        && (request.resource.data.sourceItemId == 'SUPPLIER_TRANSIT'
          ? (request.resource.data.status == 'prepared' && validDirectSupplierLine())
          : (validPreparedOperationalTransferLine() || validBranchReturnLine()));
      function validAcceptedReceiptMovement() {
        let movement = getAfter(receiptMovementPath()).data;
        return existsAfter(receiptMovementPath())
          && movement.tenantId == resource.data.tenantId
          && movement.itemId == resource.data.destinationItemId
          && movement.sourceLineId == transferLineId
          && movement.movementType == 'TRANSFER_IN'
          && movement.quantityDelta == request.resource.data.quantityAccepted;
      }
      function validTransferLineUpdate() {
        let data = request.resource.data;
        let before = resource.data;
        return isAuthenticated()
        && isTenantMember(before.tenantId)
        && isTenantMember(data.tenantId)
        && data.tenantId == before.tenantId
        && data.inventoryClass == before.inventoryClass
        && data.transferId == before.transferId
        && data.masterItemId == before.masterItemId
        && data.sourceItemId == before.sourceItemId
        && data.destinationItemId == before.destinationItemId
        && data.quantityDispatched == before.quantityDispatched
        && data.unitCostUGX == before.unitCostUGX
        && data.totalValueUGX == before.totalValueUGX
        && data.get('sourceOrderLineId', '') == before.get('sourceOrderLineId', '')
        && data.dispatchMovementId == before.dispatchMovementId
        && data.receiptMovementId == before.receiptMovementId
        && isOperationalInventoryEnabled(before.tenantId)
        && ((isProcurement()
            && before.status == 'prepared'
            && data.status == 'dispatched'
            && (before.sourceItemId == 'SUPPLIER_TRANSIT' ? validDirectSupplierLine() : (exists(dispatchMovementPath())
            && get(dispatchMovementPath()).data.tenantId == before.tenantId
            && get(dispatchMovementPath()).data.itemId == before.sourceItemId
            && get(dispatchMovementPath()).data.sourceLineId == transferLineId
            && get(dispatchMovementPath()).data.movementType == 'TRANSFER_OUT')))
          || (isInventoryOperator()
            && isAssignedToBranch(before.destinationBranchId)
            && before.status == 'dispatched'
            && data.status in ['received', 'queried']
            && data.quantityAccepted is number
            && data.quantityQueried is number
            && data.quantityAccepted >= 0
            && data.quantityQueried >= 0
            && data.quantityAccepted + data.quantityQueried == before.quantityDispatched
            && ((data.quantityAccepted == 0 && data.quantityQueried == before.quantityDispatched)
              || validAcceptedReceiptMovement()))
          || (isProcurement()
            && get(transferPath()).data.transferType == 'BRANCH_RETURN'
            && before.status == 'dispatched'
            && data.status == 'received'
            && data.quantityAccepted == before.quantityDispatched
            && data.quantityQueried == 0
            && validAcceptedReceiptMovement()
            && getAfter(receiptMovementPath()).data.sourceTransactionId == before.transferId));
      }
      allow update: if validTransferLineUpdate();
      allow delete: if false;
    }

    match /operational_inventory_usage/{usageId} {
      // First-time idempotent usage transactions must be able to check a missing
      // deterministic usage ID. Existing documents stay tenant/branch scoped.
      allow get: if isAuthenticated() && (resource == null ||
        (isTenantMember(resource.data.tenantId)
          && (isProcurement() || isAssignedToBranch(resource.data.branchId))));
      allow list: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.branchId));
      allow create: if isAuthenticated()
        && isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'OPERATIONAL'
        && request.resource.data.operationalType == 'CONSUMABLE_OPERATIONAL'
        && isAssignedToBranch(request.resource.data.branchId)
        && request.resource.data.idempotencyKey is string
        && usageId == 'opusage_' + request.resource.data.idempotencyKey
        && request.resource.data.issuedAmount is number
        && request.resource.data.issuedAmount > 0
        && request.resource.data.cost is number
        && request.resource.data.cost >= 0
        && request.resource.data.department is string
        && request.resource.data.purpose is string
        && request.resource.data.reference is string
        && request.resource.data.inventoryId is string
        && exists(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId))
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.tenantId == request.resource.data.tenantId
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.branchId == request.resource.data.branchId
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.inventoryClass == 'OPERATIONAL'
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.operationalType == 'CONSUMABLE_OPERATIONAL'
        && existsAfter(/databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId))
        && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId)).data.sourceTransactionId == usageId
        && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId)).data.movementType == 'USAGE'
        && getAfter(/databases/$(database)/documents/operational_inventory_movements/$(request.resource.data.movementId)).data.quantityDelta == -request.resource.data.issuedAmount;
      allow update, delete: if false;
    }

    match /operational_inventory_maintenance/{maintenanceId} {
      allow read: if isTenantMember(resource.data.tenantId)
        && (isProcurement() || isAssignedToBranch(resource.data.branchId));
      allow create: if isAuthenticated() && isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && isOperationalInventoryEnabled(request.resource.data.tenantId)
        && isAssignedToBranch(request.resource.data.branchId)
        && request.resource.data.inventoryId is string
        && exists(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId))
        && get(/databases/$(database)/documents/operational_inventory/$(request.resource.data.inventoryId)).data.tenantId == request.resource.data.tenantId;
      allow update: if isAuthenticated() && isInventoryOperator()
        && isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && isAssignedToBranch(resource.data.branchId)
        && isOperationalInventoryEnabled(resource.data.tenantId);
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId) && isOperationalInventoryEnabled(resource.data.tenantId);
    }

    match /products/{productId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isInventoryOperator()
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.inventoryClass == 'SELLABLE';
      allow update: if isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && (!('productId' in resource.data) || request.resource.data.productId == resource.data.productId)
        && (!('sku' in resource.data) || request.resource.data.sku == resource.data.sku)
        && (!('inventoryClass' in resource.data) || request.resource.data.inventoryClass == resource.data.inventoryClass)
        && (!('inventoryClass' in request.resource.data) || request.resource.data.inventoryClass == 'SELLABLE')
        && (
          (isPOSOperator()
            && (
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
                && request.resource.data.stock is number
                && request.resource.data.stock >= 0
              ) ||
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'quantityInStock', 'stockAggregateSource', 'updatedAt'])
                && request.resource.data.stock is number
                && request.resource.data.quantityInStock is number
                && request.resource.data.stock >= 0
                && request.resource.data.quantityInStock >= 0
                && request.resource.data.stock == request.resource.data.quantityInStock
                && request.resource.data.stockAggregateSource == 'product_batches'
              )
            )) ||
          isInventoryOperator()
        );
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /product_batches/{batchId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isInventoryOperator() && isTenantMember(request.resource.data.tenantId)
        && (
          !("sourceType" in request.resource.data) ||
          request.resource.data.sourceType != 'opening_stock' ||
          (
            ("openingStockSessionId" in request.resource.data) &&
            ("openingStockLineIndex" in request.resource.data) &&
            request.resource.data.openingStockLineIndex is int &&
            request.resource.data.openingStockLineIndex >= 0 &&
            getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.status in ['fully_accepted', 'closed_with_queries'] &&
            getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.tenantId == request.resource.data.tenantId &&
            getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.branchId == request.resource.data.branchId &&
            getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.receivedBy == request.auth.uid &&
            request.resource.data.openingStockLineIndex < getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines.size() &&
            request.resource.data.productId == getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines[request.resource.data.openingStockLineIndex].productId &&
            request.resource.data.batchNumber == getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines[request.resource.data.openingStockLineIndex].batchNumber &&
            request.resource.data.expiryDate == getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines[request.resource.data.openingStockLineIndex].expiryDate &&
            request.resource.data.quantity == getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.receiptResults[request.resource.data.openingStockLineIndex].acceptedQuantity &&
            request.resource.data.quantity <= getAfter(/databases/$(database)/documents/opening_stock_sessions/$(request.resource.data.openingStockSessionId)).data.lines[request.resource.data.openingStockLineIndex].quantity
          )
        );
      allow update: if isTenantMember(resource.data.tenantId)
        && isTenantMember(request.resource.data.tenantId)
        && (
          (isPOSOperator()
            && isAssignedToBranch(resource.data.branchId)
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']) ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'lastUpdated'])
            )
            && request.resource.data.quantity is number
            && request.resource.data.quantity >= 0) ||
          isInventoryOperator() ||
          (isQA()
            && (hasAnyRole(['QA Head', 'QA Manager', 'admin', 'Admin']) || isAdmin() || isAssignedToBranch(resource.data.branchId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['batch_status', 'lastUpdated'])
            && request.resource.data.batch_status == 'quarantined')
        );
      allow delete: if isAdmin() && isTenantMember(resource.data.tenantId);
    }

    match /opening_stock_sessions/{sessionId} {
      function isAssignedBranchManager(branchId) {
        return isAuthenticated()
          && (hasRole('Branch Manager') || hasRole('branch manager') || hasRole('admin'))
          && (
            (("assigned_branches" in getUserData()) && getUserData().assigned_branches.hasAny([branchId])) ||
            (("branch_id" in getUserData()) && getUserData().branch_id == branchId) ||
            (("default_branch_id" in getUserData()) && getUserData().default_branch_id == branchId)
          );
      }

      allow read: if isTenantMember(resource.data.tenantId);

      allow create: if isTenantMember(request.resource.data.tenantId)
        && sessionId == request.resource.data.tenantId + '_' + request.resource.data.branchId
        && (hasBranchManagerRole() || hasProcurementRole())
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 300;

      allow update: if isTenantMember(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (
            resource.data.status in ['draft', 'returned']
            && request.resource.data.status in ['draft', 'submitted']
            && (hasBranchManagerRole() || hasProcurementRole())
            && request.resource.data.lines is list
            && request.resource.data.lines.size() > 0
            && request.resource.data.lines.size() <= 300
          ) ||
          (
            resource.data.status == 'submitted'
            && request.resource.data.status in ['ceo_approved', 'returned', 'rejected']
            && isCEO()
            && request.resource.data.lines == resource.data.lines
          ) ||
          (
            resource.data.status == 'ceo_approved'
            && request.resource.data.status == 'awaiting_receipt'
            && hasProcurementRole()
            && request.resource.data.lines == resource.data.lines
          ) ||
          (
            resource.data.status == 'awaiting_receipt'
            && request.resource.data.status in ['fully_accepted', 'closed_with_queries']
            && isAssignedBranchManager(resource.data.branchId)
            && request.resource.data.receivedBy == request.auth.uid
            && request.resource.data.lines == resource.data.lines
            && request.resource.data.receiptResults is list
            && request.resource.data.receiptResults.size() == resource.data.lines.size()
            && request.resource.data.lines.size() == resource.data.lines.size()
          )
        );

      allow delete: if false;
    }

    match /system_crashes/{crashId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // One tenant-wide supplier register serves both Procurement and CRM.
    match /supplier_registry/{supplierId} {
      function canMaintainSupplier() {
        let user = getUserData();
        let role = request.resource.data.updatedAccessRole;
        let module = request.resource.data.updatedModule;
        let normalized = role.lower();
        let systemRoles = ['owner','ceo','ceo / md','admin','hr head','hr support personnel','qa head','qa officer','finance head','finance officer','procurement head','procurement officer','procurement personnel','logistics head','transport & logistics personnel','marketing head','marketing personnel','it head','it support staff','it support personnel','branch manager','pharmacist','dispenser','cashier','cleaner','trainee'];
        let path = /databases/$(database)/documents/role_realms_of_operation/$(user.tenantId + '_' + role.replace('\\s+', '_').lower());
        let realm = normalized in systemRoles ? {} : (exists(path) ? get(path).data : {});
        return module in ['clients','procurement']
          && (role == user.role || user.get('secondaryRoles', []).hasAny([role]))
          && ((module == 'clients' && normalized in ['owner','ceo','ceo / md','admin','procurement head','procurement officer','procurement personnel','marketing head','marketing personnel','branch manager','pharmacist','dispenser'])
            || (module == 'procurement' && normalized in ['owner','ceo','ceo / md','finance head','procurement head','procurement officer','procurement personnel'])
            || (!(normalized in systemRoles) && realm.get('tenantId', '') == user.tenantId && realm.get('roleType', '') == 'custom' && realm.get('roleName', '') == role
              && realm.get('permissions', {}).get(module, {}).get('accessLevel', '') in ['view_functional','operate','all']));
      }
      function validSupplier() {
        let data = request.resource.data;
        return data.supplier_name is string && data.supplier_name.size() > 0
          && data.supplier_id is string
          && data.inventoryCapabilities is list
          && data.inventoryCapabilities.hasOnly(['DRUGS','COSMETICS','CONSUMABLES','DEVICES','NON_SELLABLE_OPERATIONAL'])
          && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
      }
      allow get: if canGetOptionalTenantRecord();
      allow list: if isTenantMember(resource.data.tenantId);
      allow create: if isTenantMember(request.resource.data.tenantId)
        && canMaintainSupplier() && validSupplier()
        && supplierId.matches('^[A-Za-z0-9_-]{1,120}$')
        && request.resource.data.supplier_id == 'SUP-' + supplierId
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if isTenantMember(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && canMaintainSupplier() && validSupplier()
        && (request.resource.data.supplier_id == resource.data.get('supplier_id', '')
          || (resource.data.get('supplier_id', '') == '' && request.resource.data.supplier_id == 'SUP-' + supplierId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supplier_name','supplier_id','commercial_category','nda_wholesale_licence_number','nda_licence_expiry_date','nda_licence_status','payment_terms','tin','address','is_suspended','whtExempt','inventoryCapabilities','updatedBy','updatedAt','updatedAccessRole','updatedModule']);
      // Suspend suppliers instead of destroying historical order references.
      allow delete: if false;
    }

    // Procurement, transfers, billing, and welfare collections
    match /stock_orders/{orderId} {
      function validOrderClass(data) {
        return data.category in ['sellable_non_cosmetic', 'sellable_cosmetic', 'non_sellable']
          && ((data.category == 'non_sellable'
              && (!('inventoryClass' in data) || data.inventoryClass == 'OPERATIONAL')
              && isOperationalInventoryEnabled(data.tenantId))
            || (data.category in ['sellable_non_cosmetic', 'sellable_cosmetic']
              && (!('inventoryClass' in data) || data.inventoryClass == 'SELLABLE')));
      }
      allow get: if isAuthenticated()
        && ((resource == null && isProcurement()
            && orderId.matches('^op_hq_buffer_[A-Za-z0-9_-]{1,120}$')
